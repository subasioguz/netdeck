/* EdgeOS */
"%@ is not a VLAN-aware switch0 port. On EdgeOS, VLANs work only on switch0 ports with vlan-aware enabled." = "%@ אינו יציאת switch0 עם תמיכה ב-VLAN (vlan-aware). ב-EdgeOS, VLAN פועלים רק ביציאות switch0 שבהן vlan-aware מופעל.";
"Another change on the router is already waiting for confirmation. Confirm it or let its timer run out first." = "שינוי אחר בראוטר כבר ממתין לאישור. אשרו אותו או המתינו לסיום הטיימר שלו.";
"EdgeOS can't change a VLAN's number. Delete the VLAN and add it again with the new number." = "EdgeOS לא יכול לשנות מספר VLAN. מחקו את ה-VLAN והוסיפו אותו שוב עם המספר החדש.";
"Netdeck could not check whether the running configuration is saved. Changes that were never saved are lost if the router restarts with its saved configuration." = "Netdeck לא הצליח לבדוק אם התצורה הפעילה שמורה. שינויים שמעולם לא נשמרו יאבדו אם הראוטר יופעל מחדש עם התצורה השמורה.";
"Netdeck stopped the confirm timer and loaded the saved configuration again." = "Netdeck עצר את טיימר האישור וטען מחדש את התצורה השמורה.";
"On EdgeOS a VLAN has only a name (the description of its switch0 vif). Rename the VLAN instead." = "ב-EdgeOS ל-VLAN יש רק שם (התיאור של ה-vif שלו ב-switch0). שנו במקום זאת את שם ה-VLAN.";
"The confirm timer is still running: the router restarts with its saved configuration when it runs out." = "טיימר האישור עדיין פועל: כשיסתיים, הראוטר יופעל מחדש עם התצורה השמורה שלו.";
"The router keeps no commit revisions, so EdgeOS can't arm its confirm timer. Turn on commit revisions (system config-management commit-revisions) first." = "הראוטר לא שומר גרסאות קומיט, ולכן EdgeOS לא יכול להפעיל את טיימר האישור. הפעילו קודם גרסאות קומיט (system config-management commit-revisions).";
"The router rejected some commands:" = "הראוטר דחה חלק מהפקודות:";
"The running configuration has changes that were never saved. If you don't confirm in time, the router restarts with its saved configuration and those changes are lost as well." = "בתצורה הפעילה יש שינויים שמעולם לא נשמרו. אם לא תאשרו בזמן, הראוטר יופעל מחדש עם התצורה השמורה וגם השינויים האלה יאבדו.";
"This EdgeOS version has no commit-confirm, so Netdeck can't apply changes with a safety timer." = "בגרסת EdgeOS הזו אין commit-confirm, ולכן Netdeck לא יכול להחיל שינויים עם טיימר בטיחות.";
"VLAN 1 is the default VLAN; EdgeOS keeps the name 'default' for it." = "VLAN 1 הוא ה-VLAN ברירת המחדל; EdgeOS שומר עבורו את השם 'default'.";
"VLANs on EdgeOS need the switch0 interface with vlan-aware enabled. Set that up on the router first." = "VLAN ב-EdgeOS דורשים ממשק switch0 עם vlan-aware מופעל. הגדירו זאת קודם בראוטר.";

/* Cisco IOS */
"This switch's IOS can't undo changes on its own (no revert timer). Netdeck doesn't apply changes without it." = "ה-IOS של הסוויץ' הזה לא יכול לבטל שינויים בעצמו (אין revert timer). בלעדיו Netdeck לא מחיל שינויים.";
"Netdeck needs privileged mode on this switch. Log in with a privilege 15 user or give the enable password." = "Netdeck דורש מצב מורשה בסוויץ' הזה. התחברו עם משתמש ברמת הרשאה 15 או הזינו את סיסמת enable.";
"Netdeck couldn't set up the configuration archive the revert timer needs:" = "Netdeck לא הצליח להגדיר את ארכיון התצורה שה-revert timer צריך:";
"IOS has no candidate configuration to check in advance. The switch checks each command as it is applied; if one is rejected, or if you don't confirm in time, the revert timer puts the previous configuration back." = "ב-IOS אין תצורת מועמד לבדיקה מראש. הסוויץ' בודק כל פקודה בזמן שהיא מוחלת; אם אחת נדחית, או אם לא תאשרו בזמן, ה-revert timer מחזיר את התצורה הקודמת.";
"The configuration archive the revert timer needs is not set up yet. Netdeck turns it on first (archive path flash:netdeck), outside the timer; this doesn't affect traffic." = "ארכיון התצורה שה-revert timer צריך עדיין לא מוגדר. Netdeck מפעיל אותו קודם (archive path flash:netdeck), מחוץ לטיימר; זה לא משפיע על התעבורה.";
"The switch shut this port down after an error (err-disabled)." = "הסוויץ' כיבה את היציאה הזו בגלל שגיאה (err-disabled).";
"%@: IOS doesn't accept '?' in a description." = "%@: IOS לא מקבל '?' בתיאור.";
"%@ is a routed port (no switchport). Netdeck doesn't change VLANs on routed ports." = "%@ היא יציאה מנותבת (no switchport). Netdeck לא משנה VLAN ביציאות מנותבות.";
"%@ belongs to Port-channel%@; its VLANs follow the port-channel. Netdeck doesn't change them." = "%@ שייכת ל-Port-channel%@; ה-VLAN שלה נקבעים לפי ה-port-channel. Netdeck לא משנה אותם.";
"VLANs 1002–1005 are reserved on Cisco switches." = "VLAN‏ 1002–1005 שמורים בסוויצ'ים של Cisco.";
"'%@': IOS VLAN names can't contain spaces or '?' and are at most 32 characters." = "'%@': שמות VLAN ב-IOS לא יכולים להכיל רווחים או '?' ואורכם עד 32 תווים.";
"IOS VLANs have no description. Leave it empty." = "ל-VLAN ב-IOS אין תיאור. השאירו ריק.";
"IOS can't change a VLAN's number. Add a VLAN with the new number and move the ports to it." = "IOS לא יכול לשנות מספר VLAN. הוסיפו VLAN עם המספר החדש והעבירו אליו את היציאות.";
"The default VLAN (1) can't be renamed or deleted." = "אי אפשר לשנות את שם ה-VLAN ברירת המחדל (1) או למחוק אותו.";

/* API module (iDRAC, Synology DSM, TrueNAS) */
"'%@' is not a valid address." = "'%@' אינה כתובת תקינה.";
"Netdeck only connects over HTTPS. Use an https:// address." = "Netdeck מתחבר רק דרך HTTPS. השתמשו בכתובת https://.";
"Netdeck can't reach the device over HTTPS (%@)." = "Netdeck לא מצליח להגיע להתקן דרך HTTPS (%@).";
"A secure connection to the device could not be set up (%@)." = "לא ניתן היה ליצור חיבור מאובטח להתקן (%@).";
"The security certificate of %@ has changed since Netdeck last connected. If the device was reset or got a new certificate, trust the new one. Otherwise someone may be intercepting the connection." = "אישור האבטחה של %@ השתנה מאז החיבור האחרון של Netdeck. אם ההתקן אופס או קיבל אישור חדש, תנו אמון בחדש. אחרת ייתכן שמישהו מיירט את החיבור.";
"This account uses 2-step verification. Use an account without it for Netdeck." = "בחשבון הזה מופעל אימות דו-שלבי. השתמשו עבור Netdeck בחשבון ללא אימות כזה.";
"The device wants this account's password changed. Change it on the device's web page, then try again." = "ההתקן דורש לשנות את סיסמת החשבון הזה. שנו אותה בדף האינטרנט של ההתקן ונסו שוב.";
"The device blocked this Mac's address after too many failed logins. Unblock it on the device or wait, then try again." = "ההתקן חסם את כתובת ה-Mac הזה לאחר יותר מדי ניסיונות כניסה כושלים. בטלו את החסימה בהתקן או המתינו, ונסו שוב.";
"The device doesn't offer this information." = "ההתקן לא מספק מידע זה.";
"The device sent an answer Netdeck doesn't understand (%@)." = "ההתקן שלח תשובה ש-Netdeck לא מבין (%@).";
"The device answered with HTTP error %@." = "ההתקן השיב בשגיאת HTTP‏ %@.";
"not an HTTP answer" = "לא תשובת HTTP";
"no session token" = "אין אסימון סשן";
"login error %@" = "שגיאת כניסה %@";
"login failed" = "הכניסה נכשלה";
"no answer" = "אין תשובה";
"The device stopped answering." = "ההתקן הפסיק להגיב.";
"Reading system info" = "קורא מידע על המערכת";
"Reading sensors" = "קורא חיישנים";
