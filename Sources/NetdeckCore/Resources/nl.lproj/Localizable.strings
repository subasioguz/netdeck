/* HTTPS error cards */
"%@ presented a different security certificate than last time. That happens after a reset or a certificate renewal, but it can also mean someone is in between. Trust the new certificate only if you know why it changed." = "%@ toonde een ander beveiligingscertificaat dan de vorige keer. Dat gebeurt na een reset of certificaatvernieuwing, maar het kan ook betekenen dat iemand tussen jou en het apparaat zit. Vertrouw het nieuwe certificaat alleen als je weet waarom het is gewijzigd.";
"Certificate changed" = "Certificaat gewijzigd";
"HTTPS: the address can't be reached" = "HTTPS: het adres is niet bereikbaar";
"HTTPS: the certificate changed" = "HTTPS: het certificaat is gewijzigd";
"Netdeck couldn't reach %@. Check that the device is on, the address and port are right (Synology uses 5001) and this Mac is on the same network." = "Netdeck kon %@ niet bereiken. Controleer of het apparaat aan staat, het adres en de poort kloppen (Synology gebruikt 5001) en deze Mac op hetzelfde netwerk zit.";
"Trust the new certificate" = "Vertrouw het nieuwe certificaat";

/* MikroTik RouterOS */
"%@: VLANs on RouterOS need bridge VLAN filtering. Add the port to the bridge and turn on vlan-filtering first." = "%@: VLAN's op RouterOS hebben bridge-VLAN-filtering nodig. Voeg de poort eerst aan de bridge toe en schakel vlan-filtering in.";
"VLANs on RouterOS need bridge VLAN filtering. Turn on vlan-filtering on the bridge first." = "VLAN's op RouterOS hebben bridge-VLAN-filtering nodig. Schakel eerst vlan-filtering in op de bridge.";
"VLANs %@ share one bridge VLAN entry on the router. Split it into one entry per VLAN first." = "VLAN's %@ delen één bridge-VLAN-item op de router. Splits dat eerst op in één item per VLAN.";
"%@: choose a VLAN for this port." = "%@: kies een VLAN voor deze poort.";
"RouterOS bridge VLANs have no names of their own. Netdeck shows the name of the VLAN's interface, or vlan and its number." = "Bridge-VLAN's op RouterOS hebben geen eigen naam. Netdeck toont de naam van de interface van het VLAN, of vlan en het nummer.";
"VLAN '%@' has the VLAN interface '%@' on the router. Remove that interface first." = "VLAN '%@' heeft de VLAN-interface '%@' op de router. Verwijder die interface eerst.";
"The router asks for a new password. Log in once with WinBox, WebFig or a terminal, set a password, then connect again." = "De router vraagt om een nieuw wachtwoord. Log één keer in met WinBox, WebFig of een terminal, stel een wachtwoord in en verbind daarna opnieuw.";
"RouterOS has no candidate configuration to check in advance. Netdeck sends the commands one by one and undoes all of them if the router rejects one." = "RouterOS heeft geen kandidaatconfiguratie om vooraf te controleren. Netdeck stuurt de opdrachten één voor één en draait ze allemaal terug als de router er een weigert.";
"The router did not confirm the command." = "De router heeft de opdracht niet bevestigd.";
"The undo timer is still on the router. Confirm again." = "De terugdraaitimer staat nog op de router. Bevestig opnieuw.";
"This change is too large for the router's undo script. Apply it in smaller parts." = "Deze wijziging is te groot voor het terugdraaiscript van de router. Pas hem in kleinere delen toe.";
"Netdeck could not read the router's clock, so it can't set the undo timer. Nothing was changed." = "Netdeck kon de klok van de router niet lezen en kan dus de terugdraaitimer niet instellen. Er is niets gewijzigd.";
"The undo script on the router is incomplete." = "Het terugdraaiscript op de router is onvolledig.";
"The undo timer did not start on the router." = "De terugdraaitimer is op de router niet gestart.";
"Netdeck could not set the undo timer on the router, so nothing was changed." = "Netdeck kon de terugdraaitimer op de router niet instellen, dus er is niets gewijzigd.";
"The undo script did not finish on the router." = "Het terugdraaiscript is op de router niet voltooid.";
"Undo runs at %@ (router time)" = "Terugdraaien vindt plaats om %@ (tijd van de router)";
"Another session applied these changes and they still wait for confirmation. Discarding runs their undo script now, so the router goes back to the settings from before them. This can't be undone." = "Een andere sessie heeft deze wijzigingen toegepast en ze wachten nog op bevestiging. Verwerpen voert hun terugdraaiscript nu uit, waardoor de router teruggaat naar de instellingen van vóór de wijzigingen. Dit kan niet ongedaan worden gemaakt.";

/* Server power commands (Redfish) */
"Sending the power command" = "De voedingsopdracht wordt verzonden";
"Power" = "Voeding";
"Turn on" = "Inschakelen";
"Shut down" = "Afsluiten";
"Restart" = "Opnieuw opstarten";
"Force restart" = "Geforceerd opnieuw opstarten";
"Force off" = "Geforceerd uitschakelen";
"Power cycle" = "Stroomcyclus";
"Turn on %@?" = "%@ inschakelen?";
"Shut down %@?" = "%@ afsluiten?";
"Restart %@?" = "%@ opnieuw opstarten?";
"Force restart %@?" = "%@ geforceerd opnieuw opstarten?";
"Force off %@?" = "%@ geforceerd uitschakelen?";
"Power cycle %@?" = "Stroomcyclus uitvoeren voor %@?";
"The server powers on and starts its operating system." = "De server schakelt in en start zijn besturingssysteem.";
"The operating system is asked to shut down. Everything running on the server stops." = "Het besturingssysteem wordt gevraagd af te sluiten. Alles wat op de server draait, stopt.";
"The operating system is asked to restart. Everything running on the server stops until it is back." = "Het besturingssysteem wordt gevraagd opnieuw op te starten. Alles wat op de server draait, stopt totdat hij terug is.";
"The server restarts at once, without shutting down the operating system. Unsaved data is lost." = "De server start meteen opnieuw op, zonder het besturingssysteem af te sluiten. Niet-opgeslagen gegevens gaan verloren.";
"The server turns off at once, like pulling the power cord. Unsaved data is lost." = "De server schakelt meteen uit, alsof de stroomkabel eruit wordt getrokken. Niet-opgeslagen gegevens gaan verloren.";
"The server turns off at once and back on, like pulling the power cord and plugging it in again. Unsaved data is lost." = "De server schakelt meteen uit en weer in, alsof de stroomkabel eruit wordt getrokken en weer wordt aangesloten. Niet-opgeslagen gegevens gaan verloren.";
"The server accepted the power command. Its power state can take a minute to change; read again to see it." = "De server heeft de voedingsopdracht geaccepteerd. Het kan een minuut duren voordat de voedingsstatus verandert; lees opnieuw om die te zien.";
"Netdeck reads this device over its API and never changes its settings. Power commands go out only after you confirm them." = "Netdeck leest dit apparaat via zijn API en wijzigt nooit de instellingen. Voedingsopdrachten worden pas verzonden nadat je ze hebt bevestigd.";

/* Embedded SSH client, sandbox */
"Trust the new host key" = "Vertrouw de nieuwe hostsleutel";
"Use the system ssh command (outside the Mac App Store)" = "Gebruik de systeemopdracht ssh (buiten de Mac App Store)";
"Netdeck has its own SSH client. Turn this on for devices it can't talk to, such as older ones that only offer RSA host keys or older ciphers. Applies to the next connection." = "Netdeck heeft een eigen SSH-client. Zet dit aan voor apparaten waarmee hij niet kan praten, zoals oudere apparaten die alleen RSA-hostsleutels of oudere coderingen aanbieden. Geldt voor de volgende verbinding.";
"The SSH connection was closed by the device." = "De SSH-verbinding is door het apparaat gesloten.";
"Connection timed out during the SSH handshake with %@." = "Time-out tijdens de SSH-handshake met %@.";
"The device refused the SSH shell: %@" = "Het apparaat heeft de SSH-shell geweigerd: %@";
"The device refused to start an SSH shell." = "Het apparaat weigerde een SSH-shell te starten.";
"The device's SSH algorithms aren't supported by the built-in SSH client: %@" = "De SSH-algoritmen van het apparaat worden niet ondersteund door de ingebouwde SSH-client: %@";
