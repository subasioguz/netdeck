/* HTTPS error cards */
"%@ presented a different security certificate than last time. That happens after a reset or a certificate renewal, but it can also mean someone is in between. Trust the new certificate only if you know why it changed." = "%@ esitti eri suojausvarmenteen kuin viimeksi. Näin käy nollauksen tai varmenteen uusimisen jälkeen, mutta se voi myös tarkoittaa, että joku on välissä. Luota uuteen varmenteeseen vain, jos tiedät miksi se muuttui.";
"Certificate changed" = "Varmenne muuttunut";
"HTTPS: the address can't be reached" = "HTTPS: osoitteeseen ei saada yhteyttä";
"HTTPS: the certificate changed" = "HTTPS: varmenne on muuttunut";
"Netdeck couldn't reach %@. Check that the device is on, the address and port are right (Synology uses 5001) and this Mac is on the same network." = "Netdeck ei saanut yhteyttä osoitteeseen %@. Tarkista, että laite on päällä, osoite ja portti ovat oikein (Synology käyttää porttia 5001) ja tämä Mac on samassa verkossa.";
"Trust the new certificate" = "Luota uuteen varmenteeseen";

/* MikroTik RouterOS */
"%@: VLANs on RouterOS need bridge VLAN filtering. Add the port to the bridge and turn on vlan-filtering first." = "%@: RouterOS:n VLANit vaativat bridge VLAN -suodatuksen. Lisää portti siltaan (bridge) ja ota vlan-filtering käyttöön ensin.";
"VLANs on RouterOS need bridge VLAN filtering. Turn on vlan-filtering on the bridge first." = "RouterOS:n VLANit vaativat bridge VLAN -suodatuksen. Ota vlan-filtering käyttöön sillassa (bridge) ensin.";
"VLANs %@ share one bridge VLAN entry on the router. Split it into one entry per VLAN first." = "VLANit %@ jakavat yhden bridge VLAN -merkinnän reitittimessä. Jaa se ensin yhteen merkintään per VLAN.";
"%@: choose a VLAN for this port." = "%@: valitse VLAN tälle portille.";
"RouterOS bridge VLANs have no names of their own. Netdeck shows the name of the VLAN's interface, or vlan and its number." = "RouterOS:n bridge-VLANeilla ei ole omia nimiä. Netdeck näyttää VLANin liitännän nimen tai vlan ja sen numeron.";
"VLAN '%@' has the VLAN interface '%@' on the router. Remove that interface first." = "VLANilla '%@' on VLAN-liitäntä '%@' reitittimessä. Poista ensin tämä liitäntä.";
"The router asks for a new password. Log in once with WinBox, WebFig or a terminal, set a password, then connect again." = "Reititin pyytää uutta salasanaa. Kirjaudu kerran WinBoxilla, WebFigillä tai päätteellä, aseta salasana ja yhdistä sitten uudelleen.";
"RouterOS has no candidate configuration to check in advance. Netdeck sends the commands one by one and undoes all of them if the router rejects one." = "RouterOS:ssä ei ole ehdokasmääritystä, jonka voisi tarkistaa etukäteen. Netdeck lähettää komennot yksi kerrallaan ja kumoaa ne kaikki, jos reititin hylkää yhden.";
"The router did not confirm the command." = "Reititin ei vahvistanut komentoa.";
"The undo timer is still on the router. Confirm again." = "Kumoamisajastin on edelleen reitittimessä. Vahvista uudelleen.";
"This change is too large for the router's undo script. Apply it in smaller parts." = "Tämä muutos on liian suuri reitittimen kumoamisskriptille. Ota se käyttöön pienemmissä osissa.";
"Netdeck could not read the router's clock, so it can't set the undo timer. Nothing was changed." = "Netdeck ei voinut lukea reitittimen kelloa, joten se ei voi asettaa kumoamisajastinta. Mitään ei muutettu.";
"The undo script on the router is incomplete." = "Reitittimen kumoamisskripti on epätäydellinen.";
"The undo timer did not start on the router." = "Kumoamisajastin ei käynnistynyt reitittimessä.";
"Netdeck could not set the undo timer on the router, so nothing was changed." = "Netdeck ei voinut asettaa kumoamisajastinta reitittimeen, joten mitään ei muutettu.";
"The undo script did not finish on the router." = "Kumoamisskripti ei valmistunut reitittimessä.";
"Undo runs at %@ (router time)" = "Kumoaminen ajetaan kello %@ (reitittimen aika)";
"Another session applied these changes and they still wait for confirmation. Discarding runs their undo script now, so the router goes back to the settings from before them. This can't be undone." = "Toinen istunto otti nämä muutokset käyttöön, ja ne odottavat vielä vahvistusta. Hylkääminen ajaa niiden kumoamisskriptin nyt, joten reititin palaa ennen niitä olleisiin asetuksiin. Tätä ei voi peruuttaa.";

/* Server power commands (Redfish) */
"Sending the power command" = "Lähetetään virtakomentoa";
"Power" = "Virta";
"Turn on" = "Käynnistä";
"Shut down" = "Sammuta";
"Restart" = "Käynnistä uudelleen";
"Force restart" = "Pakota uudelleenkäynnistys";
"Force off" = "Pakota sammutus";
"Power cycle" = "Virtasykli";
"Turn on %@?" = "Käynnistetäänkö %@?";
"Shut down %@?" = "Sammutetaanko %@?";
"Restart %@?" = "Käynnistetäänkö %@ uudelleen?";
"Force restart %@?" = "Pakotetaanko %@ uudelleenkäynnistykseen?";
"Force off %@?" = "Pakotetaanko %@ sammutukseen?";
"Power cycle %@?" = "Tehdäänkö %@ virtasykli?";
"The server powers on and starts its operating system." = "Palvelin käynnistyy ja käynnistää käyttöjärjestelmänsä.";
"The operating system is asked to shut down. Everything running on the server stops." = "Käyttöjärjestelmää pyydetään sammumaan. Kaikki palvelimella käynnissä oleva pysähtyy.";
"The operating system is asked to restart. Everything running on the server stops until it is back." = "Käyttöjärjestelmää pyydetään käynnistymään uudelleen. Kaikki palvelimella käynnissä oleva pysähtyy, kunnes se on takaisin.";
"The server restarts at once, without shutting down the operating system. Unsaved data is lost." = "Palvelin käynnistyy uudelleen heti sammuttamatta käyttöjärjestelmää. Tallentamattomat tiedot menetetään.";
"The server turns off at once, like pulling the power cord. Unsaved data is lost." = "Palvelin sammuu heti, kuin virtajohto vedettäisiin irti. Tallentamattomat tiedot menetetään.";
"The server turns off at once and back on, like pulling the power cord and plugging it in again. Unsaved data is lost." = "Palvelin sammuu heti ja käynnistyy uudelleen, kuin virtajohto vedettäisiin irti ja kytkettäisiin takaisin. Tallentamattomat tiedot menetetään.";
"The server accepted the power command. Its power state can take a minute to change; read again to see it." = "Palvelin hyväksyi virtakomennon. Sen virran tilan muuttuminen voi kestää minuutin; lue uudelleen nähdäksesi sen.";
"Netdeck reads this device over its API and never changes its settings. Power commands go out only after you confirm them." = "Netdeck lukee tätä laitetta sen API:n kautta eikä koskaan muuta sen asetuksia. Virtakomennot lähetetään vasta kun vahvistat ne.";

/* Embedded SSH client, sandbox */
"Trust the new host key" = "Luota uuteen isäntäavaimeen";
"Use the system ssh command (outside the Mac App Store)" = "Käytä järjestelmän ssh-komentoa (Mac App Storen ulkopuolella)";
"Netdeck has its own SSH client. Turn this on for devices it can't talk to, such as older ones that only offer RSA host keys or older ciphers. Applies to the next connection." = "Netdeckissä on oma SSH-asiakas. Ota tämä käyttöön laitteille, joiden kanssa se ei toimi, kuten vanhemmille laitteille, jotka tarjoavat vain RSA-isäntäavaimia tai vanhoja salauksia. Koskee seuraavaa yhteyttä.";
"The SSH connection was closed by the device." = "Laite sulki SSH-yhteyden.";
"Connection timed out during the SSH handshake with %@." = "Yhteys aikakatkaistiin SSH-kättelyn aikana kohteen %@ kanssa.";
"The device refused the SSH shell: %@" = "Laite hylkäsi SSH-kuoren: %@";
"The device refused to start an SSH shell." = "Laite kieltäytyi käynnistämästä SSH-kuorta.";
"The device's SSH algorithms aren't supported by the built-in SSH client: %@" = "Sisäänrakennettu SSH-asiakas ei tue laitteen SSH-algoritmeja: %@";
