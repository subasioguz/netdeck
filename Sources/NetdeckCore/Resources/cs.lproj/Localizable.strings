/* EdgeOS */
"%@ is not a VLAN-aware switch0 port. On EdgeOS, VLANs work only on switch0 ports with vlan-aware enabled." = "%@ není port switch0 s podporou VLAN. V EdgeOS fungují VLAN jen na portech switch0 se zapnutým vlan-aware.";
"Another change on the router is already waiting for confirmation. Confirm it or let its timer run out first." = "Další změna na routeru už čeká na potvrzení. Nejprve ji potvrďte nebo nechte vypršet její časovač.";
"EdgeOS can't change a VLAN's number. Delete the VLAN and add it again with the new number." = "EdgeOS neumí změnit číslo VLAN. Smažte VLAN a přidejte ji znovu s novým číslem.";
"Netdeck could not check whether the running configuration is saved. Changes that were never saved are lost if the router restarts with its saved configuration." = "Netdeck nemohl zjistit, zda je běžící konfigurace uložena. Změny, které nebyly nikdy uloženy, se ztratí, pokud se router restartuje s uloženou konfigurací.";
"Netdeck stopped the confirm timer and loaded the saved configuration again." = "Netdeck zastavil časovač potvrzení a znovu načetl uloženou konfiguraci.";
"On EdgeOS a VLAN has only a name (the description of its switch0 vif). Rename the VLAN instead." = "V EdgeOS má VLAN jen název (popis jejího vif na switch0). Přejmenujte raději VLAN.";
"The confirm timer is still running: the router restarts with its saved configuration when it runs out." = "Časovač potvrzení stále běží: po jeho vypršení se router restartuje s uloženou konfigurací.";
"The router keeps no commit revisions, so EdgeOS can't arm its confirm timer. Turn on commit revisions (system config-management commit-revisions) first." = "Router neuchovává revize commitů, takže EdgeOS nemůže nastavit časovač potvrzení. Nejprve zapněte revize commitů (system config-management commit-revisions).";
"The router rejected some commands:" = "Router odmítl některé příkazy:";
"The running configuration has changes that were never saved. If you don't confirm in time, the router restarts with its saved configuration and those changes are lost as well." = "Běžící konfigurace obsahuje změny, které nebyly nikdy uloženy. Pokud včas nepotvrdíte, router se restartuje s uloženou konfigurací a tyto změny se také ztratí.";
"This EdgeOS version has no commit-confirm, so Netdeck can't apply changes with a safety timer." = "Tato verze EdgeOS nemá commit-confirm, takže Netdeck nemůže použít změny s bezpečnostním časovačem.";
"VLAN 1 is the default VLAN; EdgeOS keeps the name 'default' for it." = "VLAN 1 je výchozí VLAN; EdgeOS pro ni ponechává název „default“.";
"VLANs on EdgeOS need the switch0 interface with vlan-aware enabled. Set that up on the router first." = "VLAN v EdgeOS vyžadují rozhraní switch0 se zapnutým vlan-aware. Nejprve to nastavte na routeru.";

/* Cisco IOS */
"This switch's IOS can't undo changes on its own (no revert timer). Netdeck doesn't apply changes without it." = "IOS tohoto switche neumí změny sám vrátit (bez revert timeru). Netdeck bez něj změny nepoužívá.";
"Netdeck needs privileged mode on this switch. Log in with a privilege 15 user or give the enable password." = "Netdeck potřebuje na tomto switchi privilegovaný režim. Přihlaste se uživatelem s úrovní oprávnění 15 nebo zadejte heslo enable.";
"Netdeck couldn't set up the configuration archive the revert timer needs:" = "Netdeck nemohl nastavit archiv konfigurace, který revert timer potřebuje:";
"IOS has no candidate configuration to check in advance. The switch checks each command as it is applied; if one is rejected, or if you don't confirm in time, the revert timer puts the previous configuration back." = "IOS nemá kandidátní konfiguraci, kterou by šlo předem zkontrolovat. Switch kontroluje každý příkaz při jeho použití; pokud je některý odmítnut, nebo pokud včas nepotvrdíte, revert timer obnoví předchozí konfiguraci.";
"The configuration archive the revert timer needs is not set up yet. Netdeck turns it on first (archive path flash:netdeck), outside the timer; this doesn't affect traffic." = "Archiv konfigurace, který revert timer potřebuje, ještě není nastaven. Netdeck ho nejprve zapne (archive path flash:netdeck), mimo časovač; provoz to neovlivní.";
"The switch shut this port down after an error (err-disabled)." = "Switch tento port po chybě vypnul (err-disabled).";
"%@: IOS doesn't accept '?' in a description." = "%@: IOS v popisu nepřijímá „?“.";
"%@ is a routed port (no switchport). Netdeck doesn't change VLANs on routed ports." = "%@ je směrovaný port (no switchport). Netdeck na směrovaných portech VLAN nemění.";
"%@ belongs to Port-channel%@; its VLANs follow the port-channel. Netdeck doesn't change them." = "%@ patří do Port-channel%@; jeho VLAN se řídí port-channelem. Netdeck je nemění.";
"VLANs 1002–1005 are reserved on Cisco switches." = "VLAN 1002–1005 jsou na switchích Cisco vyhrazeny.";
"'%@': IOS VLAN names can't contain spaces or '?' and are at most 32 characters." = "„%@“: názvy VLAN v IOS nesmí obsahovat mezery ani „?“ a mají nejvýše 32 znaků.";
"IOS VLANs have no description. Leave it empty." = "VLAN v IOS nemají popis. Nechte ho prázdný.";
"IOS can't change a VLAN's number. Add a VLAN with the new number and move the ports to it." = "IOS neumí změnit číslo VLAN. Přidejte VLAN s novým číslem a přesuňte do ní porty.";
"The default VLAN (1) can't be renamed or deleted." = "Výchozí VLAN (1) nelze přejmenovat ani smazat.";

/* API module (iDRAC, Synology DSM, TrueNAS) */
"'%@' is not a valid address." = "„%@“ není platná adresa.";
"Netdeck only connects over HTTPS. Use an https:// address." = "Netdeck se připojuje jen přes HTTPS. Použijte adresu začínající https://.";
