/* HTTPS error cards */
"%@ presented a different security certificate than last time. That happens after a reset or a certificate renewal, but it can also mean someone is in between. Trust the new certificate only if you know why it changed." = "%@ đưa ra chứng chỉ bảo mật khác lần trước. Điều đó xảy ra sau khi đặt lại hoặc gia hạn chứng chỉ, nhưng cũng có thể có người đứng giữa. Chỉ tin cậy chứng chỉ mới nếu bạn biết vì sao nó thay đổi.";
"Certificate changed" = "Chứng chỉ đã thay đổi";
"HTTPS: the address can't be reached" = "HTTPS: không thể truy cập địa chỉ";
"HTTPS: the certificate changed" = "HTTPS: chứng chỉ đã thay đổi";
"Netdeck couldn't reach %@. Check that the device is on, the address and port are right (Synology uses 5001) and this Mac is on the same network." = "Netdeck không thể truy cập %@. Hãy kiểm tra thiết bị đã bật, địa chỉ và cổng đúng (Synology dùng 5001) và máy Mac này cùng mạng.";
"Trust the new certificate" = "Tin cậy chứng chỉ mới";

/* MikroTik RouterOS */
"%@: VLANs on RouterOS need bridge VLAN filtering. Add the port to the bridge and turn on vlan-filtering first." = "%@: VLAN trên RouterOS cần bridge VLAN filtering. Hãy thêm cổng vào bridge và bật vlan-filtering trước.";
"VLANs on RouterOS need bridge VLAN filtering. Turn on vlan-filtering on the bridge first." = "VLAN trên RouterOS cần bridge VLAN filtering. Hãy bật vlan-filtering trên bridge trước.";
"VLANs %@ share one bridge VLAN entry on the router. Split it into one entry per VLAN first." = "VLAN %@ dùng chung một mục bridge VLAN trên router. Hãy tách thành một mục cho mỗi VLAN trước.";
"%@: choose a VLAN for this port." = "%@: hãy chọn VLAN cho cổng này.";
"RouterOS bridge VLANs have no names of their own. Netdeck shows the name of the VLAN's interface, or vlan and its number." = "Bridge VLAN của RouterOS không có tên riêng. Netdeck hiển thị tên giao diện của VLAN, hoặc vlan và số của nó.";
"VLAN '%@' has the VLAN interface '%@' on the router. Remove that interface first." = "VLAN '%@' có giao diện VLAN '%@' trên router. Hãy xóa giao diện đó trước.";
"The router asks for a new password. Log in once with WinBox, WebFig or a terminal, set a password, then connect again." = "Router yêu cầu mật khẩu mới. Hãy đăng nhập một lần bằng WinBox, WebFig hoặc terminal, đặt mật khẩu, rồi kết nối lại.";
"RouterOS has no candidate configuration to check in advance. Netdeck sends the commands one by one and undoes all of them if the router rejects one." = "RouterOS không có cấu hình candidate để kiểm tra trước. Netdeck gửi từng lệnh một và hoàn tác tất cả nếu router từ chối một lệnh.";
"The router did not confirm the command." = "Router đã không xác nhận lệnh.";
"The undo timer is still on the router. Confirm again." = "Bộ hẹn giờ hoàn tác vẫn còn trên router. Hãy xác nhận lại.";
"This change is too large for the router's undo script. Apply it in smaller parts." = "Thay đổi này quá lớn cho tập lệnh hoàn tác của router. Hãy áp dụng thành các phần nhỏ hơn.";
"Netdeck could not read the router's clock, so it can't set the undo timer. Nothing was changed." = "Netdeck không đọc được đồng hồ của router nên không thể đặt bộ hẹn giờ hoàn tác. Không có gì bị thay đổi.";
"The undo script on the router is incomplete." = "Tập lệnh hoàn tác trên router không đầy đủ.";
"The undo timer did not start on the router." = "Bộ hẹn giờ hoàn tác đã không khởi động trên router.";
"Netdeck could not set the undo timer on the router, so nothing was changed." = "Netdeck không thể đặt bộ hẹn giờ hoàn tác trên router nên không có gì bị thay đổi.";
"The undo script did not finish on the router." = "Tập lệnh hoàn tác đã không chạy xong trên router.";
"Undo runs at %@ (router time)" = "Hoàn tác chạy lúc %@ (giờ router)";
"Another session applied these changes and they still wait for confirmation. Discarding runs their undo script now, so the router goes back to the settings from before them. This can't be undone." = "Một phiên khác đã áp dụng các thay đổi này và chúng vẫn chờ xác nhận. Loại bỏ sẽ chạy tập lệnh hoàn tác ngay bây giờ, để router trở về cài đặt trước các thay đổi đó. Không thể hoàn tác.";

/* Server power commands (Redfish) */
"Sending the power command" = "Đang gửi lệnh nguồn";
"Power" = "Nguồn";
"Turn on" = "Bật";
"Shut down" = "Tắt máy";
"Restart" = "Khởi động lại";
"Force restart" = "Buộc khởi động lại";
"Force off" = "Buộc tắt";
"Power cycle" = "Power cycle";
"Turn on %@?" = "Bật %@?";
"Shut down %@?" = "Tắt máy %@?";
"Restart %@?" = "Khởi động lại %@?";
"Force restart %@?" = "Buộc khởi động lại %@?";
"Force off %@?" = "Buộc tắt %@?";
"Power cycle %@?" = "Power cycle %@?";
"The server powers on and starts its operating system." = "Máy chủ bật nguồn và khởi động hệ điều hành.";
"The operating system is asked to shut down. Everything running on the server stops." = "Hệ điều hành được yêu cầu tắt máy. Mọi thứ đang chạy trên máy chủ sẽ dừng.";
"The operating system is asked to restart. Everything running on the server stops until it is back." = "Hệ điều hành được yêu cầu khởi động lại. Mọi thứ đang chạy trên máy chủ sẽ dừng cho đến khi nó trở lại.";
"The server restarts at once, without shutting down the operating system. Unsaved data is lost." = "Máy chủ khởi động lại ngay, không tắt hệ điều hành. Dữ liệu chưa lưu sẽ mất.";
"The server turns off at once, like pulling the power cord. Unsaved data is lost." = "Máy chủ tắt ngay, như rút dây nguồn. Dữ liệu chưa lưu sẽ mất.";
"The server turns off at once and back on, like pulling the power cord and plugging it in again. Unsaved data is lost." = "Máy chủ tắt ngay rồi bật lại, như rút dây nguồn rồi cắm lại. Dữ liệu chưa lưu sẽ mất.";
"The server accepted the power command. Its power state can take a minute to change; read again to see it." = "Máy chủ đã nhận lệnh nguồn. Trạng thái nguồn có thể mất một phút để đổi; hãy đọc lại để xem.";
"Netdeck reads this device over its API and never changes its settings. Power commands go out only after you confirm them." = "Netdeck đọc thiết bị này qua API và không bao giờ thay đổi cài đặt của nó. Lệnh nguồn chỉ được gửi sau khi bạn xác nhận.";

/* Embedded SSH client, sandbox */
"Trust the new host key" = "Tin cậy khóa máy chủ mới";
"Use the system ssh command (outside the Mac App Store)" = "Dùng lệnh ssh của hệ thống (ngoài Mac App Store)";
"Netdeck has its own SSH client. Turn this on for devices it can't talk to, such as older ones that only offer RSA host keys or older ciphers. Applies to the next connection." = "Netdeck có ứng dụng khách SSH riêng. Hãy bật tùy chọn này cho các thiết bị nó không giao tiếp được, như thiết bị cũ chỉ cung cấp khóa máy chủ RSA hoặc mã hóa cũ. Áp dụng cho lần kết nối tiếp theo.";
"The SSH connection was closed by the device." = "Kết nối SSH đã bị thiết bị đóng.";
"Connection timed out during the SSH handshake with %@." = "Kết nối hết thời gian chờ trong lúc bắt tay SSH với %@.";
"The device refused the SSH shell: %@" = "Thiết bị từ chối shell SSH: %@";
"The device refused to start an SSH shell." = "Thiết bị từ chối khởi động shell SSH.";
"The device's SSH algorithms aren't supported by the built-in SSH client: %@" = "Thuật toán SSH của thiết bị không được ứng dụng khách SSH tích hợp hỗ trợ: %@";
"SSH algorithms: %@" = "Thuật toán SSH: %@";
"SSH, older algorithms" = "SSH, thuật toán cũ";
"%@ belongs to %@; its VLANs follow the LAG. Netdeck doesn't change them." = "%@ thuộc %@; VLAN của nó theo LAG. Netdeck không thay đổi chúng.";
"%@ is a routed port. Netdeck doesn't change VLANs on routed ports." = "%@ là cổng định tuyến. Netdeck không đổi VLAN trên cổng định tuyến.";
"%@: '?' can't be typed in a description on this switch." = "%@: trên switch này không thể gõ '?' trong mô tả.";
"%@: a trunk port must carry at least one VLAN. With none, AOS-CX carries them all." = "%@: cổng trunk phải mang ít nhất một VLAN. Nếu không có VLAN nào, AOS-CX mang tất cả.";
"'%@': AOS-CX VLAN names are 1–32 characters: letters, digits, '_' and '-'." = "'%@': tên VLAN trên AOS-CX dài 1–32 ký tự: chữ cái, chữ số, '_' và '-'.";
"AOS-CX %@ may not restore the configuration if the session drops before you confirm (fixed in 10.06). Update the switch to make changes with Netdeck." = "AOS-CX %@ có thể không khôi phục cấu hình nếu phiên bị ngắt trước khi bạn xác nhận (đã sửa ở 10.06). Hãy cập nhật switch để thay đổi bằng Netdeck.";
"AOS-CX commands" = "Lệnh AOS-CX";
"Another change is already waiting for confirmation on this switch (an auto checkpoint is running). Netdeck doesn't apply changes until it ends." = "Đã có một thay đổi khác đang chờ xác nhận trên switch này (auto checkpoint đang chạy). Netdeck không áp dụng thay đổi cho đến khi nó kết thúc.";
"If you don't confirm, the switch restores the configuration it had before the change." = "Nếu bạn không xác nhận, switch khôi phục cấu hình nó có trước thay đổi.";
"Netdeck couldn't save the configuration before the change:" = "Netdeck không lưu được cấu hình trước thay đổi:";
"Netdeck needs administrator rights on this switch. Log in as an administrator or manager user." = "Netdeck cần quyền quản trị trên switch này. Hãy đăng nhập bằng người dùng administrator hoặc manager.";
"The switch can't change a VLAN's number. Add a VLAN with the new number and move the ports to it." = "Switch không thể đổi số VLAN. Hãy thêm VLAN với số mới và chuyển các cổng sang đó.";
"The switch has no candidate configuration to check in advance. It applies each command at once; if one is rejected, or if you don't confirm in time, it restores the configuration it had before the change." = "Switch không có cấu hình ứng viên để kiểm tra trước. Nó áp dụng từng lệnh ngay lập tức; nếu một lệnh bị từ chối, hoặc bạn không xác nhận kịp, nó khôi phục cấu hình có trước thay đổi.";
"This switch can't undo changes on its own (no auto checkpoint). Netdeck doesn't apply changes without it." = "Switch này không thể tự hoàn tác thay đổi (không có auto checkpoint). Netdeck không áp dụng thay đổi nếu thiếu nó.";
"%@: a description can't contain '\"'." = "%@: mô tả không được chứa '\"'.";
"%@: the port must stay a member of at least one VLAN." = "%@: cổng phải vẫn là thành viên của ít nhất một VLAN.";
"'%@': VLAN names on this switch are 1–32 characters and can't contain '\"'." = "'%@': tên VLAN trên switch này dài 1–32 ký tự và không được chứa '\"'.";
"AOS-S commands" = "Lệnh AOS-S";
"Another change is already waiting for confirmation on this switch (Netdeck's restore job is scheduled). Netdeck doesn't apply changes until it ends." = "Đã có một thay đổi khác đang chờ xác nhận trên switch này (tác vụ khôi phục của Netdeck đã được lên lịch). Netdeck không áp dụng thay đổi cho đến khi nó kết thúc.";
"Netdeck couldn't set up the job that restores the configuration:" = "Netdeck không thiết lập được tác vụ khôi phục cấu hình:";
"This switch's VLANs have no description. Leave it empty." = "VLAN trên switch này không có mô tả. Hãy để trống.";
"This switch's firmware (%@) can't restore a configuration without restarting; that needs 16.05 or later. Netdeck reads it but doesn't change it." = "Firmware của switch này (%@) không thể khôi phục cấu hình mà không khởi động lại; cần 16.05 trở lên. Netdeck đọc nhưng không thay đổi nó.";
"TP-Link commands" = "Lệnh TP-Link";
"If you don't confirm, the switch restarts with its saved configuration. It is offline for a few minutes." = "Nếu bạn không xác nhận, switch khởi động lại với cấu hình đã lưu. Nó sẽ ngoại tuyến vài phút.";
"The switch has no candidate configuration to check in advance. It applies each command at once and saves nothing until you confirm. If a command is rejected, Netdeck puts the previous settings back; if you don't confirm in time, the switch restarts with its saved configuration." = "Switch không có cấu hình ứng viên để kiểm tra trước. Nó áp dụng ngay từng lệnh và không lưu gì cho đến khi bạn xác nhận. Nếu một lệnh bị từ chối, Netdeck đặt lại các thiết lập trước đó; nếu bạn không xác nhận kịp, switch khởi động lại với cấu hình đã lưu.";
"This switch has changes that aren't saved yet. Netdeck's safety net restarts the switch with its saved configuration, which would lose them too. Save or undo them on the switch first." = "Switch này có thay đổi chưa được lưu. Lưới an toàn của Netdeck khởi động lại switch với cấu hình đã lưu, nên các thay đổi đó cũng sẽ mất. Hãy lưu hoặc hoàn tác chúng trên switch trước.";
"An Omada controller manages this switch, and it only takes show commands. Netdeck reads it but doesn't change it; make changes in the controller." = "Switch này do một bộ điều khiển Omada quản lý và chỉ nhận lệnh show. Netdeck đọc nhưng không thay đổi nó; hãy thay đổi trong bộ điều khiển.";
"Netdeck couldn't schedule the restart that undoes the change:" = "Netdeck không thể lên lịch khởi động lại để hoàn tác thay đổi:";
"Netdeck couldn't put every setting back by itself. The switch restarts with its saved configuration within a minute and is offline for a few minutes." = "Netdeck không thể tự đặt lại mọi thiết lập. Switch sẽ khởi động lại với cấu hình đã lưu trong vòng một phút và ngoại tuyến vài phút.";
"%@: port descriptions on this switch are at most 16 characters, without quotes, brackets or < > , \\ &." = "%@: mô tả cổng trên switch này dài tối đa 16 ký tự, không có dấu ngoặc kép, dấu ngoặc đơn hay < > , \\ &.";
"%@ has a VLAN setup Netdeck can't show as access or trunk (%@). Change it on the switch." = "%@ có thiết lập VLAN mà Netdeck không thể hiển thị dưới dạng access hay trunk (%@). Hãy thay đổi trên switch.";
"'%@': VLAN names on this switch are 1–16 characters and can't contain \" < > , \\ or &." = "'%@': tên VLAN trên switch này dài 1–16 ký tự và không được chứa \" < > , \\ hay &.";

/* FortiGate (read only) */
"Hostname %@ · serial %@ · front panel, ports and history, read only" = "Hostname %@ · serial %@ · mặt trước, cổng và lịch sử, chỉ đọc";
"Netdeck only reads this device. Make changes on the device itself." = "Netdeck chỉ đọc thiết bị này. Hãy thay đổi trực tiếp trên thiết bị.";
