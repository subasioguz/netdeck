/* HTTPS error cards */
"%@ presented a different security certificate than last time. That happens after a reset or a certificate renewal, but it can also mean someone is in between. Trust the new certificate only if you know why it changed." = "%@ a prezentat un alt certificat de securitate decât data trecută. Se întâmplă după o resetare sau o reînnoire a certificatului, dar poate însemna și că cineva se află la mijloc. Ai încredere în noul certificat doar dacă știi de ce s-a schimbat.";
"Certificate changed" = "Certificat schimbat";
"HTTPS: the address can't be reached" = "HTTPS: adresa nu poate fi atinsă";
"HTTPS: the certificate changed" = "HTTPS: certificatul s-a schimbat";
"Netdeck couldn't reach %@. Check that the device is on, the address and port are right (Synology uses 5001) and this Mac is on the same network." = "Netdeck nu a putut ajunge la %@. Verifică dacă dispozitivul este pornit, adresa și portul sunt corecte (Synology folosește 5001) și acest Mac este în aceeași rețea.";
"Trust the new certificate" = "Ai încredere în noul certificat";

/* MikroTik RouterOS */
"%@: VLANs on RouterOS need bridge VLAN filtering. Add the port to the bridge and turn on vlan-filtering first." = "%@: VLAN-urile pe RouterOS necesită filtrarea VLAN pe bridge. Adaugă mai întâi portul la bridge și activează vlan-filtering.";
"VLANs on RouterOS need bridge VLAN filtering. Turn on vlan-filtering on the bridge first." = "VLAN-urile pe RouterOS necesită filtrarea VLAN pe bridge. Activează mai întâi vlan-filtering pe bridge.";
"VLANs %@ share one bridge VLAN entry on the router. Split it into one entry per VLAN first." = "VLAN-urile %@ împart o singură intrare VLAN de bridge pe router. Împarte-o mai întâi într-o intrare pe VLAN.";
"%@: choose a VLAN for this port." = "%@: alege un VLAN pentru acest port.";
"RouterOS bridge VLANs have no names of their own. Netdeck shows the name of the VLAN's interface, or vlan and its number." = "VLAN-urile de bridge RouterOS nu au nume proprii. Netdeck arată numele interfeței VLAN sau vlan și numărul său.";
"VLAN '%@' has the VLAN interface '%@' on the router. Remove that interface first." = "VLAN „%@” are interfața VLAN „%@” pe router. Elimină mai întâi acea interfață.";
"The router asks for a new password. Log in once with WinBox, WebFig or a terminal, set a password, then connect again." = "Routerul cere o parolă nouă. Autentifică-te o dată cu WinBox, WebFig sau un terminal, setează o parolă, apoi conectează-te din nou.";
"RouterOS has no candidate configuration to check in advance. Netdeck sends the commands one by one and undoes all of them if the router rejects one." = "RouterOS nu are o configurație candidat de verificat în avans. Netdeck trimite comenzile una câte una și le anulează pe toate dacă routerul respinge una.";
"The router did not confirm the command." = "Routerul nu a confirmat comanda.";
"The undo timer is still on the router. Confirm again." = "Temporizatorul de anulare este încă pe router. Confirmă din nou.";
"This change is too large for the router's undo script. Apply it in smaller parts." = "Această modificare este prea mare pentru scriptul de anulare al routerului. Aplic-o în părți mai mici.";
"Netdeck could not read the router's clock, so it can't set the undo timer. Nothing was changed." = "Netdeck nu a putut citi ceasul routerului, deci nu poate seta temporizatorul de anulare. Nu s-a schimbat nimic.";
"The undo script on the router is incomplete." = "Scriptul de anulare de pe router este incomplet.";
"The undo timer did not start on the router." = "Temporizatorul de anulare nu a pornit pe router.";
"Netdeck could not set the undo timer on the router, so nothing was changed." = "Netdeck nu a putut seta temporizatorul de anulare pe router, deci nu s-a schimbat nimic.";
"The undo script did not finish on the router." = "Scriptul de anulare nu s-a terminat pe router.";
"Undo runs at %@ (router time)" = "Anularea rulează la %@ (ora routerului)";
"Another session applied these changes and they still wait for confirmation. Discarding runs their undo script now, so the router goes back to the settings from before them. This can't be undone." = "O altă sesiune a aplicat aceste modificări și încă așteaptă confirmarea. Renunțarea rulează acum scriptul lor de anulare, deci routerul revine la setările dinaintea lor. Acest lucru nu poate fi anulat.";

/* Server power commands (Redfish) */
"Sending the power command" = "Se trimite comanda de alimentare";
"Power" = "Alimentare";
"Turn on" = "Pornește";
"Shut down" = "Oprește";
"Restart" = "Repornește";
"Force restart" = "Repornire forțată";
"Force off" = "Oprire forțată";
"Power cycle" = "Ciclu de alimentare";
"Turn on %@?" = "Pornești %@?";
"Shut down %@?" = "Oprești %@?";
"Restart %@?" = "Repornești %@?";
"Force restart %@?" = "Repornești forțat %@?";
"Force off %@?" = "Oprești forțat %@?";
"Power cycle %@?" = "Faci ciclu de alimentare pentru %@?";
"The server powers on and starts its operating system." = "Serverul pornește și își lansează sistemul de operare.";
"The operating system is asked to shut down. Everything running on the server stops." = "Sistemului de operare i se cere să se oprească. Tot ce rulează pe server se oprește.";
"The operating system is asked to restart. Everything running on the server stops until it is back." = "Sistemului de operare i se cere să repornească. Tot ce rulează pe server se oprește până revine.";
"The server restarts at once, without shutting down the operating system. Unsaved data is lost." = "Serverul repornește imediat, fără a opri sistemul de operare. Datele nesalvate se pierd.";
"The server turns off at once, like pulling the power cord. Unsaved data is lost." = "Serverul se oprește imediat, ca și cum ai scoate cablul de alimentare. Datele nesalvate se pierd.";
"The server turns off at once and back on, like pulling the power cord and plugging it in again. Unsaved data is lost." = "Serverul se oprește imediat și pornește la loc, ca și cum ai scoate cablul de alimentare și l-ai pune la loc. Datele nesalvate se pierd.";
"The server accepted the power command. Its power state can take a minute to change; read again to see it." = "Serverul a acceptat comanda de alimentare. Starea de alimentare poate dura un minut să se schimbe; citește din nou ca să o vezi.";
"Netdeck reads this device over its API and never changes its settings. Power commands go out only after you confirm them." = "Netdeck citește acest dispozitiv prin API și nu îi schimbă niciodată setările. Comenzile de alimentare se trimit doar după ce le confirmi.";

/* Embedded SSH client, sandbox */
"Trust the new host key" = "Ai încredere în noua cheie a gazdei";
"Use the system ssh command (outside the Mac App Store)" = "Folosește comanda de sistem ssh (în afara Mac App Store)";
"Netdeck has its own SSH client. Turn this on for devices it can't talk to, such as older ones that only offer RSA host keys or older ciphers. Applies to the next connection." = "Netdeck are propriul client SSH. Activează aceasta pentru dispozitivele cu care nu poate comunica, de exemplu cele mai vechi care oferă doar chei de gazdă RSA sau cifruri mai vechi. Se aplică la următoarea conexiune.";
"The SSH connection was closed by the device." = "Conexiunea SSH a fost închisă de dispozitiv.";
"Connection timed out during the SSH handshake with %@." = "Conexiunea a expirat în timpul handshake-ului SSH cu %@.";
"The device refused the SSH shell: %@" = "Dispozitivul a refuzat shell-ul SSH: %@";
"The device refused to start an SSH shell." = "Dispozitivul a refuzat să pornească un shell SSH.";
"The device's SSH algorithms aren't supported by the built-in SSH client: %@" = "Algoritmii SSH ai dispozitivului nu sunt acceptați de clientul SSH integrat: %@";
