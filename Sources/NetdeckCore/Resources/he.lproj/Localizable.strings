/* HTTPS error cards */
"%@ presented a different security certificate than last time. That happens after a reset or a certificate renewal, but it can also mean someone is in between. Trust the new certificate only if you know why it changed." = "%@ הציג אישור אבטחה שונה מהפעם הקודמת. זה קורה לאחר איפוס או חידוש אישור, אך עשוי לציין גם שמישהו מתערב בדרך. תנו אמון באישור החדש רק אם אתם יודעים למה הוא השתנה.";
"Certificate changed" = "האישור השתנה";
"HTTPS: the address can't be reached" = "HTTPS: אי אפשר להגיע לכתובת";
"HTTPS: the certificate changed" = "HTTPS: האישור השתנה";
"Netdeck couldn't reach %@. Check that the device is on, the address and port are right (Synology uses 5001) and this Mac is on the same network." = "Netdeck לא הצליח להגיע אל %@. ודאו שההתקן דלוק, שהכתובת והיציאה נכונות (Synology משתמש ב-5001) ושה-Mac נמצא באותה רשת.";
"Trust the new certificate" = "אמון באישור החדש";

/* MikroTik RouterOS */
"%@: VLANs on RouterOS need bridge VLAN filtering. Add the port to the bridge and turn on vlan-filtering first." = "%@: ‏VLAN ב-RouterOS דורשים סינון VLAN של הגשר. הוסיפו קודם את היציאה לגשר והפעילו vlan-filtering.";
"VLANs on RouterOS need bridge VLAN filtering. Turn on vlan-filtering on the bridge first." = "VLAN ב-RouterOS דורשים סינון VLAN של הגשר. הפעילו קודם vlan-filtering בגשר.";
"VLANs %@ share one bridge VLAN entry on the router. Split it into one entry per VLAN first." = "VLAN‏ %@ חולקים רשומת bridge VLAN אחת בראוטר. פצלו אותה קודם לרשומה נפרדת לכל VLAN.";
"%@: choose a VLAN for this port." = "%@: בחרו VLAN ליציאה הזו.";
"RouterOS bridge VLANs have no names of their own. Netdeck shows the name of the VLAN's interface, or vlan and its number." = "ל-bridge VLAN ב-RouterOS אין שמות משלהם. Netdeck מציג את שם ממשק ה-VLAN, או vlan ואת מספרו.";
"VLAN '%@' has the VLAN interface '%@' on the router. Remove that interface first." = "ל-VLAN ‏'%@' יש בראוטר ממשק VLAN בשם '%@'. הסירו קודם את הממשק הזה.";
"The router asks for a new password. Log in once with WinBox, WebFig or a terminal, set a password, then connect again." = "הראוטר מבקש סיסמה חדשה. התחברו פעם אחת עם WinBox, WebFig או טרמינל, הגדירו סיסמה והתחברו שוב.";
"RouterOS has no candidate configuration to check in advance. Netdeck sends the commands one by one and undoes all of them if the router rejects one." = "ב-RouterOS אין תצורת מועמד לבדיקה מראש. Netdeck שולח את הפקודות אחת אחת ומבטל את כולן אם הראוטר דוחה אחת.";
"The router did not confirm the command." = "הראוטר לא אישר את הפקודה.";
"The undo timer is still on the router. Confirm again." = "טיימר הביטול עדיין בראוטר. אשרו שוב.";
"This change is too large for the router's undo script. Apply it in smaller parts." = "השינוי הזה גדול מדי עבור סקריפט הביטול של הראוטר. החילו אותו בחלקים קטנים יותר.";
"Netdeck could not read the router's clock, so it can't set the undo timer. Nothing was changed." = "Netdeck לא הצליח לקרוא את שעון הראוטר, ולכן לא יכול להגדיר את טיימר הביטול. שום דבר לא שונה.";
"The undo script on the router is incomplete." = "סקריפט הביטול בראוטר לא שלם.";
"The undo timer did not start on the router." = "טיימר הביטול לא התחיל בראוטר.";
"Netdeck could not set the undo timer on the router, so nothing was changed." = "Netdeck לא הצליח להגדיר את טיימר הביטול בראוטר, ולכן שום דבר לא שונה.";
"The undo script did not finish on the router." = "סקריפט הביטול לא הסתיים בראוטר.";
"Undo runs at %@ (router time)" = "הביטול יפעל ב-%@ (שעון הראוטר)";
"Another session applied these changes and they still wait for confirmation. Discarding runs their undo script now, so the router goes back to the settings from before them. This can't be undone." = "סשן אחר החיל את השינויים האלה והם עדיין ממתינים לאישור. השלכה מריצה כעת את סקריפט הביטול שלהם, והראוטר חוזר להגדרות שלפניהם. אי אפשר לבטל פעולה זו.";

/* Server power commands (Redfish) */
"Sending the power command" = "שולח את פקודת החשמל";
"Power" = "חשמל";
"Turn on" = "הפעלה";
"Shut down" = "כיבוי";
"Restart" = "הפעלה מחדש";
"Force restart" = "הפעלה מחדש בכוח";
"Force off" = "כיבוי בכוח";
"Power cycle" = "ניתוק והפעלת חשמל";
"Turn on %@?" = "להפעיל את %@?";
"Shut down %@?" = "לכבות את %@?";
"Restart %@?" = "להפעיל מחדש את %@?";
"Force restart %@?" = "להפעיל מחדש בכוח את %@?";
"Force off %@?" = "לכבות בכוח את %@?";
"Power cycle %@?" = "לנתק ולהפעיל מחדש את החשמל של %@?";
"The server powers on and starts its operating system." = "השרת נדלק ומפעיל את מערכת ההפעלה שלו.";
"The operating system is asked to shut down. Everything running on the server stops." = "מערכת ההפעלה מתבקשת להיכבות. כל מה שרץ על השרת נעצר.";
"The operating system is asked to restart. Everything running on the server stops until it is back." = "מערכת ההפעלה מתבקשת לעשות הפעלה מחדש. כל מה שרץ על השרת נעצר עד שהוא חוזר.";
"The server restarts at once, without shutting down the operating system. Unsaved data is lost." = "השרת עושה הפעלה מחדש מיד, בלי לכבות את מערכת ההפעלה. נתונים שלא נשמרו יאבדו.";
"The server turns off at once, like pulling the power cord. Unsaved data is lost." = "השרת נכבה מיד, כמו משיכת כבל החשמל. נתונים שלא נשמרו יאבדו.";
"The server turns off at once and back on, like pulling the power cord and plugging it in again. Unsaved data is lost." = "השרת נכבה ונדלק מיד, כמו משיכת כבל החשמל וחיבורו מחדש. נתונים שלא נשמרו יאבדו.";
"The server accepted the power command. Its power state can take a minute to change; read again to see it." = "השרת קיבל את פקודת החשמל. שינוי מצב החשמל עשוי לקחת דקה; קראו שוב כדי לראות אותו.";
"Netdeck reads this device over its API and never changes its settings. Power commands go out only after you confirm them." = "Netdeck קורא את ההתקן הזה דרך ה-API ולעולם לא משנה את ההגדרות שלו. פקודות חשמל נשלחות רק לאחר שתאשרו אותן.";

/* Embedded SSH client, sandbox */
"Trust the new host key" = "אמון במפתח המארח החדש";
"Use the system ssh command (outside the Mac App Store)" = "שימוש בפקודת ה-ssh של המערכת (מחוץ ל-Mac App Store)";
"Netdeck has its own SSH client. Turn this on for devices it can't talk to, such as older ones that only offer RSA host keys or older ciphers. Applies to the next connection." = "ל-Netdeck יש לקוח SSH משלו. הפעילו זאת עבור התקנים שהוא לא מצליח לתקשר איתם, כמו ישנים שמציעים רק מפתחות מארח RSA או צפנים ישנים. חל מהחיבור הבא.";
"The SSH connection was closed by the device." = "חיבור ה-SSH נסגר על ידי ההתקן.";
"Connection timed out during the SSH handshake with %@." = "זמן החיבור פג במהלך לחיצת היד של SSH עם %@.";
"The device refused the SSH shell: %@" = "ההתקן דחה את מעטפת ה-SSH: %@";
"The device refused to start an SSH shell." = "ההתקן סירב להפעיל מעטפת SSH.";
"The device's SSH algorithms aren't supported by the built-in SSH client: %@" = "האלגוריתמים של SSH בהתקן אינם נתמכים על ידי לקוח ה-SSH המובנה: %@";
"SSH algorithms: %@" = "אלגוריתמי SSH: %@";
"SSH, older algorithms" = "SSH, אלגוריתמים ישנים";
"%@ belongs to %@; its VLANs follow the LAG. Netdeck doesn't change them." = "%@ שייכת ל-%@; ה-VLAN שלה נקבעים לפי ה-LAG. Netdeck לא משנה אותם.";
"%@ is a routed port. Netdeck doesn't change VLANs on routed ports." = "%@ היא יציאה מנותבת. Netdeck לא משנה VLAN ביציאות מנותבות.";
"%@: '?' can't be typed in a description on this switch." = "%@: בסוויץ' הזה אי אפשר להקליד '?' בתיאור.";
"%@: a trunk port must carry at least one VLAN. With none, AOS-CX carries them all." = "%@: יציאת trunk חייבת לשאת לפחות VLAN אחד. בלי אף אחד, AOS-CX נושא את כולם.";
"'%@': AOS-CX VLAN names are 1–32 characters: letters, digits, '_' and '-'." = "'%@': שמות VLAN ב-AOS-CX הם באורך 1–32 תווים: אותיות, ספרות, '_' ו-'-'.";
"AOS-CX %@ may not restore the configuration if the session drops before you confirm (fixed in 10.06). Update the switch to make changes with Netdeck." = "ייתכן ש-AOS-CX %@ לא ישחזר את התצורה אם החיבור ינותק לפני שתאשרו (תוקן ב-10.06). עדכנו את הסוויץ' כדי לבצע שינויים עם Netdeck.";
"AOS-CX commands" = "פקודות AOS-CX";
"Another change is already waiting for confirmation on this switch (an auto checkpoint is running). Netdeck doesn't apply changes until it ends." = "שינוי אחר כבר ממתין לאישור בסוויץ' הזה (auto checkpoint פועל). Netdeck לא מחיל שינויים עד שהוא יסתיים.";
"If you don't confirm, the switch restores the configuration it had before the change." = "אם לא תאשרו, הסוויץ' ישחזר את התצורה שהייתה לו לפני השינוי.";
"Netdeck couldn't save the configuration before the change:" = "Netdeck לא הצליח לשמור את התצורה שלפני השינוי:";
"Netdeck needs administrator rights on this switch. Log in as an administrator or manager user." = "Netdeck צריך הרשאות מנהל בסוויץ' הזה. התחברו עם משתמש administrator או manager.";
"The switch can't change a VLAN's number. Add a VLAN with the new number and move the ports to it." = "הסוויץ' לא יכול לשנות מספר VLAN. הוסיפו VLAN עם המספר החדש והעבירו אליו את היציאות.";
"The switch has no candidate configuration to check in advance. It applies each command at once; if one is rejected, or if you don't confirm in time, it restores the configuration it had before the change." = "לסוויץ' אין תצורה מועמדת לבדיקה מראש. הוא מחיל כל פקודה מיד; אם אחת נדחית, או אם לא תאשרו בזמן, הוא משחזר את התצורה שהייתה לו לפני השינוי.";
"This switch can't undo changes on its own (no auto checkpoint). Netdeck doesn't apply changes without it." = "הסוויץ' הזה לא יכול לבטל שינויים בעצמו (אין auto checkpoint). בלעדיו Netdeck לא מחיל שינויים.";
"%@: a description can't contain '\"'." = "%@: תיאור לא יכול להכיל '\"'.";
"%@: the port must stay a member of at least one VLAN." = "%@: היציאה חייבת להישאר חברה ב-VLAN אחד לפחות.";
"'%@': VLAN names on this switch are 1–32 characters and can't contain '\"'." = "'%@': שמות VLAN בסוויץ' הזה הם באורך 1–32 תווים ולא יכולים להכיל '\"'.";
"AOS-S commands" = "פקודות AOS-S";
"Another change is already waiting for confirmation on this switch (Netdeck's restore job is scheduled). Netdeck doesn't apply changes until it ends." = "שינוי אחר כבר ממתין לאישור בסוויץ' הזה (משימת השחזור של Netdeck מתוזמנת). Netdeck לא מחיל שינויים עד שהיא תסתיים.";
"Netdeck couldn't set up the job that restores the configuration:" = "Netdeck לא הצליח להגדיר את המשימה שמשחזרת את התצורה:";
"This switch's VLANs have no description. Leave it empty." = "ל-VLAN בסוויץ' הזה אין תיאור. השאירו אותו ריק.";
"This switch's firmware (%@) can't restore a configuration without restarting; that needs 16.05 or later. Netdeck reads it but doesn't change it." = "הקושחה של הסוויץ' הזה (%@) לא יכולה לשחזר תצורה בלי הפעלה מחדש; לשם כך נדרשת גרסה 16.05 ומעלה. Netdeck קורא אותו אבל לא משנה אותו.";
"TP-Link commands" = "פקודות TP-Link";
"If you don't confirm, the switch restarts with its saved configuration. It is offline for a few minutes." = "אם לא תאשרו, הסוויץ' יופעל מחדש עם התצורה השמורה שלו. הוא יהיה מנותק לכמה דקות.";
"The switch has no candidate configuration to check in advance. It applies each command at once and saves nothing until you confirm. If a command is rejected, Netdeck puts the previous settings back; if you don't confirm in time, the switch restarts with its saved configuration." = "לסוויץ' אין תצורה מועמדת שאפשר לבדוק מראש. הוא מחיל כל פקודה מיד ולא שומר דבר עד שתאשרו. אם פקודה נדחית, Netdeck מחזיר את ההגדרות הקודמות; אם לא תאשרו בזמן, הסוויץ' יופעל מחדש עם התצורה השמורה שלו.";
"This switch has changes that aren't saved yet. Netdeck's safety net restarts the switch with its saved configuration, which would lose them too. Save or undo them on the switch first." = "בסוויץ' הזה יש שינויים שעוד לא נשמרו. רשת הביטחון של Netdeck מפעילה מחדש את הסוויץ' עם התצורה השמורה, כך שגם הם היו הולכים לאיבוד. שמרו או בטלו אותם קודם בסוויץ'.";
"An Omada controller manages this switch, and it only takes show commands. Netdeck reads it but doesn't change it; make changes in the controller." = "בקר Omada מנהל את הסוויץ' הזה, והוא מקבל רק פקודות show. Netdeck קורא אותו אבל לא משנה אותו; בצעו שינויים בבקר.";
"Netdeck couldn't schedule the restart that undoes the change:" = "Netdeck לא הצליח לתזמן את ההפעלה מחדש שמבטלת את השינוי:";
"Netdeck couldn't put every setting back by itself. The switch restarts with its saved configuration within a minute and is offline for a few minutes." = "Netdeck לא הצליח להחזיר בעצמו את כל ההגדרות. הסוויץ' יופעל מחדש עם התצורה השמורה שלו תוך דקה ויהיה מנותק לכמה דקות.";
"%@: port descriptions on this switch are at most 16 characters, without quotes, brackets or < > , \\ &." = "%@: תיאורי פורטים בסוויץ' הזה הם עד 16 תווים, בלי מירכאות, סוגריים או < > , \\ &.";
"%@ has a VLAN setup Netdeck can't show as access or trunk (%@). Change it on the switch." = "ל-%@ יש הגדרת VLAN ש-Netdeck לא יכול להציג כ-access או trunk (%@). שנו אותה בסוויץ'.";
"'%@': VLAN names on this switch are 1–16 characters and can't contain \" < > , \\ or &." = "'%@': שמות VLAN בסוויץ' הזה הם באורך 1–16 תווים ואינם יכולים להכיל \" < > , \\ או &.";
