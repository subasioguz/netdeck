"Port roles are changed by a separate command after the other changes, not by a commit. They stay even if the timer rolls the rest back. To undo one, stage the old role again." = "Uloge portova mijenjaju se zasebnom naredbom nakon ostalih promjena, a ne commitom. Ostaju čak i ako mjerač vremena poništi ostalo. Za poništenje pripremite staru ulogu ponovno.";
"Power supplies and components" = "Napajanja i komponente";
"Powered off" = "Isključen";
"Powered on" = "Uključen";
"Read over the device's API · %@" = "Pročitano preko API-ja uređaja · %@";
"Reading…" = "Čitanje…";
"Redfish or REST · iDRAC, Synology, TrueNAS" = "Redfish ili REST · iDRAC, Synology, TrueNAS";
"Routed port" = "Usmjereni port";
"RouterOS commands" = "RouterOS naredbe";
"Run separately, not covered by the safety timer:" = "Izvodi se zasebno, ne pokriva ga sigurnosni mjerač vremena:";
"Security zone" = "Sigurnosna zona";
