"Trust the new certificate" = "Zaufaj nowemu certyfikatowi";

/* MikroTik RouterOS */
"%@: VLANs on RouterOS need bridge VLAN filtering. Add the port to the bridge and turn on vlan-filtering first." = "%@: VLAN-y w RouterOS wymagają filtrowania VLAN na bridge. Najpierw dodaj port do bridge i włącz vlan-filtering.";
"VLANs on RouterOS need bridge VLAN filtering. Turn on vlan-filtering on the bridge first." = "VLAN-y w RouterOS wymagają filtrowania VLAN na bridge. Najpierw włącz vlan-filtering na bridge.";
"VLANs %@ share one bridge VLAN entry on the router. Split it into one entry per VLAN first." = "VLAN-y %@ współdzielą jeden wpis bridge VLAN na routerze. Najpierw podziel go na osobny wpis dla każdego VLAN-u.";
"%@: choose a VLAN for this port." = "%@: wybierz VLAN dla tego portu.";
"RouterOS bridge VLANs have no names of their own. Netdeck shows the name of the VLAN's interface, or vlan and its number." = "VLAN-y bridge w RouterOS nie mają własnych nazw. Netdeck pokazuje nazwę interfejsu VLAN-u albo vlan i jego numer.";
"VLAN '%@' has the VLAN interface '%@' on the router. Remove that interface first." = "VLAN '%@' ma na routerze interfejs VLAN '%@'. Najpierw usuń ten interfejs.";
"The router asks for a new password. Log in once with WinBox, WebFig or a terminal, set a password, then connect again." = "Router prosi o nowe hasło. Zaloguj się raz przez WinBox, WebFig lub terminal, ustaw hasło, a potem połącz się ponownie.";
"RouterOS has no candidate configuration to check in advance. Netdeck sends the commands one by one and undoes all of them if the router rejects one." = "RouterOS nie ma konfiguracji kandydującej do wcześniejszego sprawdzenia. Netdeck wysyła polecenia pojedynczo i cofa wszystkie, jeśli router odrzuci którekolwiek.";
"The router did not confirm the command." = "Router nie potwierdził polecenia.";
"The undo timer is still on the router. Confirm again." = "Czasomierz cofania nadal działa na routerze. Potwierdź ponownie.";
"This change is too large for the router's undo script. Apply it in smaller parts." = "Ta zmiana jest zbyt duża dla skryptu cofania na routerze. Zastosuj ją w mniejszych częściach.";
"Netdeck could not read the router's clock, so it can't set the undo timer. Nothing was changed." = "Netdeck nie mógł odczytać zegara routera, więc nie może ustawić czasomierza cofania. Nic nie zmieniono.";
"The undo script on the router is incomplete." = "Skrypt cofania na routerze jest niekompletny.";
"The undo timer did not start on the router." = "Czasomierz cofania nie uruchomił się na routerze.";
"Netdeck could not set the undo timer on the router, so nothing was changed." = "Netdeck nie mógł ustawić czasomierza cofania na routerze, więc nic nie zmieniono.";
"The undo script did not finish on the router." = "Skrypt cofania nie zakończył się na routerze.";
"Undo runs at %@ (router time)" = "Cofnięcie nastąpi o %@ (czas routera)";
"Another session applied these changes and they still wait for confirmation. Discarding runs their undo script now, so the router goes back to the settings from before them. This can't be undone." = "Te zmiany zastosowała inna sesja i nadal czekają na potwierdzenie. Odrzucenie uruchomi teraz ich skrypt cofania, więc router wróci do ustawień sprzed nich. Tej operacji nie można cofnąć.";

/* Server power commands (Redfish) */
"Sending the power command" = "Wysyłanie polecenia zasilania";
"Power" = "Zasilanie";
"Turn on" = "Włącz";
"Shut down" = "Wyłącz";
"Restart" = "Uruchom ponownie";
