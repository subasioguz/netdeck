"Reading storage" = "קורא אחסון";
"Reading the event log" = "קורא את יומן האירועים";
"Reading alerts" = "קורא התראות";
"Processor" = "מעבד";
"%@ cores" = "%@ ליבות";
"Manufacturer" = "יצרן";
"Power draw" = "צריכת חשמל";
"Fans" = "מאווררים";
"Power supplies" = "ספקי כוח";
"Temperatures" = "טמפרטורות";
"Voltages" = "מתחים";
"Batteries" = "סוללות";
"Chassis intrusion" = "פתיחת המארז";
"%@: critical" = "%@: קריטי";
"%@: warning" = "%@: אזהרה";
"Not installed" = "לא מותקן";
"no input" = "אין כניסה";
"%@ W now" = "כרגע %@ W";
"Firmware %@" = "קושחה %@";
"Volume %@" = "כרך %@";
"%@ status: %@" = "מצב %@: %@";
"The system temperature is high." = "טמפרטורת המערכת גבוהה.";
