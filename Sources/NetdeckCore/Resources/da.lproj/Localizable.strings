/* EdgeOS */
"%@ is not a VLAN-aware switch0 port. On EdgeOS, VLANs work only on switch0 ports with vlan-aware enabled." = "%@ er ikke en VLAN-aware switch0-port. På EdgeOS virker VLAN kun på switch0-porte med vlan-aware aktiveret.";
"Another change on the router is already waiting for confirmation. Confirm it or let its timer run out first." = "En anden ændring på routeren afventer allerede bekræftelse. Bekræft den, eller lad dens timer udløbe først.";
"EdgeOS can't change a VLAN's number. Delete the VLAN and add it again with the new number." = "EdgeOS kan ikke ændre et VLAN's nummer. Slet VLAN'et, og tilføj det igen med det nye nummer.";
"Netdeck could not check whether the running configuration is saved. Changes that were never saved are lost if the router restarts with its saved configuration." = "Netdeck kunne ikke kontrollere, om den kørende konfiguration er gemt. Ændringer, der aldrig blev gemt, går tabt, hvis routeren genstarter med sin gemte konfiguration.";
"Netdeck stopped the confirm timer and loaded the saved configuration again." = "Netdeck stoppede bekræftelsestimeren og indlæste den gemte konfiguration igen.";
"On EdgeOS a VLAN has only a name (the description of its switch0 vif). Rename the VLAN instead." = "På EdgeOS har et VLAN kun et navn (beskrivelsen af dets switch0-vif). Omdøb i stedet VLAN'et.";
"The confirm timer is still running: the router restarts with its saved configuration when it runs out." = "Bekræftelsestimeren kører stadig: routeren genstarter med sin gemte konfiguration, når den udløber.";
"The router keeps no commit revisions, so EdgeOS can't arm its confirm timer. Turn on commit revisions (system config-management commit-revisions) first." = "Routeren gemmer ingen commit-revisioner, så EdgeOS kan ikke starte sin bekræftelsestimer. Slå først commit-revisioner til (system config-management commit-revisions).";
"The router rejected some commands:" = "Routeren afviste nogle kommandoer:";
"The running configuration has changes that were never saved. If you don't confirm in time, the router restarts with its saved configuration and those changes are lost as well." = "Den kørende konfiguration har ændringer, der aldrig blev gemt. Hvis du ikke bekræfter i tide, genstarter routeren med sin gemte konfiguration, og de ændringer går også tabt.";
"This EdgeOS version has no commit-confirm, so Netdeck can't apply changes with a safety timer." = "Denne EdgeOS-version har ingen commit-confirm, så Netdeck kan ikke anvende ændringer med en sikkerhedstimer.";
"VLAN 1 is the default VLAN; EdgeOS keeps the name 'default' for it." = "VLAN 1 er standard-VLAN'et; EdgeOS beholder navnet 'default' til det.";
"VLANs on EdgeOS need the switch0 interface with vlan-aware enabled. Set that up on the router first." = "VLAN på EdgeOS kræver switch0-grænsefladen med vlan-aware aktiveret. Sæt det op på routeren først.";

/* Cisco IOS */
"This switch's IOS can't undo changes on its own (no revert timer). Netdeck doesn't apply changes without it." = "Denne switchs IOS kan ikke fortryde ændringer af sig selv (ingen revert timer). Netdeck anvender ikke ændringer uden den.";
"Netdeck needs privileged mode on this switch. Log in with a privilege 15 user or give the enable password." = "Netdeck har brug for privilegeret tilstand på denne switch. Log ind med en bruger med privilege 15, eller angiv enable-adgangskoden.";
"Netdeck couldn't set up the configuration archive the revert timer needs:" = "Netdeck kunne ikke opsætte det konfigurationsarkiv, som revert timer har brug for:";
"IOS has no candidate configuration to check in advance. The switch checks each command as it is applied; if one is rejected, or if you don't confirm in time, the revert timer puts the previous configuration back." = "IOS har ingen kandidatkonfiguration, der kan kontrolleres på forhånd. Switchen kontrollerer hver kommando, efterhånden som den anvendes; hvis en afvises, eller hvis du ikke bekræfter i tide, gendanner revert timer den tidligere konfiguration.";
"The configuration archive the revert timer needs is not set up yet. Netdeck turns it on first (archive path flash:netdeck), outside the timer; this doesn't affect traffic." = "Det konfigurationsarkiv, som revert timer har brug for, er endnu ikke sat op. Netdeck slår det først til (archive path flash:netdeck), uden for timeren; det påvirker ikke trafikken.";
"The switch shut this port down after an error (err-disabled)." = "Switchen lukkede denne port ned efter en fejl (err-disabled).";
"%@: IOS doesn't accept '?' in a description." = "%@: IOS accepterer ikke '?' i en beskrivelse.";
"%@ is a routed port (no switchport). Netdeck doesn't change VLANs on routed ports." = "%@ er en routet port (no switchport). Netdeck ændrer ikke VLAN på routede porte.";
"%@ belongs to Port-channel%@; its VLANs follow the port-channel. Netdeck doesn't change them." = "%@ tilhører Port-channel%@; dens VLAN følger port-channel. Netdeck ændrer dem ikke.";
"VLANs 1002–1005 are reserved on Cisco switches." = "VLAN 1002–1005 er reserveret på Cisco-switche.";
"'%@': IOS VLAN names can't contain spaces or '?' and are at most 32 characters." = "'%@': IOS VLAN-navne kan ikke indeholde mellemrum eller '?' og er højst 32 tegn.";
"IOS VLANs have no description. Leave it empty." = "IOS VLAN har ingen beskrivelse. Lad den være tom.";
"IOS can't change a VLAN's number. Add a VLAN with the new number and move the ports to it." = "IOS kan ikke ændre et VLAN's nummer. Tilføj et VLAN med det nye nummer, og flyt portene til det.";
"The default VLAN (1) can't be renamed or deleted." = "Standard-VLAN'et (1) kan ikke omdøbes eller slettes.";

/* API module (iDRAC, Synology DSM, TrueNAS) */
"'%@' is not a valid address." = "'%@' er ikke en gyldig adresse.";
"Netdeck only connects over HTTPS. Use an https:// address." = "Netdeck opretter kun forbindelse via HTTPS. Brug en https://-adresse.";
"Netdeck can't reach the device over HTTPS (%@)." = "Netdeck kan ikke nå enheden via HTTPS (%@).";
"A secure connection to the device could not be set up (%@)." = "Der kunne ikke oprettes en sikker forbindelse til enheden (%@).";
"The security certificate of %@ has changed since Netdeck last connected. If the device was reset or got a new certificate, trust the new one. Otherwise someone may be intercepting the connection." = "Sikkerhedscertifikatet for %@ er ændret, siden Netdeck sidst var forbundet. Hvis enheden blev nulstillet eller fik et nyt certifikat, så stol på det nye. Ellers kan nogen være ved at opsnappe forbindelsen.";
"This account uses 2-step verification. Use an account without it for Netdeck." = "Denne konto bruger totrinsbekræftelse. Brug en konto uden til Netdeck.";
"The device wants this account's password changed. Change it on the device's web page, then try again." = "Enheden vil have ændret denne kontos adgangskode. Skift den på enhedens webside, og prøv igen.";
"The device blocked this Mac's address after too many failed logins. Unblock it on the device or wait, then try again." = "Enheden blokerede denne Macs adresse efter for mange mislykkede logins. Ophæv blokeringen på enheden, eller vent, og prøv igen.";
"The device doesn't offer this information." = "Enheden tilbyder ikke denne information.";
"The device sent an answer Netdeck doesn't understand (%@)." = "Enheden sendte et svar, som Netdeck ikke forstår (%@).";
"The device answered with HTTP error %@." = "Enheden svarede med HTTP-fejl %@.";
"not an HTTP answer" = "ikke et HTTP-svar";
"no session token" = "intet sessionstoken";
"login error %@" = "loginfejl %@";
"login failed" = "login mislykkedes";
"no answer" = "intet svar";
"The device stopped answering." = "Enheden holdt op med at svare.";
