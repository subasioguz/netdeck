/* HTTPS error cards */
"%@ presented a different security certificate than last time. That happens after a reset or a certificate renewal, but it can also mean someone is in between. Trust the new certificate only if you know why it changed." = "%@ hat ein anderes Sicherheitszertifikat als beim letzten Mal vorgelegt. Das passiert nach einem Zurücksetzen oder einer Zertifikatserneuerung, kann aber auch bedeuten, dass sich jemand dazwischengeschaltet hat. Vertraue dem neuen Zertifikat nur, wenn du weißt, warum es sich geändert hat.";
"Certificate changed" = "Zertifikat geändert";
"HTTPS: the address can't be reached" = "HTTPS: Die Adresse ist nicht erreichbar";
"HTTPS: the certificate changed" = "HTTPS: Das Zertifikat hat sich geändert";
"Netdeck couldn't reach %@. Check that the device is on, the address and port are right (Synology uses 5001) and this Mac is on the same network." = "Netdeck konnte %@ nicht erreichen. Prüfe, ob das Gerät eingeschaltet ist, Adresse und Port stimmen (Synology verwendet 5001) und dieser Mac im selben Netzwerk ist.";
"Trust the new certificate" = "Dem neuen Zertifikat vertrauen";

/* MikroTik RouterOS */
"%@: VLANs on RouterOS need bridge VLAN filtering. Add the port to the bridge and turn on vlan-filtering first." = "%@: VLANs unter RouterOS brauchen Bridge-VLAN-Filterung. Füge den Port zur Bridge hinzu und aktiviere zuerst vlan-filtering.";
"VLANs on RouterOS need bridge VLAN filtering. Turn on vlan-filtering on the bridge first." = "VLANs unter RouterOS brauchen Bridge-VLAN-Filterung. Aktiviere zuerst vlan-filtering auf der Bridge.";
"VLANs %@ share one bridge VLAN entry on the router. Split it into one entry per VLAN first." = "Die VLANs %@ teilen sich einen Bridge-VLAN-Eintrag auf dem Router. Teile ihn zuerst in einen Eintrag pro VLAN auf.";
"%@: choose a VLAN for this port." = "%@: Wähle ein VLAN für diesen Port.";
"RouterOS bridge VLANs have no names of their own. Netdeck shows the name of the VLAN's interface, or vlan and its number." = "Bridge-VLANs unter RouterOS haben keine eigenen Namen. Netdeck zeigt den Namen der VLAN-Schnittstelle oder vlan und ihre Nummer an.";
"VLAN '%@' has the VLAN interface '%@' on the router. Remove that interface first." = "VLAN „%@“ hat auf dem Router die VLAN-Schnittstelle „%@“. Entferne diese Schnittstelle zuerst.";
"The router asks for a new password. Log in once with WinBox, WebFig or a terminal, set a password, then connect again." = "Der Router verlangt ein neues Passwort. Melde dich einmal mit WinBox, WebFig oder einem Terminal an, lege ein Passwort fest und verbinde dich dann erneut.";
"RouterOS has no candidate configuration to check in advance. Netdeck sends the commands one by one and undoes all of them if the router rejects one." = "RouterOS hat keine Kandidatenkonfiguration, die vorab geprüft werden kann. Netdeck sendet die Befehle einzeln und macht alle rückgängig, wenn der Router einen ablehnt.";
"The router did not confirm the command." = "Der Router hat den Befehl nicht bestätigt.";
"The undo timer is still on the router. Confirm again." = "Der Undo-Timer läuft noch auf dem Router. Bestätige erneut.";
"This change is too large for the router's undo script. Apply it in smaller parts." = "Diese Änderung ist für das Undo-Skript des Routers zu groß. Wende sie in kleineren Teilen an.";
"Netdeck could not read the router's clock, so it can't set the undo timer. Nothing was changed." = "Netdeck konnte die Uhr des Routers nicht lesen und kann deshalb den Undo-Timer nicht setzen. Es wurde nichts geändert.";
"The undo script on the router is incomplete." = "Das Undo-Skript auf dem Router ist unvollständig.";
"The undo timer did not start on the router." = "Der Undo-Timer wurde auf dem Router nicht gestartet.";
"Netdeck could not set the undo timer on the router, so nothing was changed." = "Netdeck konnte den Undo-Timer auf dem Router nicht setzen, daher wurde nichts geändert.";
"The undo script did not finish on the router." = "Das Undo-Skript wurde auf dem Router nicht abgeschlossen.";
"Undo runs at %@ (router time)" = "Undo läuft um %@ (Routerzeit)";
"Another session applied these changes and they still wait for confirmation. Discarding runs their undo script now, so the router goes back to the settings from before them. This can't be undone." = "Eine andere Sitzung hat diese Änderungen angewendet und sie warten noch auf Bestätigung. Verwerfen führt jetzt ihre Undo-Skripte aus, sodass der Router zu den Einstellungen vor diesen Änderungen zurückkehrt. Das lässt sich nicht rückgängig machen.";

/* Server power commands (Redfish) */
"Sending the power command" = "Der Strombefehl wird gesendet";
"Power" = "Strom";
"Turn on" = "Einschalten";
"Shut down" = "Herunterfahren";
"Restart" = "Neu starten";
"Force restart" = "Neustart erzwingen";
"Force off" = "Ausschalten erzwingen";
"Power cycle" = "Aus- und wieder einschalten";
"Turn on %@?" = "%@ einschalten?";
"Shut down %@?" = "%@ herunterfahren?";
"Restart %@?" = "%@ neu starten?";
"Force restart %@?" = "Neustart von %@ erzwingen?";
"Force off %@?" = "%@ zwangsweise ausschalten?";
"Power cycle %@?" = "%@ aus- und wieder einschalten?";
"The server powers on and starts its operating system." = "Der Server schaltet sich ein und startet sein Betriebssystem.";
"The operating system is asked to shut down. Everything running on the server stops." = "Das Betriebssystem wird zum Herunterfahren aufgefordert. Alles, was auf dem Server läuft, wird beendet.";
"The operating system is asked to restart. Everything running on the server stops until it is back." = "Das Betriebssystem wird zum Neustart aufgefordert. Alles, was auf dem Server läuft, wird beendet, bis er wieder da ist.";
"The server restarts at once, without shutting down the operating system. Unsaved data is lost." = "Der Server startet sofort neu, ohne das Betriebssystem herunterzufahren. Nicht gespeicherte Daten gehen verloren.";
"The server turns off at once, like pulling the power cord. Unsaved data is lost." = "Der Server schaltet sich sofort aus, als würde man das Netzkabel ziehen. Nicht gespeicherte Daten gehen verloren.";
"The server turns off at once and back on, like pulling the power cord and plugging it in again. Unsaved data is lost." = "Der Server schaltet sich sofort aus und wieder ein, als würde man das Netzkabel ziehen und wieder einstecken. Nicht gespeicherte Daten gehen verloren.";
"The server accepted the power command. Its power state can take a minute to change; read again to see it." = "Der Server hat den Strombefehl akzeptiert. Es kann eine Minute dauern, bis sich der Stromstatus ändert; lies erneut, um ihn zu sehen.";
"Netdeck reads this device over its API and never changes its settings. Power commands go out only after you confirm them." = "Netdeck liest dieses Gerät über seine API und ändert nie seine Einstellungen. Strombefehle werden erst gesendet, nachdem du sie bestätigt hast.";

/* Embedded SSH client, sandbox */
"Trust the new host key" = "Dem neuen Hostschlüssel vertrauen";
"Use the system ssh command (outside the Mac App Store)" = "Den ssh-Systembefehl verwenden (außerhalb des Mac App Store)";
"Netdeck has its own SSH client. Turn this on for devices it can't talk to, such as older ones that only offer RSA host keys or older ciphers. Applies to the next connection." = "Netdeck hat einen eigenen SSH-Client. Schalte dies für Geräte ein, mit denen er nicht zurechtkommt, etwa ältere Geräte, die nur RSA-Hostschlüssel oder ältere Chiffren anbieten. Gilt für die nächste Verbindung.";
"The SSH connection was closed by the device." = "Die SSH-Verbindung wurde vom Gerät geschlossen.";
"Connection timed out during the SSH handshake with %@." = "Zeitüberschreitung beim SSH-Handshake mit %@.";
"The device refused the SSH shell: %@" = "Das Gerät hat die SSH-Shell abgelehnt: %@";
"The device refused to start an SSH shell." = "Das Gerät hat sich geweigert, eine SSH-Shell zu starten.";
"The device's SSH algorithms aren't supported by the built-in SSH client: %@" = "Die SSH-Algorithmen des Geräts werden vom integrierten SSH-Client nicht unterstützt: %@";
"SSH algorithms: %@" = "SSH-Algorithmen: %@";
"SSH, older algorithms" = "SSH, ältere Algorithmen";
"%@ belongs to %@; its VLANs follow the LAG. Netdeck doesn't change them." = "%@ gehört zu %@; seine VLANs folgen der LAG. Netdeck ändert sie nicht.";
"%@ is a routed port. Netdeck doesn't change VLANs on routed ports." = "%@ ist ein gerouteter Port. Netdeck ändert keine VLANs auf gerouteten Ports.";
"%@: '?' can't be typed in a description on this switch." = "%@: Auf diesem Switch kann in einer Beschreibung kein '?' eingegeben werden.";
"%@: a trunk port must carry at least one VLAN. With none, AOS-CX carries them all." = "%@: Ein Trunk-Port muss mindestens ein VLAN führen. Ohne eines führt AOS-CX alle.";
"'%@': AOS-CX VLAN names are 1–32 characters: letters, digits, '_' and '-'." = "'%@': VLAN-Namen unter AOS-CX haben 1–32 Zeichen: Buchstaben, Ziffern, '_' und '-'.";
"AOS-CX %@ may not restore the configuration if the session drops before you confirm (fixed in 10.06). Update the switch to make changes with Netdeck." = "AOS-CX %@ stellt die Konfiguration möglicherweise nicht wieder her, wenn die Sitzung vor deiner Bestätigung abbricht (in 10.06 behoben). Aktualisiere den Switch, um mit Netdeck Änderungen vorzunehmen.";
"AOS-CX commands" = "AOS-CX-Befehle";
"Another change is already waiting for confirmation on this switch (an auto checkpoint is running). Netdeck doesn't apply changes until it ends." = "Auf diesem Switch wartet bereits eine andere Änderung auf Bestätigung (ein Auto-Checkpoint läuft). Netdeck wendet keine Änderungen an, bis er endet.";
"If you don't confirm, the switch restores the configuration it had before the change." = "Bestätigst du nicht, stellt der Switch die Konfiguration von vor der Änderung wieder her.";
"Netdeck couldn't save the configuration before the change:" = "Netdeck konnte die Konfiguration von vor der Änderung nicht sichern:";
"Netdeck needs administrator rights on this switch. Log in as an administrator or manager user." = "Netdeck braucht Administratorrechte auf diesem Switch. Melde dich mit einem Administrator- oder Manager-Benutzer an.";
"The switch can't change a VLAN's number. Add a VLAN with the new number and move the ports to it." = "Der Switch kann die Nummer eines VLANs nicht ändern. Füge ein VLAN mit der neuen Nummer hinzu und verschiebe die Ports dorthin.";
"The switch has no candidate configuration to check in advance. It applies each command at once; if one is rejected, or if you don't confirm in time, it restores the configuration it had before the change." = "Der Switch hat keine Kandidatenkonfiguration, die sich vorab prüfen ließe. Er wendet jeden Befehl sofort an; wird einer abgelehnt oder bestätigst du nicht rechtzeitig, stellt er die Konfiguration von vor der Änderung wieder her.";
"This switch can't undo changes on its own (no auto checkpoint). Netdeck doesn't apply changes without it." = "Dieser Switch kann Änderungen nicht selbst rückgängig machen (kein Auto-Checkpoint). Ohne ihn wendet Netdeck keine Änderungen an.";
"%@: a description can't contain '\"'." = "%@: Eine Beschreibung darf kein '\"' enthalten.";
"%@: the port must stay a member of at least one VLAN." = "%@: Der Port muss Mitglied mindestens eines VLANs bleiben.";
"'%@': VLAN names on this switch are 1–32 characters and can't contain '\"'." = "'%@': VLAN-Namen auf diesem Switch haben 1–32 Zeichen und dürfen kein '\"' enthalten.";
"AOS-S commands" = "AOS-S-Befehle";
"Another change is already waiting for confirmation on this switch (Netdeck's restore job is scheduled). Netdeck doesn't apply changes until it ends." = "Auf diesem Switch wartet bereits eine andere Änderung auf Bestätigung (der Wiederherstellungsjob von Netdeck ist geplant). Netdeck wendet keine Änderungen an, bis er endet.";
"Netdeck couldn't set up the job that restores the configuration:" = "Netdeck konnte den Job, der die Konfiguration wiederherstellt, nicht einrichten:";
"This switch's VLANs have no description. Leave it empty." = "VLANs haben auf diesem Switch keine Beschreibung. Lass sie leer.";
"This switch's firmware (%@) can't restore a configuration without restarting; that needs 16.05 or later. Netdeck reads it but doesn't change it." = "Die Firmware dieses Switches (%@) kann eine Konfiguration nicht ohne Neustart wiederherstellen; dafür ist 16.05 oder neuer nötig. Netdeck liest ihn, ändert ihn aber nicht.";
