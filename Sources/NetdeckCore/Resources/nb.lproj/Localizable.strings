"The system temperature is high." = "Systemtemperaturen er høy.";
"This account can't read storage information. Use an administrator account to see volumes and disks." = "Denne kontoen kan ikke lese lagringsinformasjon. Bruk en administratorkonto for å se volumer og disker.";

/* HTTPS error cards */
"%@ presented a different security certificate than last time. That happens after a reset or a certificate renewal, but it can also mean someone is in between. Trust the new certificate only if you know why it changed." = "%@ presenterte et annet sikkerhetssertifikat enn sist. Det skjer etter en tilbakestilling eller sertifikatfornyelse, men kan også bety at noen sitter midt imellom. Stol på det nye sertifikatet bare hvis du vet hvorfor det ble endret.";
"Certificate changed" = "Sertifikat endret";
"HTTPS: the address can't be reached" = "HTTPS: adressen kan ikke nås";
"HTTPS: the certificate changed" = "HTTPS: sertifikatet er endret";
"Netdeck couldn't reach %@. Check that the device is on, the address and port are right (Synology uses 5001) and this Mac is on the same network." = "Netdeck kunne ikke nå %@. Kontroller at enheten er på, at adressen og porten er riktige (Synology bruker 5001) og at denne Macen er på samme nettverk.";
"Trust the new certificate" = "Stol på det nye sertifikatet";

/* MikroTik RouterOS */
"%@: VLANs on RouterOS need bridge VLAN filtering. Add the port to the bridge and turn on vlan-filtering first." = "%@: VLAN på RouterOS krever bridge VLAN-filtrering. Legg porten til i bridgen og slå på vlan-filtering først.";
"VLANs on RouterOS need bridge VLAN filtering. Turn on vlan-filtering on the bridge first." = "VLAN på RouterOS krever bridge VLAN-filtrering. Slå på vlan-filtering på bridgen først.";
"VLANs %@ share one bridge VLAN entry on the router. Split it into one entry per VLAN first." = "VLAN %@ deler én bridge VLAN-oppføring på ruteren. Del den opp i én oppføring per VLAN først.";
"%@: choose a VLAN for this port." = "%@: velg et VLAN for denne porten.";
"RouterOS bridge VLANs have no names of their own. Netdeck shows the name of the VLAN's interface, or vlan and its number." = "Bridge-VLAN på RouterOS har ikke egne navn. Netdeck viser navnet på VLAN-ets grensesnitt, eller vlan og nummeret.";
"VLAN '%@' has the VLAN interface '%@' on the router. Remove that interface first." = "VLAN «%@» har VLAN-grensesnittet «%@» på ruteren. Fjern det grensesnittet først.";
"The router asks for a new password. Log in once with WinBox, WebFig or a terminal, set a password, then connect again." = "Ruteren ber om et nytt passord. Logg inn én gang med WinBox, WebFig eller en terminal, sett et passord og koble til på nytt.";
"RouterOS has no candidate configuration to check in advance. Netdeck sends the commands one by one and undoes all of them if the router rejects one." = "RouterOS har ingen kandidatkonfigurasjon som kan kontrolleres på forhånd. Netdeck sender kommandoene én etter én og angrer alle hvis ruteren avviser en.";
"The router did not confirm the command." = "Ruteren bekreftet ikke kommandoen.";
"The undo timer is still on the router. Confirm again." = "Angretidtakeren ligger fortsatt på ruteren. Bekreft på nytt.";
"This change is too large for the router's undo script. Apply it in smaller parts." = "Denne endringen er for stor for ruterens angreskript. Bruk den i mindre deler.";
"Netdeck could not read the router's clock, so it can't set the undo timer. Nothing was changed." = "Netdeck kunne ikke lese ruterens klokke og kan derfor ikke sette angretidtakeren. Ingenting ble endret.";
"The undo script on the router is incomplete." = "Angreskriptet på ruteren er ufullstendig.";
"The undo timer did not start on the router." = "Angretidtakeren startet ikke på ruteren.";
"Netdeck could not set the undo timer on the router, so nothing was changed." = "Netdeck kunne ikke sette angretidtakeren på ruteren, så ingenting ble endret.";
"The undo script did not finish on the router." = "Angreskriptet ble ikke ferdig på ruteren.";
"Undo runs at %@ (router time)" = "Angring kjøres kl. %@ (ruterens tid)";
"Another session applied these changes and they still wait for confirmation. Discarding runs their undo script now, so the router goes back to the settings from before them. This can't be undone." = "En annen økt brukte disse endringene, og de venter fortsatt på bekreftelse. Forkasting kjører angreskriptet deres nå, så ruteren går tilbake til innstillingene fra før dem. Dette kan ikke angres.";

/* Server power commands (Redfish) */
"Sending the power command" = "Sender strømkommandoen";
"Power" = "Strøm";
"Turn on" = "Slå på";
"Shut down" = "Slå av";
"Restart" = "Start på nytt";
"Force restart" = "Tving omstart";
"Force off" = "Tving av";
"Power cycle" = "Strømsyklus";
"Turn on %@?" = "Slå på %@?";
"Shut down %@?" = "Slå av %@?";
"Restart %@?" = "Starte %@ på nytt?";
"Force restart %@?" = "Tvinge omstart av %@?";
"Force off %@?" = "Tvinge %@ av?";
"Power cycle %@?" = "Kjøre strømsyklus på %@?";
"The server powers on and starts its operating system." = "Serveren slås på og starter operativsystemet.";
"The operating system is asked to shut down. Everything running on the server stops." = "Operativsystemet blir bedt om å slå seg av. Alt som kjører på serveren stopper.";
"The operating system is asked to restart. Everything running on the server stops until it is back." = "Operativsystemet blir bedt om å starte på nytt. Alt som kjører på serveren stopper til den er tilbake.";
"The server restarts at once, without shutting down the operating system. Unsaved data is lost." = "Serveren starter på nytt umiddelbart, uten at operativsystemet avsluttes. Ulagrede data går tapt.";
"The server turns off at once, like pulling the power cord. Unsaved data is lost." = "Serveren slås av umiddelbart, som å trekke ut strømkabelen. Ulagrede data går tapt.";
"The server turns off at once and back on, like pulling the power cord and plugging it in again. Unsaved data is lost." = "Serveren slås av umiddelbart og på igjen, som å trekke ut strømkabelen og sette den inn igjen. Ulagrede data går tapt.";
"The server accepted the power command. Its power state can take a minute to change; read again to see it." = "Serveren godtok strømkommandoen. Det kan ta et minutt før strømtilstanden endres. Les på nytt for å se den.";
"Netdeck reads this device over its API and never changes its settings. Power commands go out only after you confirm them." = "Netdeck leser denne enheten over API-et og endrer aldri innstillingene. Strømkommandoer sendes først etter at du har bekreftet dem.";

/* Embedded SSH client, sandbox */
"Trust the new host key" = "Stol på den nye vertsnøkkelen";
"Use the system ssh command (outside the Mac App Store)" = "Bruk systemets ssh-kommando (utenfor Mac App Store)";
"Netdeck has its own SSH client. Turn this on for devices it can't talk to, such as older ones that only offer RSA host keys or older ciphers. Applies to the next connection." = "Netdeck har sin egen SSH-klient. Slå dette på for enheter den ikke kan snakke med, for eksempel eldre enheter som bare tilbyr RSA-vertsnøkler eller eldre chiffer. Gjelder for neste tilkobling.";
"The SSH connection was closed by the device." = "SSH-tilkoblingen ble lukket av enheten.";
"Connection timed out during the SSH handshake with %@." = "Tilkoblingen fikk tidsavbrudd under SSH-håndtrykket med %@.";
"The device refused the SSH shell: %@" = "Enheten avviste SSH-skallet: %@";
"The device refused to start an SSH shell." = "Enheten nektet å starte et SSH-skall.";
"The device's SSH algorithms aren't supported by the built-in SSH client: %@" = "Enhetens SSH-algoritmer støttes ikke av den innebygde SSH-klienten: %@";
"SSH algorithms: %@" = "SSH-algoritmer: %@";
"SSH, older algorithms" = "SSH, eldre algoritmer";
"%@ belongs to %@; its VLANs follow the LAG. Netdeck doesn't change them." = "%@ tilhører %@. VLAN-ene følger LAG-en. Netdeck endrer dem ikke.";
"%@ is a routed port. Netdeck doesn't change VLANs on routed ports." = "%@ er en rutet port. Netdeck endrer ikke VLAN på rutede porter.";
"%@: '?' can't be typed in a description on this switch." = "%@: '?' kan ikke skrives i en beskrivelse på denne switchen.";
"%@: a trunk port must carry at least one VLAN. With none, AOS-CX carries them all." = "%@: en trunk-port må bære minst ett VLAN. Uten noen bærer AOS-CX alle.";
"'%@': AOS-CX VLAN names are 1–32 characters: letters, digits, '_' and '-'." = "'%@': VLAN-navn i AOS-CX har 1–32 tegn: bokstaver, sifre, '_' og '-'.";
"AOS-CX %@ may not restore the configuration if the session drops before you confirm (fixed in 10.06). Update the switch to make changes with Netdeck." = "AOS-CX %@ gjenoppretter kanskje ikke konfigurasjonen hvis økten brytes før du bekrefter (rettet i 10.06). Oppdater switchen for å gjøre endringer med Netdeck.";
"AOS-CX commands" = "AOS-CX-kommandoer";
"Another change is already waiting for confirmation on this switch (an auto checkpoint is running). Netdeck doesn't apply changes until it ends." = "En annen endring venter allerede på bekreftelse på denne switchen (et auto checkpoint kjører). Netdeck bruker ikke endringer før det er ferdig.";
"If you don't confirm, the switch restores the configuration it had before the change." = "Hvis du ikke bekrefter, gjenoppretter switchen konfigurasjonen den hadde før endringen.";
"Netdeck couldn't save the configuration before the change:" = "Netdeck kunne ikke lagre konfigurasjonen fra før endringen:";
"Netdeck needs administrator rights on this switch. Log in as an administrator or manager user." = "Netdeck trenger administratorrettigheter på denne switchen. Logg inn som en administrator- eller manager-bruker.";
"The switch can't change a VLAN's number. Add a VLAN with the new number and move the ports to it." = "Switchen kan ikke endre nummeret på et VLAN. Legg til et VLAN med det nye nummeret og flytt portene dit.";
"The switch has no candidate configuration to check in advance. It applies each command at once; if one is rejected, or if you don't confirm in time, it restores the configuration it had before the change." = "Switchen har ingen kandidatkonfigurasjon som kan kontrolleres på forhånd. Den bruker hver kommando med en gang; hvis en blir avvist, eller hvis du ikke bekrefter i tide, gjenoppretter den konfigurasjonen fra før endringen.";
"This switch can't undo changes on its own (no auto checkpoint). Netdeck doesn't apply changes without it." = "Denne switchen kan ikke angre endringer av seg selv (ingen auto checkpoint). Netdeck bruker ikke endringer uten det.";
"%@: a description can't contain '\"'." = "%@: en beskrivelse kan ikke inneholde '\"'.";
"%@: the port must stay a member of at least one VLAN." = "%@: porten må fortsatt være medlem av minst ett VLAN.";
"'%@': VLAN names on this switch are 1–32 characters and can't contain '\"'." = "'%@': VLAN-navn på denne switchen har 1–32 tegn og kan ikke inneholde '\"'.";
"AOS-S commands" = "AOS-S-kommandoer";
"Another change is already waiting for confirmation on this switch (Netdeck's restore job is scheduled). Netdeck doesn't apply changes until it ends." = "En annen endring venter allerede på bekreftelse på denne switchen (Netdecks gjenopprettingsjobb er planlagt). Netdeck bruker ikke endringer før den er ferdig.";
"Netdeck couldn't set up the job that restores the configuration:" = "Netdeck kunne ikke sette opp jobben som gjenoppretter konfigurasjonen:";
"This switch's VLANs have no description. Leave it empty." = "VLAN på denne switchen har ingen beskrivelse. La den stå tom.";
"This switch's firmware (%@) can't restore a configuration without restarting; that needs 16.05 or later. Netdeck reads it but doesn't change it." = "Fastvaren på denne switchen (%@) kan ikke gjenopprette en konfigurasjon uten omstart; det krever 16.05 eller nyere. Netdeck leser den, men endrer den ikke.";
"TP-Link commands" = "TP-Link-kommandoer";
"If you don't confirm, the switch restarts with its saved configuration. It is offline for a few minutes." = "Hvis du ikke bekrefter, starter switchen på nytt med den lagrede konfigurasjonen. Den er frakoblet i noen minutter.";
"The switch has no candidate configuration to check in advance. It applies each command at once and saves nothing until you confirm. If a command is rejected, Netdeck puts the previous settings back; if you don't confirm in time, the switch restarts with its saved configuration." = "Switchen har ingen kandidatkonfigurasjon som kan sjekkes på forhånd. Den tar i bruk hver kommando med en gang og lagrer ingenting før du bekrefter. Hvis en kommando avvises, setter Netdeck tilbake de forrige innstillingene; hvis du ikke bekrefter i tide, starter switchen på nytt med den lagrede konfigurasjonen.";
"This switch has changes that aren't saved yet. Netdeck's safety net restarts the switch with its saved configuration, which would lose them too. Save or undo them on the switch first." = "Denne switchen har endringer som ikke er lagret ennå. Sikkerhetsnettet i Netdeck starter switchen på nytt med den lagrede konfigurasjonen, så de ville også gått tapt. Lagre eller angre dem på switchen først.";
"An Omada controller manages this switch, and it only takes show commands. Netdeck reads it but doesn't change it; make changes in the controller." = "En Omada-kontroller styrer denne switchen, og den tar bare imot show-kommandoer. Netdeck leser den, men endrer den ikke; gjør endringer i kontrolleren.";
"Netdeck couldn't schedule the restart that undoes the change:" = "Netdeck kunne ikke planlegge omstarten som angrer endringen:";
"Netdeck couldn't put every setting back by itself. The switch restarts with its saved configuration within a minute and is offline for a few minutes." = "Netdeck klarte ikke å sette tilbake alle innstillingene selv. Switchen starter på nytt med den lagrede konfigurasjonen innen ett minutt og er frakoblet i noen minutter.";
"%@: port descriptions on this switch are at most 16 characters, without quotes, brackets or < > , \\ &." = "%@: portbeskrivelser på denne switchen er maks 16 tegn, uten anførselstegn, parenteser eller < > , \\ &.";
"%@ has a VLAN setup Netdeck can't show as access or trunk (%@). Change it on the switch." = "%@ har et VLAN-oppsett som Netdeck ikke kan vise som access eller trunk (%@). Endre det på switchen.";
"'%@': VLAN names on this switch are 1–16 characters and can't contain \" < > , \\ or &." = "'%@': VLAN-navn på denne switchen er 1–16 tegn og kan ikke inneholde \" < > , \\ eller &.";
