"Power draw" = "Споживання енергії";
"Fans" = "Вентилятори";
"Power supplies" = "Блоки живлення";
"Temperatures" = "Температури";
"Voltages" = "Напруги";
"Batteries" = "Батареї";
"Chassis intrusion" = "Відкриття корпусу";
"%@: critical" = "%@: критично";
"%@: warning" = "%@: попередження";
"Not installed" = "Не встановлено";
"no input" = "немає входу";
