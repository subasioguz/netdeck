/* MikroTik RouterOS */
"%@: VLANs on RouterOS need bridge VLAN filtering. Add the port to the bridge and turn on vlan-filtering first." = "%@: les VLAN a RouterOS necessiten filtratge de VLAN al bridge. Afegeix primer el port al bridge i activa vlan-filtering.";
"VLANs on RouterOS need bridge VLAN filtering. Turn on vlan-filtering on the bridge first." = "Les VLAN a RouterOS necessiten filtratge de VLAN al bridge. Activa primer vlan-filtering al bridge.";
"VLANs %@ share one bridge VLAN entry on the router. Split it into one entry per VLAN first." = "Les VLAN %@ comparteixen una entrada de VLAN del bridge al router. Divideix-la primer en una entrada per VLAN.";
"%@: choose a VLAN for this port." = "%@: tria una VLAN per a aquest port.";
"RouterOS bridge VLANs have no names of their own. Netdeck shows the name of the VLAN's interface, or vlan and its number." = "Les VLAN de bridge de RouterOS no tenen nom propi. Netdeck mostra el nom de la interfície de la VLAN, o vlan i el seu número.";
"VLAN '%@' has the VLAN interface '%@' on the router. Remove that interface first." = "La VLAN '%@' té la interfície de VLAN '%@' al router. Elimina primer aquesta interfície.";
"The router asks for a new password. Log in once with WinBox, WebFig or a terminal, set a password, then connect again." = "El router demana una contrasenya nova. Inicia la sessió una vegada amb WinBox, WebFig o un terminal, defineix una contrasenya i torna a connectar.";
"RouterOS has no candidate configuration to check in advance. Netdeck sends the commands one by one and undoes all of them if the router rejects one." = "RouterOS no té configuració candidata per comprovar per endavant. Netdeck envia les ordres una a una i les desfà totes si el router en rebutja una.";
"The router did not confirm the command." = "El router no ha confirmat l'ordre.";
"The undo timer is still on the router. Confirm again." = "El temporitzador de desfer encara és al router. Torna a confirmar.";
"This change is too large for the router's undo script. Apply it in smaller parts." = "Aquest canvi és massa gran per a l'script de desfer del router. Aplica'l en parts més petites.";
"Netdeck could not read the router's clock, so it can't set the undo timer. Nothing was changed." = "Netdeck no ha pogut llegir el rellotge del router, de manera que no pot definir el temporitzador de desfer. No s'ha canviat res.";
"The undo script on the router is incomplete." = "L'script de desfer al router és incomplet.";
"The undo timer did not start on the router." = "El temporitzador de desfer no s'ha iniciat al router.";
"Netdeck could not set the undo timer on the router, so nothing was changed." = "Netdeck no ha pogut definir el temporitzador de desfer al router, de manera que no s'ha canviat res.";
"The undo script did not finish on the router." = "L'script de desfer no ha acabat al router.";
"Undo runs at %@ (router time)" = "Desfer s'executa a les %@ (hora del router)";
"Another session applied these changes and they still wait for confirmation. Discarding runs their undo script now, so the router goes back to the settings from before them. This can't be undone." = "Una altra sessió ha aplicat aquests canvis i encara esperen confirmació. Descartar-los executa ara el seu script de desfer, de manera que el router torna a la configuració d'abans dels canvis. No es pot desfer.";

/* Server power commands (Redfish) */
"Sending the power command" = "Enviant l'ordre d'alimentació";
"Power" = "Alimentació";
"Turn on" = "Encén";
"Shut down" = "Apaga";
"Restart" = "Reinicia";
"Force restart" = "Reinicia a la força";
"Force off" = "Apaga a la força";
"Power cycle" = "Cicle d'alimentació";
"Turn on %@?" = "Vols encendre %@?";
"Shut down %@?" = "Vols apagar %@?";
"Restart %@?" = "Vols reiniciar %@?";
"Force restart %@?" = "Vols reiniciar %@ a la força?";
"Force off %@?" = "Vols apagar %@ a la força?";
"Power cycle %@?" = "Vols fer un cicle d'alimentació a %@?";
"The server powers on and starts its operating system." = "El servidor s'encén i inicia el seu sistema operatiu.";
"The operating system is asked to shut down. Everything running on the server stops." = "Es demana al sistema operatiu que s'apagui. Tot el que s'executa al servidor s'atura.";
"The operating system is asked to restart. Everything running on the server stops until it is back." = "Es demana al sistema operatiu que es reiniciï. Tot el que s'executa al servidor s'atura fins que torna.";
"The server restarts at once, without shutting down the operating system. Unsaved data is lost." = "El servidor es reinicia a l'instant, sense apagar el sistema operatiu. Les dades no desades es perden.";
"The server turns off at once, like pulling the power cord. Unsaved data is lost." = "El servidor s'apaga a l'instant, com si s'arrenqués el cable d'alimentació. Les dades no desades es perden.";
"The server turns off at once and back on, like pulling the power cord and plugging it in again. Unsaved data is lost." = "El servidor s'apaga i es torna a encendre a l'instant, com si s'arrenqués el cable d'alimentació i es tornés a connectar. Les dades no desades es perden.";
"The server accepted the power command. Its power state can take a minute to change; read again to see it." = "El servidor ha acceptat l'ordre d'alimentació. L'estat d'alimentació pot trigar un minut a canviar; torna a llegir per veure'l.";
"Netdeck reads this device over its API and never changes its settings. Power commands go out only after you confirm them." = "Netdeck llegeix aquest dispositiu per la seva API i mai no en canvia la configuració. Les ordres d'alimentació només s'envien després que les confirmis.";

/* Embedded SSH client, sandbox */
"Trust the new host key" = "Confia en la nova clau del host";
"Use the system ssh command (outside the Mac App Store)" = "Fes servir l'ordre ssh del sistema (fora de la Mac App Store)";
"Netdeck has its own SSH client. Turn this on for devices it can't talk to, such as older ones that only offer RSA host keys or older ciphers. Applies to the next connection." = "Netdeck té el seu propi client SSH. Activa-ho per als dispositius amb què no pot parlar, com els més antics que només ofereixen claus de host RSA o xifrats antics. S'aplica a la propera connexió.";
"The SSH connection was closed by the device." = "El dispositiu ha tancat la connexió SSH.";
"Connection timed out during the SSH handshake with %@." = "La connexió ha esgotat el temps durant l'encaixada de mans SSH amb %@.";
"The device refused the SSH shell: %@" = "El dispositiu ha rebutjat l'intèrpret SSH: %@";
"The device refused to start an SSH shell." = "El dispositiu s'ha negat a iniciar un intèrpret SSH.";
"The device's SSH algorithms aren't supported by the built-in SSH client: %@" = "Els algorismes SSH del dispositiu no són compatibles amb el client SSH integrat: %@";
"SSH algorithms: %@" = "Algorismes SSH: %@";
"SSH, older algorithms" = "SSH, algorismes antics";
"%@ belongs to %@; its VLANs follow the LAG. Netdeck doesn't change them." = "%@ pertany a %@; les seves VLAN segueixen el LAG. Netdeck no les canvia.";
"%@ is a routed port. Netdeck doesn't change VLANs on routed ports." = "%@ és un port encaminat. Netdeck no canvia VLAN en ports encaminats.";
"%@: '?' can't be typed in a description on this switch." = "%@: en aquest switch no es pot escriure '?' en una descripció.";
"%@: a trunk port must carry at least one VLAN. With none, AOS-CX carries them all." = "%@: un port trunk ha de portar almenys una VLAN. Sense cap, AOS-CX les porta totes.";
"'%@': AOS-CX VLAN names are 1–32 characters: letters, digits, '_' and '-'." = "'%@': els noms de VLAN d'AOS-CX tenen d'1 a 32 caràcters: lletres, xifres, '_' i '-'.";
"AOS-CX %@ may not restore the configuration if the session drops before you confirm (fixed in 10.06). Update the switch to make changes with Netdeck." = "AOS-CX %@ pot no restaurar la configuració si la sessió cau abans que confirmis (corregit a la 10.06). Actualitza el switch per fer canvis amb Netdeck.";
"AOS-CX commands" = "Ordres d'AOS-CX";
"Another change is already waiting for confirmation on this switch (an auto checkpoint is running). Netdeck doesn't apply changes until it ends." = "En aquest switch ja hi ha un altre canvi esperant confirmació (hi ha un auto checkpoint en marxa). Netdeck no aplica canvis fins que acabi.";
"If you don't confirm, the switch restores the configuration it had before the change." = "Si no confirmes, el switch restaura la configuració que tenia abans del canvi.";
"Netdeck couldn't save the configuration before the change:" = "Netdeck no ha pogut desar la configuració d'abans del canvi:";
"Netdeck needs administrator rights on this switch. Log in as an administrator or manager user." = "Netdeck necessita drets d'administrador en aquest switch. Inicia la sessió amb un usuari administrator o manager.";
"The switch can't change a VLAN's number. Add a VLAN with the new number and move the ports to it." = "El switch no pot canviar el número d'una VLAN. Afegeix una VLAN amb el número nou i mou-hi els ports.";
"The switch has no candidate configuration to check in advance. It applies each command at once; if one is rejected, or if you don't confirm in time, it restores the configuration it had before the change." = "El switch no té cap configuració candidata per comprovar per endavant. Aplica cada ordre immediatament; si se'n rebutja una, o si no confirmes a temps, restaura la configuració que tenia abans del canvi.";
"This switch can't undo changes on its own (no auto checkpoint). Netdeck doesn't apply changes without it." = "Aquest switch no pot desfer els canvis tot sol (sense auto checkpoint). Netdeck no aplica canvis sense això.";
"%@: a description can't contain '\"'." = "%@: una descripció no pot contenir '\"'.";
"%@: the port must stay a member of at least one VLAN." = "%@: el port ha de continuar sent membre d'almenys una VLAN.";
"'%@': VLAN names on this switch are 1–32 characters and can't contain '\"'." = "'%@': els noms de VLAN d'aquest switch tenen d'1 a 32 caràcters i no poden contenir '\"'.";
"AOS-S commands" = "Ordres d'AOS-S";
"Another change is already waiting for confirmation on this switch (Netdeck's restore job is scheduled). Netdeck doesn't apply changes until it ends." = "En aquest switch ja hi ha un altre canvi esperant confirmació (la tasca de restauració de Netdeck està programada). Netdeck no aplica canvis fins que acabi.";
"Netdeck couldn't set up the job that restores the configuration:" = "Netdeck no ha pogut configurar la tasca que restaura la configuració:";
"This switch's VLANs have no description. Leave it empty." = "Les VLAN d'aquest switch no tenen descripció. Deixa-ho en blanc.";
"This switch's firmware (%@) can't restore a configuration without restarting; that needs 16.05 or later. Netdeck reads it but doesn't change it." = "El microprogramari d'aquest switch (%@) no pot restaurar una configuració sense reiniciar; cal la 16.05 o posterior. Netdeck el llegeix però no el canvia.";
"TP-Link commands" = "Ordres de TP-Link";
"If you don't confirm, the switch restarts with its saved configuration. It is offline for a few minutes." = "Si no confirmes, el switch es reinicia amb la configuració desada. Queda fora de línia uns minuts.";
"The switch has no candidate configuration to check in advance. It applies each command at once and saves nothing until you confirm. If a command is rejected, Netdeck puts the previous settings back; if you don't confirm in time, the switch restarts with its saved configuration." = "El switch no té cap configuració candidata per comprovar abans. Aplica cada ordre de seguida i no desa res fins que confirmes. Si rebutja una ordre, Netdeck torna a posar la configuració anterior; si no confirmes a temps, el switch es reinicia amb la configuració desada.";
"This switch has changes that aren't saved yet. Netdeck's safety net restarts the switch with its saved configuration, which would lose them too. Save or undo them on the switch first." = "Aquest switch té canvis que encara no s'han desat. La xarxa de seguretat de Netdeck reinicia el switch amb la configuració desada, i també es perdrien. Desa'ls o desfés-los primer al switch.";
"An Omada controller manages this switch, and it only takes show commands. Netdeck reads it but doesn't change it; make changes in the controller." = "Un controlador Omada gestiona aquest switch, i només accepta ordres show. Netdeck el llegeix però no el canvia; fes els canvis al controlador.";
"Netdeck couldn't schedule the restart that undoes the change:" = "Netdeck no ha pogut programar el reinici que desfà el canvi:";
"Netdeck couldn't put every setting back by itself. The switch restarts with its saved configuration within a minute and is offline for a few minutes." = "Netdeck no ha pogut restablir tota la configuració pel seu compte. El switch es reinicia amb la configuració desada d'aquí a un minut i queda fora de línia uns minuts.";
"%@: port descriptions on this switch are at most 16 characters, without quotes, brackets or < > , \\ &." = "%@: les descripcions de port d'aquest switch tenen com a màxim 16 caràcters, sense cometes, parèntesis ni < > , \\ &.";
"%@ has a VLAN setup Netdeck can't show as access or trunk (%@). Change it on the switch." = "%@ té una configuració de VLAN que Netdeck no pot mostrar com a access o trunk (%@). Canvia-la al switch.";
"'%@': VLAN names on this switch are 1–16 characters and can't contain \" < > , \\ or &." = "'%@': els noms de VLAN d'aquest switch tenen d'1 a 16 caràcters i no poden contenir \" < > , \\ ni &.";

/* FortiGate (read only) */
"Hostname %@ · serial %@ · front panel, ports and history, read only" = "Hostname %@ · sèrie %@ · panell frontal, ports i historial, només lectura";
"Netdeck only reads this device. Make changes on the device itself." = "Netdeck només llegeix aquest dispositiu. Fes els canvis al mateix dispositiu.";
