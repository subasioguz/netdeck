/* HTTPS error cards */
"%@ presented a different security certificate than last time. That happens after a reset or a certificate renewal, but it can also mean someone is in between. Trust the new certificate only if you know why it changed." = "%@ menampilkan sertifikat keamanan yang berbeda dari sebelumnya. Itu terjadi setelah reset atau pembaruan sertifikat, tetapi bisa juga berarti ada pihak di tengah. Percayai sertifikat baru hanya jika Anda tahu mengapa sertifikat itu berubah.";
"Certificate changed" = "Sertifikat berubah";
"HTTPS: the address can't be reached" = "HTTPS: alamat tidak dapat dijangkau";
"HTTPS: the certificate changed" = "HTTPS: sertifikat berubah";
"Netdeck couldn't reach %@. Check that the device is on, the address and port are right (Synology uses 5001) and this Mac is on the same network." = "Netdeck tidak dapat menjangkau %@. Periksa apakah perangkat menyala, alamat dan port benar (Synology memakai 5001), dan Mac ini berada di jaringan yang sama.";
"Trust the new certificate" = "Percayai sertifikat baru";

/* MikroTik RouterOS */
"%@: VLANs on RouterOS need bridge VLAN filtering. Add the port to the bridge and turn on vlan-filtering first." = "%@: VLAN di RouterOS membutuhkan bridge VLAN filtering. Tambahkan port ke bridge dan aktifkan vlan-filtering terlebih dahulu.";
"VLANs on RouterOS need bridge VLAN filtering. Turn on vlan-filtering on the bridge first." = "VLAN di RouterOS membutuhkan bridge VLAN filtering. Aktifkan vlan-filtering di bridge terlebih dahulu.";
"VLANs %@ share one bridge VLAN entry on the router. Split it into one entry per VLAN first." = "VLAN %@ berbagi satu entri bridge VLAN di router. Pisahkan menjadi satu entri per VLAN terlebih dahulu.";
"%@: choose a VLAN for this port." = "%@: pilih VLAN untuk port ini.";
"RouterOS bridge VLANs have no names of their own. Netdeck shows the name of the VLAN's interface, or vlan and its number." = "Bridge VLAN RouterOS tidak memiliki nama sendiri. Netdeck menampilkan nama antarmuka VLAN, atau vlan dan nomornya.";
"VLAN '%@' has the VLAN interface '%@' on the router. Remove that interface first." = "VLAN '%@' memiliki antarmuka VLAN '%@' di router. Hapus antarmuka itu terlebih dahulu.";
"The router asks for a new password. Log in once with WinBox, WebFig or a terminal, set a password, then connect again." = "Router meminta kata sandi baru. Masuk sekali dengan WinBox, WebFig, atau terminal, atur kata sandi, lalu hubungkan lagi.";
"RouterOS has no candidate configuration to check in advance. Netdeck sends the commands one by one and undoes all of them if the router rejects one." = "RouterOS tidak memiliki konfigurasi kandidat untuk diperiksa sebelumnya. Netdeck mengirim perintah satu per satu dan membatalkan semuanya jika router menolak salah satunya.";
"The router did not confirm the command." = "Router tidak mengonfirmasi perintah.";
"The undo timer is still on the router. Confirm again." = "Timer pembatalan masih ada di router. Konfirmasi lagi.";
"This change is too large for the router's undo script. Apply it in smaller parts." = "Perubahan ini terlalu besar untuk skrip pembatalan router. Terapkan dalam bagian yang lebih kecil.";
"Netdeck could not read the router's clock, so it can't set the undo timer. Nothing was changed." = "Netdeck tidak dapat membaca jam router, sehingga tidak dapat mengatur timer pembatalan. Tidak ada yang diubah.";
"The undo script on the router is incomplete." = "Skrip pembatalan di router tidak lengkap.";
"The undo timer did not start on the router." = "Timer pembatalan tidak mulai di router.";
"Netdeck could not set the undo timer on the router, so nothing was changed." = "Netdeck tidak dapat mengatur timer pembatalan di router, sehingga tidak ada yang diubah.";
"The undo script did not finish on the router." = "Skrip pembatalan tidak selesai di router.";
"Undo runs at %@ (router time)" = "Pembatalan berjalan pada %@ (waktu router)";
"Another session applied these changes and they still wait for confirmation. Discarding runs their undo script now, so the router goes back to the settings from before them. This can't be undone." = "Sesi lain menerapkan perubahan ini dan masih menunggu konfirmasi. Membuangnya menjalankan skrip pembatalannya sekarang, sehingga router kembali ke pengaturan sebelum perubahan itu. Ini tidak dapat dibatalkan.";

/* Server power commands (Redfish) */
"Sending the power command" = "Mengirim perintah daya";
"Power" = "Daya";
"Turn on" = "Nyalakan";
"Shut down" = "Matikan";
"Restart" = "Restart";
"Force restart" = "Paksa restart";
"Force off" = "Paksa mati";
"Power cycle" = "Power cycle";
"Turn on %@?" = "Nyalakan %@?";
"Shut down %@?" = "Matikan %@?";
"Restart %@?" = "Restart %@?";
"Force restart %@?" = "Paksa restart %@?";
"Force off %@?" = "Paksa mati %@?";
"Power cycle %@?" = "Power cycle %@?";
"The server powers on and starts its operating system." = "Server menyala dan memulai sistem operasinya.";
"The operating system is asked to shut down. Everything running on the server stops." = "Sistem operasi diminta untuk shut down. Semua yang berjalan di server berhenti.";
"The operating system is asked to restart. Everything running on the server stops until it is back." = "Sistem operasi diminta untuk restart. Semua yang berjalan di server berhenti sampai server kembali.";
"The server restarts at once, without shutting down the operating system. Unsaved data is lost." = "Server restart seketika, tanpa mematikan sistem operasi. Data yang belum disimpan hilang.";
"The server turns off at once, like pulling the power cord. Unsaved data is lost." = "Server mati seketika, seperti mencabut kabel daya. Data yang belum disimpan hilang.";
"The server turns off at once and back on, like pulling the power cord and plugging it in again. Unsaved data is lost." = "Server mati seketika lalu menyala lagi, seperti mencabut kabel daya lalu mencolokkannya lagi. Data yang belum disimpan hilang.";
"The server accepted the power command. Its power state can take a minute to change; read again to see it." = "Server menerima perintah daya. Status dayanya bisa butuh semenit untuk berubah; baca lagi untuk melihatnya.";
"Netdeck reads this device over its API and never changes its settings. Power commands go out only after you confirm them." = "Netdeck membaca perangkat ini lewat API-nya dan tidak pernah mengubah pengaturannya. Perintah daya baru dikirim setelah Anda mengonfirmasinya.";

/* Embedded SSH client, sandbox */
"Trust the new host key" = "Percayai host key baru";
"Use the system ssh command (outside the Mac App Store)" = "Pakai perintah ssh sistem (di luar Mac App Store)";
"Netdeck has its own SSH client. Turn this on for devices it can't talk to, such as older ones that only offer RSA host keys or older ciphers. Applies to the next connection." = "Netdeck punya klien SSH sendiri. Aktifkan ini untuk perangkat yang tidak bisa diajak bicara, seperti perangkat lama yang hanya menawarkan host key RSA atau cipher lama. Berlaku untuk koneksi berikutnya.";
"The SSH connection was closed by the device." = "Koneksi SSH ditutup oleh perangkat.";
"Connection timed out during the SSH handshake with %@." = "Koneksi habis waktu saat handshake SSH dengan %@.";
"The device refused the SSH shell: %@" = "Perangkat menolak shell SSH: %@";
"The device refused to start an SSH shell." = "Perangkat menolak memulai shell SSH.";
"The device's SSH algorithms aren't supported by the built-in SSH client: %@" = "Algoritma SSH perangkat tidak didukung oleh klien SSH bawaan: %@";
