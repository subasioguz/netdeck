<?xml version="1.0"?>
<pfsense>
	<version>23.9</version>
	<lastchange></lastchange>
	<system>
		<optimization>normal</optimization>
		<hostname>fw-edge</hostname>
		<domain>home.arpa</domain>
		<timezone>Europe/Istanbul</timezone>
	</system>
	<interfaces>
		<wan>
			<enable></enable>
			<if>igb0</if>
			<descr><![CDATA[WAN]]></descr>
			<ipaddr>dhcp</ipaddr>
			<blockpriv></blockpriv>
			<blockbogons></blockbogons>
		</wan>
		<lan>
			<enable></enable>
			<if>igb1</if>
			<descr><![CDATA[LAN]]></descr>
			<ipaddr>192.0.2.1</ipaddr>
			<subnet>26</subnet>
		</lan>
		<opt1>
			<enable></enable>
			<if>igb1.20</if>
			<descr><![CDATA[SERVERS]]></descr>
			<ipaddr>192.0.2.65</ipaddr>
			<subnet>26</subnet>
		</opt1>
		<opt2>
			<enable></enable>
			<if>lagg0</if>
			<descr><![CDATA[STORAGE]]></descr>
			<ipaddr>192.0.2.129</ipaddr>
			<subnet>26</subnet>
		</opt2>
		<opt3>
			<if>igb2</if>
			<descr><![CDATA[DMZ]]></descr>
			<ipaddr>203.0.113.1</ipaddr>
			<subnet>28</subnet>
		</opt3>
	</interfaces>
	<vlans>
		<vlan>
			<if>igb1</if>
			<tag>20</tag>
			<pcp></pcp>
			<descr><![CDATA[servers]]></descr>
			<vlanif>igb1.20</vlanif>
		</vlan>
	</vlans>
	<laggs>
		<lagg>
			<members>ix0,ix1</members>
			<descr><![CDATA[storage uplink]]></descr>
			<laggif>lagg0</laggif>
			<proto>lacp</proto>
		</lagg>
	</laggs>
	<filter>
		<rule>
			<type>pass</type>
			<interface>lan</interface>
			<descr><![CDATA[Default allow LAN to any rule, see </pfsense> & NETDECK> in text]]></descr>
		</rule>
	</filter>
</pfsense>
