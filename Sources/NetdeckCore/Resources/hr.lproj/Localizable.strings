/* EdgeOS */
"%@ is not a VLAN-aware switch0 port. On EdgeOS, VLANs work only on switch0 ports with vlan-aware enabled." = "%@ nije port switch0 s podrškom za VLAN (vlan-aware). Na EdgeOS-u VLAN-ovi rade samo na switch0 portovima s uključenim vlan-aware.";
"Another change on the router is already waiting for confirmation. Confirm it or let its timer run out first." = "Druga promjena na routeru već čeka potvrdu. Prvo je potvrdite ili pustite da joj istekne mjerač vremena.";
"EdgeOS can't change a VLAN's number. Delete the VLAN and add it again with the new number." = "EdgeOS ne može promijeniti broj VLAN-a. Obrišite VLAN i dodajte ga ponovno s novim brojem.";
"Netdeck could not check whether the running configuration is saved. Changes that were never saved are lost if the router restarts with its saved configuration." = "Netdeck nije mogao provjeriti je li pokrenuta konfiguracija spremljena. Promjene koje nikad nisu spremljene gube se ako se router ponovno pokrene sa spremljenom konfiguracijom.";
"Netdeck stopped the confirm timer and loaded the saved configuration again." = "Netdeck je zaustavio odbrojavanje potvrde i ponovno učitao spremljenu konfiguraciju.";
"On EdgeOS a VLAN has only a name (the description of its switch0 vif). Rename the VLAN instead." = "Na EdgeOS-u VLAN ima samo naziv (opis njegovog switch0 vif-a). Umjesto toga preimenujte VLAN.";
"The confirm timer is still running: the router restarts with its saved configuration when it runs out." = "Odbrojavanje potvrde još traje: kad istekne, router se ponovno pokreće sa spremljenom konfiguracijom.";
"The router keeps no commit revisions, so EdgeOS can't arm its confirm timer. Turn on commit revisions (system config-management commit-revisions) first." = "Router ne čuva revizije commitova, pa EdgeOS ne može postaviti odbrojavanje potvrde. Prvo uključite revizije commitova (system config-management commit-revisions).";
"The router rejected some commands:" = "Router je odbio neke naredbe:";
"The running configuration has changes that were never saved. If you don't confirm in time, the router restarts with its saved configuration and those changes are lost as well." = "Pokrenuta konfiguracija ima promjene koje nikad nisu spremljene. Ako ne potvrdite na vrijeme, router se ponovno pokreće sa spremljenom konfiguracijom i te se promjene također gube.";
"This EdgeOS version has no commit-confirm, so Netdeck can't apply changes with a safety timer." = "Ova verzija EdgeOS-a nema commit-confirm, pa Netdeck ne može primjenjivati promjene sa sigurnosnim mjeračem vremena.";
"VLAN 1 is the default VLAN; EdgeOS keeps the name 'default' for it." = "VLAN 1 je zadani VLAN; EdgeOS za njega zadržava naziv „default”.";
"VLANs on EdgeOS need the switch0 interface with vlan-aware enabled. Set that up on the router first." = "VLAN-ovi na EdgeOS-u trebaju switch0 sučelje s uključenim vlan-aware. Prvo to postavite na routeru.";

/* Cisco IOS */
"This switch's IOS can't undo changes on its own (no revert timer). Netdeck doesn't apply changes without it." = "IOS ovog switcha ne može sam poništiti promjene (nema revert timera). Netdeck bez toga ne primjenjuje promjene.";
"Netdeck needs privileged mode on this switch. Log in with a privilege 15 user or give the enable password." = "Netdeck treba privilegirani način rada na ovom switchu. Prijavite se korisnikom s razinom privilegija 15 ili unesite enable lozinku.";
"Netdeck couldn't set up the configuration archive the revert timer needs:" = "Netdeck nije mogao postaviti arhivu konfiguracije koju treba revert timer:";
"IOS has no candidate configuration to check in advance. The switch checks each command as it is applied; if one is rejected, or if you don't confirm in time, the revert timer puts the previous configuration back." = "IOS nema kandidat konfiguraciju za unaprijed provjeru. Switch provjerava svaku naredbu dok se primjenjuje; ako je jedna odbijena ili ne potvrdite na vrijeme, revert timer vraća prethodnu konfiguraciju.";
"The configuration archive the revert timer needs is not set up yet. Netdeck turns it on first (archive path flash:netdeck), outside the timer; this doesn't affect traffic." = "Arhiva konfiguracije koju treba revert timer još nije postavljena. Netdeck je prvo uključuje (archive path flash:netdeck), izvan mjerača vremena; to ne utječe na promet.";
"The switch shut this port down after an error (err-disabled)." = "Switch je isključio ovaj port zbog pogreške (err-disabled).";
"%@: IOS doesn't accept '?' in a description." = "%@: IOS ne prihvaća „?” u opisu.";
"%@ is a routed port (no switchport). Netdeck doesn't change VLANs on routed ports." = "%@ je usmjereni port (no switchport). Netdeck ne mijenja VLAN-ove na usmjerenim portovima.";
"%@ belongs to Port-channel%@; its VLANs follow the port-channel. Netdeck doesn't change them." = "%@ pripada grupi Port-channel%@; njegovi VLAN-ovi prate port-channel. Netdeck ih ne mijenja.";
"VLANs 1002–1005 are reserved on Cisco switches." = "VLAN-ovi 1002–1005 rezervirani su na Cisco switchevima.";
"'%@': IOS VLAN names can't contain spaces or '?' and are at most 32 characters." = "„%@”: nazivi VLAN-ova u IOS-u ne smiju sadržavati razmake ni „?” i imaju najviše 32 znaka.";
"IOS VLANs have no description. Leave it empty." = "IOS VLAN-ovi nemaju opis. Ostavite prazno.";
"IOS can't change a VLAN's number. Add a VLAN with the new number and move the ports to it." = "IOS ne može promijeniti broj VLAN-a. Dodajte VLAN s novim brojem i premjestite portove na njega.";
"The default VLAN (1) can't be renamed or deleted." = "Zadani VLAN (1) ne može se preimenovati ni obrisati.";

/* API module (iDRAC, Synology DSM, TrueNAS) */
"'%@' is not a valid address." = "„%@” nije valjana adresa.";
"Netdeck only connects over HTTPS. Use an https:// address." = "Netdeck se spaja samo preko HTTPS-a. Koristite adresu https://.";
"Netdeck can't reach the device over HTTPS (%@)." = "Netdeck ne može doći do uređaja preko HTTPS-a (%@).";
"A secure connection to the device could not be set up (%@)." = "Sigurna veza s uređajem nije se mogla uspostaviti (%@).";
"The security certificate of %@ has changed since Netdeck last connected. If the device was reset or got a new certificate, trust the new one. Otherwise someone may be intercepting the connection." = "Sigurnosni certifikat uređaja %@ promijenio se od zadnjeg spajanja Netdecka. Ako je uređaj resetiran ili je dobio novi certifikat, vjerujte novom. Inače bi netko mogao presretati vezu.";
"This account uses 2-step verification. Use an account without it for Netdeck." = "Ovaj račun koristi dvostupanjsku provjeru. Za Netdeck koristite račun bez nje.";
"The device wants this account's password changed. Change it on the device's web page, then try again." = "Uređaj traži promjenu lozinke ovog računa. Promijenite je na web stranici uređaja, pa pokušajte ponovno.";
"The device blocked this Mac's address after too many failed logins. Unblock it on the device or wait, then try again." = "Uređaj je blokirao adresu ovog Maca nakon previše neuspjelih prijava. Deblokirajte je na uređaju ili pričekajte, pa pokušajte ponovno.";
"The device doesn't offer this information." = "Uređaj ne nudi ovu informaciju.";
"The device sent an answer Netdeck doesn't understand (%@)." = "Uređaj je poslao odgovor koji Netdeck ne razumije (%@).";
"The device answered with HTTP error %@." = "Uređaj je odgovorio HTTP pogreškom %@.";
