/* HTTPS error cards */
"%@ presented a different security certificate than last time. That happens after a reset or a certificate renewal, but it can also mean someone is in between. Trust the new certificate only if you know why it changed." = "%@ præsenterede et andet sikkerhedscertifikat end sidste gang. Det sker efter en nulstilling eller en certifikatfornyelse, men det kan også betyde, at nogen sidder imellem. Stol kun på det nye certifikat, hvis du ved, hvorfor det er ændret.";
"Certificate changed" = "Certifikat ændret";
"HTTPS: the address can't be reached" = "HTTPS: adressen kan ikke nås";
"HTTPS: the certificate changed" = "HTTPS: certifikatet er ændret";
"Netdeck couldn't reach %@. Check that the device is on, the address and port are right (Synology uses 5001) and this Mac is on the same network." = "Netdeck kunne ikke nå %@. Kontrollér, at enheden er tændt, at adressen og porten er korrekte (Synology bruger 5001), og at denne Mac er på samme netværk.";
"Trust the new certificate" = "Stol på det nye certifikat";

/* MikroTik RouterOS */
"%@: VLANs on RouterOS need bridge VLAN filtering. Add the port to the bridge and turn on vlan-filtering first." = "%@: VLAN på RouterOS kræver bridge VLAN-filtrering. Føj først porten til bridgen, og slå vlan-filtering til.";
"VLANs on RouterOS need bridge VLAN filtering. Turn on vlan-filtering on the bridge first." = "VLAN på RouterOS kræver bridge VLAN-filtrering. Slå først vlan-filtering til på bridgen.";
"VLANs %@ share one bridge VLAN entry on the router. Split it into one entry per VLAN first." = "VLAN %@ deler én bridge VLAN-post på routeren. Opdel den først i én post pr. VLAN.";
"%@: choose a VLAN for this port." = "%@: vælg et VLAN til denne port.";
"RouterOS bridge VLANs have no names of their own. Netdeck shows the name of the VLAN's interface, or vlan and its number." = "RouterOS bridge-VLAN har ikke egne navne. Netdeck viser navnet på VLAN'ets grænseflade eller vlan og dets nummer.";
"VLAN '%@' has the VLAN interface '%@' on the router. Remove that interface first." = "VLAN '%@' har VLAN-grænsefladen '%@' på routeren. Fjern først den grænseflade.";
"The router asks for a new password. Log in once with WinBox, WebFig or a terminal, set a password, then connect again." = "Routeren beder om en ny adgangskode. Log ind én gang med WinBox, WebFig eller en terminal, angiv en adgangskode, og opret derefter forbindelse igen.";
"RouterOS has no candidate configuration to check in advance. Netdeck sends the commands one by one and undoes all of them if the router rejects one." = "RouterOS har ingen kandidatkonfiguration, der kan kontrolleres på forhånd. Netdeck sender kommandoerne én ad gangen og fortryder dem alle, hvis routeren afviser en.";
"The router did not confirm the command." = "Routeren bekræftede ikke kommandoen.";
"The undo timer is still on the router. Confirm again." = "Fortryd-timeren ligger stadig på routeren. Bekræft igen.";
"This change is too large for the router's undo script. Apply it in smaller parts." = "Denne ændring er for stor til routerens fortryd-script. Anvend den i mindre dele.";
"Netdeck could not read the router's clock, so it can't set the undo timer. Nothing was changed." = "Netdeck kunne ikke læse routerens ur, så den kan ikke opsætte fortryd-timeren. Intet blev ændret.";
"The undo script on the router is incomplete." = "Fortryd-scriptet på routeren er ufuldstændigt.";
"The undo timer did not start on the router." = "Fortryd-timeren startede ikke på routeren.";
"Netdeck could not set the undo timer on the router, so nothing was changed." = "Netdeck kunne ikke opsætte fortryd-timeren på routeren, så intet blev ændret.";
"The undo script did not finish on the router." = "Fortryd-scriptet blev ikke færdigt på routeren.";
"Undo runs at %@ (router time)" = "Fortryd kører kl. %@ (routertid)";
"Another session applied these changes and they still wait for confirmation. Discarding runs their undo script now, so the router goes back to the settings from before them. This can't be undone." = "En anden session anvendte disse ændringer, og de venter stadig på bekræftelse. Kassering kører deres fortryd-script nu, så routeren går tilbage til indstillingerne fra før dem. Dette kan ikke fortrydes.";

/* Server power commands (Redfish) */
"Sending the power command" = "Sender strømkommandoen";
"Power" = "Strøm";
"Turn on" = "Tænd";
"Shut down" = "Luk ned";
"Restart" = "Genstart";
"Force restart" = "Gennemtving genstart";
"Force off" = "Gennemtving slukning";
"Power cycle" = "Strømcyklus";
"Turn on %@?" = "Tænde %@?";
"Shut down %@?" = "Lukke %@ ned?";
"Restart %@?" = "Genstarte %@?";
"Force restart %@?" = "Gennemtvinge genstart af %@?";
"Force off %@?" = "Gennemtvinge slukning af %@?";
"Power cycle %@?" = "Strømcykle %@?";
"The server powers on and starts its operating system." = "Serveren tændes og starter sit operativsystem.";
"The operating system is asked to shut down. Everything running on the server stops." = "Operativsystemet bliver bedt om at lukke ned. Alt, der kører på serveren, stopper.";
"The operating system is asked to restart. Everything running on the server stops until it is back." = "Operativsystemet bliver bedt om at genstarte. Alt, der kører på serveren, stopper, indtil den er tilbage.";
"The server restarts at once, without shutting down the operating system. Unsaved data is lost." = "Serveren genstarter med det samme uden at lukke operativsystemet ned. Data, der ikke er gemt, går tabt.";
"The server turns off at once, like pulling the power cord. Unsaved data is lost." = "Serveren slukker med det samme, som hvis du trak strømkablet ud. Data, der ikke er gemt, går tabt.";
"The server turns off at once and back on, like pulling the power cord and plugging it in again. Unsaved data is lost." = "Serveren slukker og tænder igen med det samme, som hvis du trak strømkablet ud og satte det i igen. Data, der ikke er gemt, går tabt.";
"The server accepted the power command. Its power state can take a minute to change; read again to see it." = "Serveren accepterede strømkommandoen. Det kan tage et minut, før dens strømtilstand ændres; læs igen for at se den.";
"Netdeck reads this device over its API and never changes its settings. Power commands go out only after you confirm them." = "Netdeck læser denne enhed via dens API og ændrer aldrig dens indstillinger. Strømkommandoer sendes først, når du har bekræftet dem.";

/* Embedded SSH client, sandbox */
"Trust the new host key" = "Stol på den nye værtsnøgle";
"Use the system ssh command (outside the Mac App Store)" = "Brug systemets ssh-kommando (uden for Mac App Store)";
"Netdeck has its own SSH client. Turn this on for devices it can't talk to, such as older ones that only offer RSA host keys or older ciphers. Applies to the next connection." = "Netdeck har sin egen SSH-klient. Slå dette til for enheder, den ikke kan tale med, f.eks. ældre enheder, der kun tilbyder RSA-værtsnøgler eller ældre chifre. Gælder ved næste forbindelse.";
"The SSH connection was closed by the device." = "SSH-forbindelsen blev lukket af enheden.";
"Connection timed out during the SSH handshake with %@." = "Forbindelsen fik timeout under SSH-håndtrykket med %@.";
"The device refused the SSH shell: %@" = "Enheden afviste SSH-shellen: %@";
"The device refused to start an SSH shell." = "Enheden afviste at starte en SSH-shell.";
"The device's SSH algorithms aren't supported by the built-in SSH client: %@" = "Enhedens SSH-algoritmer understøttes ikke af den indbyggede SSH-klient: %@";
"SSH algorithms: %@" = "SSH-algoritmer: %@";
"SSH, older algorithms" = "SSH, ældre algoritmer";
"%@ belongs to %@; its VLANs follow the LAG. Netdeck doesn't change them." = "%@ tilhører %@; dens VLAN følger LAG'en. Netdeck ændrer dem ikke.";
"%@ is a routed port. Netdeck doesn't change VLANs on routed ports." = "%@ er en routet port. Netdeck ændrer ikke VLAN på routede porte.";
"%@: '?' can't be typed in a description on this switch." = "%@: '?' kan ikke skrives i en beskrivelse på denne switch.";
"%@: a trunk port must carry at least one VLAN. With none, AOS-CX carries them all." = "%@: en trunk-port skal bære mindst ét VLAN. Uden nogen bærer AOS-CX dem alle.";
"'%@': AOS-CX VLAN names are 1–32 characters: letters, digits, '_' and '-'." = "'%@': VLAN-navne i AOS-CX er 1–32 tegn: bogstaver, cifre, '_' og '-'.";
"AOS-CX %@ may not restore the configuration if the session drops before you confirm (fixed in 10.06). Update the switch to make changes with Netdeck." = "AOS-CX %@ gendanner måske ikke konfigurationen, hvis sessionen afbrydes, før du bekræfter (rettet i 10.06). Opdater switchen for at foretage ændringer med Netdeck.";
"AOS-CX commands" = "AOS-CX-kommandoer";
"Another change is already waiting for confirmation on this switch (an auto checkpoint is running). Netdeck doesn't apply changes until it ends." = "En anden ændring venter allerede på bekræftelse på denne switch (et auto checkpoint kører). Netdeck anvender ikke ændringer, før det slutter.";
"If you don't confirm, the switch restores the configuration it had before the change." = "Hvis du ikke bekræfter, gendanner switchen den konfiguration, den havde før ændringen.";
"Netdeck couldn't save the configuration before the change:" = "Netdeck kunne ikke gemme konfigurationen fra før ændringen:";
"Netdeck needs administrator rights on this switch. Log in as an administrator or manager user." = "Netdeck skal have administratorrettigheder på denne switch. Log ind som en administrator- eller manager-bruger.";
"The switch can't change a VLAN's number. Add a VLAN with the new number and move the ports to it." = "Switchen kan ikke ændre et VLAN's nummer. Tilføj et VLAN med det nye nummer, og flyt portene til det.";
"The switch has no candidate configuration to check in advance. It applies each command at once; if one is rejected, or if you don't confirm in time, it restores the configuration it had before the change." = "Switchen har ingen kandidatkonfiguration, der kan kontrolleres på forhånd. Den anvender hver kommando med det samme; hvis en bliver afvist, eller hvis du ikke bekræfter i tide, gendanner den konfigurationen fra før ændringen.";
"This switch can't undo changes on its own (no auto checkpoint). Netdeck doesn't apply changes without it." = "Denne switch kan ikke fortryde ændringer af sig selv (intet auto checkpoint). Netdeck anvender ikke ændringer uden det.";
"%@: a description can't contain '\"'." = "%@: en beskrivelse kan ikke indeholde '\"'.";
"%@: the port must stay a member of at least one VLAN." = "%@: porten skal fortsat være medlem af mindst ét VLAN.";
"'%@': VLAN names on this switch are 1–32 characters and can't contain '\"'." = "'%@': VLAN-navne på denne switch er 1–32 tegn og kan ikke indeholde '\"'.";
"AOS-S commands" = "AOS-S-kommandoer";
"Another change is already waiting for confirmation on this switch (Netdeck's restore job is scheduled). Netdeck doesn't apply changes until it ends." = "En anden ændring venter allerede på bekræftelse på denne switch (Netdecks gendannelsesjob er planlagt). Netdeck anvender ikke ændringer, før det slutter.";
"Netdeck couldn't set up the job that restores the configuration:" = "Netdeck kunne ikke oprette jobbet, der gendanner konfigurationen:";
"This switch's VLANs have no description. Leave it empty." = "VLAN på denne switch har ingen beskrivelse. Lad den være tom.";
"This switch's firmware (%@) can't restore a configuration without restarting; that needs 16.05 or later. Netdeck reads it but doesn't change it." = "Firmwaren på denne switch (%@) kan ikke gendanne en konfiguration uden genstart; det kræver 16.05 eller nyere. Netdeck læser den, men ændrer den ikke.";
"TP-Link commands" = "TP-Link-kommandoer";
"If you don't confirm, the switch restarts with its saved configuration. It is offline for a few minutes." = "Hvis du ikke bekræfter, genstarter switchen med sin gemte konfiguration. Den er offline i nogle minutter.";
"The switch has no candidate configuration to check in advance. It applies each command at once and saves nothing until you confirm. If a command is rejected, Netdeck puts the previous settings back; if you don't confirm in time, the switch restarts with its saved configuration." = "Switchen har ingen kandidatkonfiguration, der kan tjekkes på forhånd. Den udfører hver kommando med det samme og gemmer intet, før du bekræfter. Hvis en kommando afvises, sætter Netdeck de tidligere indstillinger tilbage; hvis du ikke bekræfter i tide, genstarter switchen med sin gemte konfiguration.";
"This switch has changes that aren't saved yet. Netdeck's safety net restarts the switch with its saved configuration, which would lose them too. Save or undo them on the switch first." = "Denne switch har ændringer, der ikke er gemt endnu. Netdecks sikkerhedsnet genstarter switchen med den gemte konfiguration, så de ville også gå tabt. Gem eller fortryd dem på switchen først.";
"An Omada controller manages this switch, and it only takes show commands. Netdeck reads it but doesn't change it; make changes in the controller." = "En Omada-controller styrer denne switch, og den tager kun imod show-kommandoer. Netdeck læser den, men ændrer den ikke; foretag ændringer i controlleren.";
"Netdeck couldn't schedule the restart that undoes the change:" = "Netdeck kunne ikke planlægge den genstart, der fortryder ændringen:";
"Netdeck couldn't put every setting back by itself. The switch restarts with its saved configuration within a minute and is offline for a few minutes." = "Netdeck kunne ikke selv sætte alle indstillinger tilbage. Switchen genstarter med sin gemte konfiguration inden for et minut og er offline i nogle minutter.";
"%@: port descriptions on this switch are at most 16 characters, without quotes, brackets or < > , \\ &." = "%@: portbeskrivelser på denne switch er højst 16 tegn, uden anførselstegn, parenteser eller < > , \\ &.";
"%@ has a VLAN setup Netdeck can't show as access or trunk (%@). Change it on the switch." = "%@ har en VLAN-opsætning, som Netdeck ikke kan vise som access eller trunk (%@). Ændr den på switchen.";
"'%@': VLAN names on this switch are 1–16 characters and can't contain \" < > , \\ or &." = "'%@': VLAN-navne på denne switch er 1–16 tegn og må ikke indeholde \" < > , \\ eller &.";
