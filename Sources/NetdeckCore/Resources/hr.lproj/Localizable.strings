/* HTTPS error cards */
"%@ presented a different security certificate than last time. That happens after a reset or a certificate renewal, but it can also mean someone is in between. Trust the new certificate only if you know why it changed." = "%@ je predočio drugi sigurnosni certifikat nego prošli put. To se događa nakon resetiranja ili obnove certifikata, ali može značiti i da je netko u sredini. Vjerujte novom certifikatu samo ako znate zašto se promijenio.";
"Certificate changed" = "Certifikat promijenjen";
"HTTPS: the address can't be reached" = "HTTPS: adresa nije dostupna";
"HTTPS: the certificate changed" = "HTTPS: certifikat se promijenio";
"Netdeck couldn't reach %@. Check that the device is on, the address and port are right (Synology uses 5001) and this Mac is on the same network." = "Netdeck nije mogao doći do %@. Provjerite je li uređaj uključen, jesu li adresa i port točni (Synology koristi 5001) i je li ovaj Mac na istoj mreži.";
"Trust the new certificate" = "Vjeruj novom certifikatu";

/* MikroTik RouterOS */
"%@: VLANs on RouterOS need bridge VLAN filtering. Add the port to the bridge and turn on vlan-filtering first." = "%@: VLAN-ovi na RouterOS-u trebaju bridge VLAN filtriranje. Prvo dodajte port u bridge i uključite vlan-filtering.";
"VLANs on RouterOS need bridge VLAN filtering. Turn on vlan-filtering on the bridge first." = "VLAN-ovi na RouterOS-u trebaju bridge VLAN filtriranje. Prvo uključite vlan-filtering na bridgeu.";
"VLANs %@ share one bridge VLAN entry on the router. Split it into one entry per VLAN first." = "VLAN-ovi %@ dijele jedan bridge VLAN zapis na routeru. Prvo ga podijelite na jedan zapis po VLAN-u.";
"%@: choose a VLAN for this port." = "%@: odaberite VLAN za ovaj port.";
"RouterOS bridge VLANs have no names of their own. Netdeck shows the name of the VLAN's interface, or vlan and its number." = "RouterOS bridge VLAN-ovi nemaju vlastite nazive. Netdeck prikazuje naziv sučelja VLAN-a ili vlan i njegov broj.";
"VLAN '%@' has the VLAN interface '%@' on the router. Remove that interface first." = "VLAN „%@” ima VLAN sučelje „%@” na routeru. Prvo uklonite to sučelje.";
"The router asks for a new password. Log in once with WinBox, WebFig or a terminal, set a password, then connect again." = "Router traži novu lozinku. Jednom se prijavite pomoću WinBoxa, WebFiga ili terminala, postavite lozinku, pa se ponovno spojite.";
"RouterOS has no candidate configuration to check in advance. Netdeck sends the commands one by one and undoes all of them if the router rejects one." = "RouterOS nema kandidat konfiguraciju za unaprijed provjeru. Netdeck šalje naredbe jednu po jednu i poništava sve ako router odbije neku.";
"The router did not confirm the command." = "Router nije potvrdio naredbu.";
"The undo timer is still on the router. Confirm again." = "Mjerač vremena za poništenje još je na routeru. Potvrdite ponovno.";
"This change is too large for the router's undo script. Apply it in smaller parts." = "Ova je promjena prevelika za skriptu poništenja na routeru. Primijenite je u manjim dijelovima.";
"Netdeck could not read the router's clock, so it can't set the undo timer. Nothing was changed." = "Netdeck nije mogao pročitati sat routera pa ne može postaviti mjerač vremena za poništenje. Ništa nije promijenjeno.";
"The undo script on the router is incomplete." = "Skripta poništenja na routeru nije potpuna.";
"The undo timer did not start on the router." = "Mjerač vremena za poništenje nije se pokrenuo na routeru.";
"Netdeck could not set the undo timer on the router, so nothing was changed." = "Netdeck nije mogao postaviti mjerač vremena za poništenje na routeru pa ništa nije promijenjeno.";
"The undo script did not finish on the router." = "Skripta poništenja nije završila na routeru.";
"Undo runs at %@ (router time)" = "Poništenje se izvodi u %@ (vrijeme routera)";
"Another session applied these changes and they still wait for confirmation. Discarding runs their undo script now, so the router goes back to the settings from before them. This can't be undone." = "Ove promjene primijenila je druga sesija i još čekaju potvrdu. Odbacivanje sada izvodi njihovu skriptu poništenja, pa se router vraća na postavke prije njih. Ovo se ne može poništiti.";

/* Server power commands (Redfish) */
"Sending the power command" = "Slanje naredbe za napajanje";
"Power" = "Napajanje";
"Turn on" = "Uključi";
"Shut down" = "Isključi";
"Restart" = "Ponovno pokreni";
"Force restart" = "Prisilno ponovno pokreni";
"Force off" = "Prisilno isključi";
"Power cycle" = "Isključi i uključi napajanje";
"Turn on %@?" = "Uključiti %@?";
"Shut down %@?" = "Isključiti %@?";
"Restart %@?" = "Ponovno pokrenuti %@?";
"Force restart %@?" = "Prisilno ponovno pokrenuti %@?";
"Force off %@?" = "Prisilno isključiti %@?";
"Power cycle %@?" = "Isključiti i uključiti napajanje za %@?";
"The server powers on and starts its operating system." = "Poslužitelj se uključuje i pokreće operacijski sustav.";
"The operating system is asked to shut down. Everything running on the server stops." = "Od operacijskog sustava traži se isključivanje. Sve što radi na poslužitelju prestaje.";
"The operating system is asked to restart. Everything running on the server stops until it is back." = "Od operacijskog sustava traži se ponovno pokretanje. Sve što radi na poslužitelju prestaje dok se ne vrati.";
"The server restarts at once, without shutting down the operating system. Unsaved data is lost." = "Poslužitelj se odmah ponovno pokreće, bez isključivanja operacijskog sustava. Nespremljeni podaci se gube.";
"The server turns off at once, like pulling the power cord. Unsaved data is lost." = "Poslužitelj se odmah isključuje, kao da izvučete kabel napajanja. Nespremljeni podaci se gube.";
"The server turns off at once and back on, like pulling the power cord and plugging it in again. Unsaved data is lost." = "Poslužitelj se odmah isključuje i ponovno uključuje, kao da izvučete kabel napajanja i vratite ga. Nespremljeni podaci se gube.";
"The server accepted the power command. Its power state can take a minute to change; read again to see it." = "Poslužitelj je prihvatio naredbu za napajanje. Promjena stanja napajanja može potrajati minutu; pročitajte ponovno da je vidite.";
"Netdeck reads this device over its API and never changes its settings. Power commands go out only after you confirm them." = "Netdeck ovaj uređaj čita preko API-ja i nikad ne mijenja njegove postavke. Naredbe za napajanje šalju se tek nakon vaše potvrde.";

/* Embedded SSH client, sandbox */
"Trust the new host key" = "Vjeruj novom ključu hosta";
"Use the system ssh command (outside the Mac App Store)" = "Koristi sistemsku naredbu ssh (izvan Mac App Storea)";
"Netdeck has its own SSH client. Turn this on for devices it can't talk to, such as older ones that only offer RSA host keys or older ciphers. Applies to the next connection." = "Netdeck ima vlastiti SSH klijent. Uključite ovo za uređaje s kojima ne može komunicirati, npr. starije koji nude samo RSA ključeve hosta ili starije šifre. Primjenjuje se pri sljedećem spajanju.";
"The SSH connection was closed by the device." = "Uređaj je zatvorio SSH vezu.";
"Connection timed out during the SSH handshake with %@." = "Veza je istekla tijekom SSH handshakea s %@.";
"The device refused the SSH shell: %@" = "Uređaj je odbio SSH ljusku: %@";
"The device refused to start an SSH shell." = "Uređaj je odbio pokrenuti SSH ljusku.";
"The device's SSH algorithms aren't supported by the built-in SSH client: %@" = "Ugrađeni SSH klijent ne podržava SSH algoritme uređaja: %@";
"SSH algorithms: %@" = "SSH algoritmi: %@";
"SSH, older algorithms" = "SSH, stariji algoritmi";
