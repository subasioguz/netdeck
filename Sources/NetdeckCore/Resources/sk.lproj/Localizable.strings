/* EdgeOS */
"%@ is not a VLAN-aware switch0 port. On EdgeOS, VLANs work only on switch0 ports with vlan-aware enabled." = "%@ nie je port switch0 s podporou VLAN (vlan-aware). Na EdgeOS fungujú VLAN iba na portoch switch0 so zapnutým vlan-aware.";
"Another change on the router is already waiting for confirmation. Confirm it or let its timer run out first." = "Na routeri už čaká na potvrdenie iná zmena. Najprv ju potvrďte alebo nechajte vypršať jej časovač.";
"EdgeOS can't change a VLAN's number. Delete the VLAN and add it again with the new number." = "EdgeOS nevie zmeniť číslo VLAN. Odstráňte VLAN a pridajte ju znova s novým číslom.";
"Netdeck could not check whether the running configuration is saved. Changes that were never saved are lost if the router restarts with its saved configuration." = "Netdeck nedokázal skontrolovať, či je bežiaca konfigurácia uložená. Zmeny, ktoré sa nikdy neuložili, sa stratia, ak sa router reštartuje s uloženou konfiguráciou.";
"Netdeck stopped the confirm timer and loaded the saved configuration again." = "Netdeck zastavil časovač potvrdenia a znova načítal uloženú konfiguráciu.";
"On EdgeOS a VLAN has only a name (the description of its switch0 vif). Rename the VLAN instead." = "Na EdgeOS má VLAN iba názov (popis jej switch0 vif). Radšej VLAN premenujte.";
"The confirm timer is still running: the router restarts with its saved configuration when it runs out." = "Časovač potvrdenia stále beží: keď vyprší, router sa reštartuje s uloženou konfiguráciou.";
"The router keeps no commit revisions, so EdgeOS can't arm its confirm timer. Turn on commit revisions (system config-management commit-revisions) first." = "Router neuchováva revízie commitov, preto EdgeOS nevie spustiť časovač potvrdenia. Najprv zapnite revízie commitov (system config-management commit-revisions).";
"The router rejected some commands:" = "Router odmietol niektoré príkazy:";
"The running configuration has changes that were never saved. If you don't confirm in time, the router restarts with its saved configuration and those changes are lost as well." = "Bežiaca konfigurácia obsahuje zmeny, ktoré sa nikdy neuložili. Ak nepotvrdíte včas, router sa reštartuje s uloženou konfiguráciou a aj tieto zmeny sa stratia.";
"This EdgeOS version has no commit-confirm, so Netdeck can't apply changes with a safety timer." = "Táto verzia EdgeOS nemá commit-confirm, preto Netdeck nevie použiť zmeny s bezpečnostným časovačom.";
"VLAN 1 is the default VLAN; EdgeOS keeps the name 'default' for it." = "VLAN 1 je predvolená VLAN, EdgeOS pre ňu ponecháva názov 'default'.";
"VLANs on EdgeOS need the switch0 interface with vlan-aware enabled. Set that up on the router first." = "VLAN na EdgeOS vyžadujú rozhranie switch0 so zapnutým vlan-aware. Najprv to nastavte na routeri.";

/* Cisco IOS */
"This switch's IOS can't undo changes on its own (no revert timer). Netdeck doesn't apply changes without it." = "IOS na tomto switchi nevie vrátiť zmeny sám (chýba revert timer). Bez neho Netdeck zmeny nepoužije.";
"Netdeck needs privileged mode on this switch. Log in with a privilege 15 user or give the enable password." = "Netdeck potrebuje na tomto switchi privilegovaný režim. Prihláste sa ako používateľ s úrovňou oprávnenia 15 alebo zadajte heslo enable.";
"Netdeck couldn't set up the configuration archive the revert timer needs:" = "Netdeck nedokázal nastaviť archív konfigurácie, ktorý revert timer potrebuje:";
"IOS has no candidate configuration to check in advance. The switch checks each command as it is applied; if one is rejected, or if you don't confirm in time, the revert timer puts the previous configuration back." = "IOS nemá kandidátsku konfiguráciu, ktorú by bolo možné vopred skontrolovať. Switch kontroluje každý príkaz pri jeho použití. Ak sa niektorý odmietne alebo ak nepotvrdíte včas, revert timer obnoví predchádzajúcu konfiguráciu.";
"The configuration archive the revert timer needs is not set up yet. Netdeck turns it on first (archive path flash:netdeck), outside the timer; this doesn't affect traffic." = "Archív konfigurácie, ktorý revert timer potrebuje, ešte nie je nastavený. Netdeck ho najprv zapne (archive path flash:netdeck), mimo časovača. Prevádzku to neovplyvní.";
"The switch shut this port down after an error (err-disabled)." = "Switch tento port vypol po chybe (err-disabled).";
"%@: IOS doesn't accept '?' in a description." = "%@: IOS v popise neprijíma '?'.";
"%@ is a routed port (no switchport). Netdeck doesn't change VLANs on routed ports." = "%@ je smerovaný (routed) port (no switchport). Netdeck na takých portoch VLAN nemení.";
"%@ belongs to Port-channel%@; its VLANs follow the port-channel. Netdeck doesn't change them." = "%@ patrí do Port-channel%@, jeho VLAN sa riadia port-channelom. Netdeck ich nemení.";
"VLANs 1002–1005 are reserved on Cisco switches." = "VLAN 1002–1005 sú na switchoch Cisco vyhradené.";
"'%@': IOS VLAN names can't contain spaces or '?' and are at most 32 characters." = "'%@': názvy VLAN v IOS nemôžu obsahovať medzery ani '?' a môžu mať najviac 32 znakov.";
"IOS VLANs have no description. Leave it empty." = "VLAN v IOS nemajú popis. Nechajte ho prázdny.";
"IOS can't change a VLAN's number. Add a VLAN with the new number and move the ports to it." = "IOS nevie zmeniť číslo VLAN. Pridajte VLAN s novým číslom a presuňte do nej porty.";
"The default VLAN (1) can't be renamed or deleted." = "Predvolenú VLAN (1) nemožno premenovať ani odstrániť.";

/* API module (iDRAC, Synology DSM, TrueNAS) */
"'%@' is not a valid address." = "'%@' nie je platná adresa.";
"Netdeck only connects over HTTPS. Use an https:// address." = "Netdeck sa pripája iba cez HTTPS. Použite adresu začínajúcu https://.";
"Netdeck can't reach the device over HTTPS (%@)." = "Netdeck sa nedokáže spojiť so zariadením cez HTTPS (%@).";
"A secure connection to the device could not be set up (%@)." = "Zabezpečené pripojenie k zariadeniu sa nepodarilo nadviazať (%@).";
"The security certificate of %@ has changed since Netdeck last connected. If the device was reset or got a new certificate, trust the new one. Otherwise someone may be intercepting the connection." = "Bezpečnostný certifikát zariadenia %@ sa od posledného pripojenia Netdecku zmenil. Ak sa zariadenie resetovalo alebo dostalo nový certifikát, dôverujte novému. Inak môže niekto pripojenie odpočúvať.";
"This account uses 2-step verification. Use an account without it for Netdeck." = "Tento účet používa dvojstupňové overenie. Pre Netdeck použite účet bez neho.";
"The device wants this account's password changed. Change it on the device's web page, then try again." = "Zariadenie vyžaduje zmenu hesla tohto účtu. Zmeňte ho na webovej stránke zariadenia a skúste to znova.";
"The device blocked this Mac's address after too many failed logins. Unblock it on the device or wait, then try again." = "Zariadenie zablokovalo adresu tohto Macu po príliš mnohých neúspešných prihláseniach. Odblokujte ju na zariadení alebo počkajte a skúste to znova.";
"The device doesn't offer this information." = "Zariadenie túto informáciu neposkytuje.";
"The device sent an answer Netdeck doesn't understand (%@)." = "Zariadenie poslalo odpoveď, ktorej Netdeck nerozumie (%@).";
"The device answered with HTTP error %@." = "Zariadenie odpovedalo chybou HTTP %@.";
"not an HTTP answer" = "nie je odpoveď HTTP";
"no session token" = "chýba token relácie";
