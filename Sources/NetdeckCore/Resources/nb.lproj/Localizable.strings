/* EdgeOS */
"%@ is not a VLAN-aware switch0 port. On EdgeOS, VLANs work only on switch0 ports with vlan-aware enabled." = "%@ er ikke en VLAN-aware switch0-port. På EdgeOS fungerer VLAN bare på switch0-porter med vlan-aware slått på.";
"Another change on the router is already waiting for confirmation. Confirm it or let its timer run out first." = "En annen endring på ruteren venter allerede på bekreftelse. Bekreft den eller la tidtakeren gå ut først.";
"EdgeOS can't change a VLAN's number. Delete the VLAN and add it again with the new number." = "EdgeOS kan ikke endre nummeret på et VLAN. Slett VLAN-et og legg det til på nytt med det nye nummeret.";
"Netdeck could not check whether the running configuration is saved. Changes that were never saved are lost if the router restarts with its saved configuration." = "Netdeck kunne ikke sjekke om den kjørende konfigurasjonen er lagret. Endringer som aldri ble lagret, går tapt hvis ruteren starter på nytt med den lagrede konfigurasjonen.";
"Netdeck stopped the confirm timer and loaded the saved configuration again." = "Netdeck stoppet bekreftelsestidtakeren og lastet den lagrede konfigurasjonen på nytt.";
"On EdgeOS a VLAN has only a name (the description of its switch0 vif). Rename the VLAN instead." = "På EdgeOS har et VLAN bare et navn (beskrivelsen av switch0 vif). Gi VLAN-et nytt navn i stedet.";
"The confirm timer is still running: the router restarts with its saved configuration when it runs out." = "Bekreftelsestidtakeren går fortsatt: ruteren starter på nytt med den lagrede konfigurasjonen når den går ut.";
"The router keeps no commit revisions, so EdgeOS can't arm its confirm timer. Turn on commit revisions (system config-management commit-revisions) first." = "Ruteren har ingen commit-revisjoner, så EdgeOS kan ikke sette i gang bekreftelsestidtakeren. Slå på commit-revisjoner (system config-management commit-revisions) først.";
"The router rejected some commands:" = "Ruteren avviste noen kommandoer:";
"The running configuration has changes that were never saved. If you don't confirm in time, the router restarts with its saved configuration and those changes are lost as well." = "Den kjørende konfigurasjonen har endringer som aldri ble lagret. Hvis du ikke bekrefter i tide, starter ruteren på nytt med den lagrede konfigurasjonen, og disse endringene går også tapt.";
"This EdgeOS version has no commit-confirm, so Netdeck can't apply changes with a safety timer." = "Denne EdgeOS-versjonen har ikke commit-confirm, så Netdeck kan ikke bruke endringer med sikkerhetstidtaker.";
"VLAN 1 is the default VLAN; EdgeOS keeps the name 'default' for it." = "VLAN 1 er standard-VLAN-et. EdgeOS beholder navnet «default» for det.";
"VLANs on EdgeOS need the switch0 interface with vlan-aware enabled. Set that up on the router first." = "VLAN på EdgeOS krever switch0-grensesnittet med vlan-aware slått på. Sett opp det på ruteren først.";

/* Cisco IOS */
"This switch's IOS can't undo changes on its own (no revert timer). Netdeck doesn't apply changes without it." = "IOS på denne switchen kan ikke angre endringer av seg selv (ingen revert timer). Netdeck bruker ikke endringer uten den.";
"Netdeck needs privileged mode on this switch. Log in with a privilege 15 user or give the enable password." = "Netdeck trenger privilegert modus på denne switchen. Logg inn med en bruker med privilege 15 eller oppgi enable-passordet.";
"Netdeck couldn't set up the configuration archive the revert timer needs:" = "Netdeck kunne ikke sette opp konfigurasjonsarkivet som revert timer trenger:";
"IOS has no candidate configuration to check in advance. The switch checks each command as it is applied; if one is rejected, or if you don't confirm in time, the revert timer puts the previous configuration back." = "IOS har ingen kandidatkonfigurasjon som kan kontrolleres på forhånd. Switchen kontrollerer hver kommando når den brukes. Hvis en avvises, eller hvis du ikke bekrefter i tide, legger revert timer den forrige konfigurasjonen tilbake.";
"The configuration archive the revert timer needs is not set up yet. Netdeck turns it on first (archive path flash:netdeck), outside the timer; this doesn't affect traffic." = "Konfigurasjonsarkivet som revert timer trenger, er ikke satt opp ennå. Netdeck slår det på først (archive path flash:netdeck), utenfor tidtakeren. Dette påvirker ikke trafikken.";
"The switch shut this port down after an error (err-disabled)." = "Switchen slo av denne porten etter en feil (err-disabled).";
"%@: IOS doesn't accept '?' in a description." = "%@: IOS godtar ikke «?» i en beskrivelse.";
"%@ is a routed port (no switchport). Netdeck doesn't change VLANs on routed ports." = "%@ er en rutet port (no switchport). Netdeck endrer ikke VLAN på rutede porter.";
"%@ belongs to Port-channel%@; its VLANs follow the port-channel. Netdeck doesn't change them." = "%@ tilhører Port-channel%@. VLAN-ene følger port-channel. Netdeck endrer dem ikke.";
"VLANs 1002–1005 are reserved on Cisco switches." = "VLAN 1002–1005 er reservert på Cisco-switcher.";
"'%@': IOS VLAN names can't contain spaces or '?' and are at most 32 characters." = "«%@»: IOS-VLAN-navn kan ikke inneholde mellomrom eller «?» og er maks 32 tegn.";
"IOS VLANs have no description. Leave it empty." = "IOS-VLAN har ingen beskrivelse. La den stå tom.";
"IOS can't change a VLAN's number. Add a VLAN with the new number and move the ports to it." = "IOS kan ikke endre nummeret på et VLAN. Legg til et VLAN med det nye nummeret og flytt portene dit.";
"The default VLAN (1) can't be renamed or deleted." = "Standard-VLAN-et (1) kan ikke få nytt navn eller slettes.";

/* API module (iDRAC, Synology DSM, TrueNAS) */
"'%@' is not a valid address." = "«%@» er ikke en gyldig adresse.";
"Netdeck only connects over HTTPS. Use an https:// address." = "Netdeck kobler bare til over HTTPS. Bruk en https://-adresse.";
"Netdeck can't reach the device over HTTPS (%@)." = "Netdeck får ikke kontakt med enheten over HTTPS (%@).";
"A secure connection to the device could not be set up (%@)." = "Kunne ikke sette opp en sikker tilkobling til enheten (%@).";
"The security certificate of %@ has changed since Netdeck last connected. If the device was reset or got a new certificate, trust the new one. Otherwise someone may be intercepting the connection." = "Sikkerhetssertifikatet til %@ er endret siden Netdeck sist koblet til. Hvis enheten ble tilbakestilt eller fikk et nytt sertifikat, stol på det nye. Ellers kan noen avskjære tilkoblingen.";
"This account uses 2-step verification. Use an account without it for Netdeck." = "Denne kontoen bruker tostegsbekreftelse. Bruk en konto uten det for Netdeck.";
"The device wants this account's password changed. Change it on the device's web page, then try again." = "Enheten krever at passordet til denne kontoen endres. Endre det på enhetens nettside, og prøv igjen.";
"The device blocked this Mac's address after too many failed logins. Unblock it on the device or wait, then try again." = "Enheten blokkerte adressen til denne Macen etter for mange mislykkede innloggingsforsøk. Fjern blokkeringen på enheten eller vent, og prøv igjen.";
"The device doesn't offer this information." = "Enheten tilbyr ikke denne informasjonen.";
"The device sent an answer Netdeck doesn't understand (%@)." = "Enheten sendte et svar Netdeck ikke forstår (%@).";
"The device answered with HTTP error %@." = "Enheten svarte med HTTP-feil %@.";
"not an HTTP answer" = "ikke et HTTP-svar";
"no session token" = "ingen øktnøkkel";
"login error %@" = "innloggingsfeil %@";
"login failed" = "innlogging mislyktes";
"no answer" = "ingen svar";
"The device stopped answering." = "Enheten sluttet å svare.";
"Reading system info" = "Leser systeminfo";
