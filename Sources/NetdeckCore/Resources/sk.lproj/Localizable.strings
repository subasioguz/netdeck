/* HTTPS error cards */
"%@ presented a different security certificate than last time. That happens after a reset or a certificate renewal, but it can also mean someone is in between. Trust the new certificate only if you know why it changed." = "%@ predložil iný bezpečnostný certifikát ako naposledy. To sa stane po resete alebo obnovení certifikátu, ale môže to znamenať aj to, že sa medzi vás niekto vložil. Novému certifikátu dôverujte, iba ak viete, prečo sa zmenil.";
"Certificate changed" = "Certifikát sa zmenil";
"HTTPS: the address can't be reached" = "HTTPS: adresa je nedostupná";
"HTTPS: the certificate changed" = "HTTPS: certifikát sa zmenil";
"Netdeck couldn't reach %@. Check that the device is on, the address and port are right (Synology uses 5001) and this Mac is on the same network." = "Netdeck sa nedokázal spojiť s %@. Skontrolujte, či je zariadenie zapnuté, adresa a port správne (Synology používa 5001) a tento Mac v rovnakej sieti.";
"Trust the new certificate" = "Dôverovať novému certifikátu";

/* MikroTik RouterOS */
"%@: VLANs on RouterOS need bridge VLAN filtering. Add the port to the bridge and turn on vlan-filtering first." = "%@: VLAN na RouterOS vyžadujú filtrovanie VLAN na bridgi. Najprv pridajte port do bridgu a zapnite vlan-filtering.";
"VLANs on RouterOS need bridge VLAN filtering. Turn on vlan-filtering on the bridge first." = "VLAN na RouterOS vyžadujú filtrovanie VLAN na bridgi. Najprv zapnite vlan-filtering na bridgi.";
"VLANs %@ share one bridge VLAN entry on the router. Split it into one entry per VLAN first." = "VLAN %@ zdieľajú na routeri jeden záznam bridge VLAN. Najprv ho rozdeľte na jeden záznam pre každú VLAN.";
"%@: choose a VLAN for this port." = "%@: vyberte VLAN pre tento port.";
"RouterOS bridge VLANs have no names of their own. Netdeck shows the name of the VLAN's interface, or vlan and its number." = "VLAN na bridgi v RouterOS nemajú vlastné názvy. Netdeck zobrazuje názov rozhrania VLAN, prípadne vlan a jej číslo.";
"VLAN '%@' has the VLAN interface '%@' on the router. Remove that interface first." = "VLAN '%@' má na routeri rozhranie VLAN '%@'. Najprv toto rozhranie odstráňte.";
"The router asks for a new password. Log in once with WinBox, WebFig or a terminal, set a password, then connect again." = "Router žiada nové heslo. Raz sa prihláste cez WinBox, WebFig alebo terminál, nastavte heslo a potom sa pripojte znova.";
"RouterOS has no candidate configuration to check in advance. Netdeck sends the commands one by one and undoes all of them if the router rejects one." = "RouterOS nemá kandidátsku konfiguráciu, ktorú by bolo možné vopred skontrolovať. Netdeck posiela príkazy jeden po druhom a ak router niektorý odmietne, vráti späť všetky.";
"The router did not confirm the command." = "Router príkaz nepotvrdil.";
"The undo timer is still on the router. Confirm again." = "Časovač vrátenia späť je stále na routeri. Potvrďte znova.";
"This change is too large for the router's undo script. Apply it in smaller parts." = "Táto zmena je príliš veľká pre skript vrátenia späť na routeri. Použite ju po menších častiach.";
"Netdeck could not read the router's clock, so it can't set the undo timer. Nothing was changed." = "Netdeck nedokázal prečítať hodiny routera, preto nevie nastaviť časovač vrátenia späť. Nič sa nezmenilo.";
"The undo script on the router is incomplete." = "Skript vrátenia späť na routeri je neúplný.";
"The undo timer did not start on the router." = "Časovač vrátenia späť sa na routeri nespustil.";
"Netdeck could not set the undo timer on the router, so nothing was changed." = "Netdeck nedokázal nastaviť časovač vrátenia späť na routeri, preto sa nič nezmenilo.";
"The undo script did not finish on the router." = "Skript vrátenia späť sa na routeri nedokončil.";
"Undo runs at %@ (router time)" = "Vrátenie späť sa spustí o %@ (čas routera)";
"Another session applied these changes and they still wait for confirmation. Discarding runs their undo script now, so the router goes back to the settings from before them. This can't be undone." = "Tieto zmeny použila iná relácia a stále čakajú na potvrdenie. Zahodením sa teraz spustí ich skript vrátenia späť, takže sa router vráti k nastaveniam spred nich. Túto akciu nemožno vrátiť späť.";

/* Server power commands (Redfish) */
"Sending the power command" = "Odosiela sa príkaz napájania";
"Power" = "Napájanie";
"Turn on" = "Zapnúť";
"Shut down" = "Vypnúť";
"Restart" = "Reštartovať";
"Force restart" = "Vynútiť reštart";
"Force off" = "Vynútiť vypnutie";
"Power cycle" = "Vypnúť a znova zapnúť";
"Turn on %@?" = "Zapnúť %@?";
"Shut down %@?" = "Vypnúť %@?";
"Restart %@?" = "Reštartovať %@?";
"Force restart %@?" = "Vynútiť reštart %@?";
"Force off %@?" = "Vynútiť vypnutie %@?";
"Power cycle %@?" = "Vypnúť a znova zapnúť %@?";
"The server powers on and starts its operating system." = "Server sa zapne a spustí operačný systém.";
"The operating system is asked to shut down. Everything running on the server stops." = "Operačný systém dostane pokyn na vypnutie. Všetko, čo na serveri beží, sa zastaví.";
"The operating system is asked to restart. Everything running on the server stops until it is back." = "Operačný systém dostane pokyn na reštart. Všetko, čo na serveri beží, sa zastaví, kým sa nevráti.";
"The server restarts at once, without shutting down the operating system. Unsaved data is lost." = "Server sa okamžite reštartuje bez riadneho vypnutia operačného systému. Neuložené údaje sa stratia.";
"The server turns off at once, like pulling the power cord. Unsaved data is lost." = "Server sa okamžite vypne, ako keby ste vytiahli napájací kábel. Neuložené údaje sa stratia.";
"The server turns off at once and back on, like pulling the power cord and plugging it in again. Unsaved data is lost." = "Server sa okamžite vypne a znova zapne, ako keby ste vytiahli napájací kábel a znova ho zapojili. Neuložené údaje sa stratia.";
"The server accepted the power command. Its power state can take a minute to change; read again to see it." = "Server prijal príkaz napájania. Zmena stavu napájania môže trvať aj minútu, načítajte znova, aby ste ju videli.";
"Netdeck reads this device over its API and never changes its settings. Power commands go out only after you confirm them." = "Netdeck číta toto zariadenie cez jeho API a nikdy nemení jeho nastavenia. Príkazy napájania sa odošlú až po vašom potvrdení.";

/* Embedded SSH client, sandbox */
"Trust the new host key" = "Dôverovať novému kľúču hostiteľa";
"Use the system ssh command (outside the Mac App Store)" = "Použiť systémový príkaz ssh (mimo Mac App Store)";
"Netdeck has its own SSH client. Turn this on for devices it can't talk to, such as older ones that only offer RSA host keys or older ciphers. Applies to the next connection." = "Netdeck má vlastného klienta SSH. Zapnite to pre zariadenia, s ktorými sa nevie dohovoriť, napríklad staršie zariadenia, ktoré ponúkajú iba kľúče hostiteľa RSA alebo staršie šifry. Platí pre ďalšie pripojenie.";
"The SSH connection was closed by the device." = "Zariadenie ukončilo pripojenie SSH.";
"Connection timed out during the SSH handshake with %@." = "Pri nadväzovaní spojenia SSH s %@ vypršal časový limit.";
"The device refused the SSH shell: %@" = "Zariadenie odmietlo shell SSH: %@";
"The device refused to start an SSH shell." = "Zariadenie odmietlo spustiť shell SSH.";
"The device's SSH algorithms aren't supported by the built-in SSH client: %@" = "Algoritmy SSH tohto zariadenia vstavaný klient SSH nepodporuje: %@";
"SSH algorithms: %@" = "Algoritmy SSH: %@";
"SSH, older algorithms" = "SSH, staršie algoritmy";
"%@ belongs to %@; its VLANs follow the LAG. Netdeck doesn't change them." = "%@ patrí do %@, jeho VLAN sa riadia LAG. Netdeck ich nemení.";
"%@ is a routed port. Netdeck doesn't change VLANs on routed ports." = "%@ je smerovaný (routed) port. Netdeck na takých portoch VLAN nemení.";
"%@: '?' can't be typed in a description on this switch." = "%@: na tomto switchi sa do popisu nedá napísať '?'.";
"%@: a trunk port must carry at least one VLAN. With none, AOS-CX carries them all." = "%@: trunk port musí niesť aspoň jednu VLAN. Bez nej AOS-CX nesie všetky.";
"'%@': AOS-CX VLAN names are 1–32 characters: letters, digits, '_' and '-'." = "'%@': názvy VLAN v AOS-CX majú 1–32 znakov: písmená, číslice, '_' a '-'.";
"AOS-CX %@ may not restore the configuration if the session drops before you confirm (fixed in 10.06). Update the switch to make changes with Netdeck." = "AOS-CX %@ nemusí obnoviť konfiguráciu, ak relácia spadne skôr, než potvrdíte (opravené vo 10.06). Aktualizujte switch, aby ste mohli robiť zmeny v Netdecku.";
"AOS-CX commands" = "Príkazy AOS-CX";
"Another change is already waiting for confirmation on this switch (an auto checkpoint is running). Netdeck doesn't apply changes until it ends." = "Na tomto switchi už na potvrdenie čaká iná zmena (beží auto checkpoint). Netdeck do jej konca zmeny nepoužije.";
"If you don't confirm, the switch restores the configuration it had before the change." = "Ak nepotvrdíte, switch obnoví konfiguráciu, ktorú mal pred zmenou.";
"Netdeck couldn't save the configuration before the change:" = "Netdeck nemohol uložiť konfiguráciu spred zmeny:";
"Netdeck needs administrator rights on this switch. Log in as an administrator or manager user." = "Netdeck potrebuje na tomto switchi administrátorské práva. Prihláste sa ako používateľ administrator alebo manager.";
"The switch can't change a VLAN's number. Add a VLAN with the new number and move the ports to it." = "Switch nevie zmeniť číslo VLAN. Pridajte VLAN s novým číslom a presuňte do nej porty.";
"The switch has no candidate configuration to check in advance. It applies each command at once; if one is rejected, or if you don't confirm in time, it restores the configuration it had before the change." = "Switch nemá kandidátsku konfiguráciu, ktorú by sa dalo vopred skontrolovať. Každý príkaz použije hneď; ak niektorý odmietne alebo ak nepotvrdíte včas, obnoví konfiguráciu, ktorú mal pred zmenou.";
"This switch can't undo changes on its own (no auto checkpoint). Netdeck doesn't apply changes without it." = "Tento switch nevie vrátiť zmeny sám (chýba auto checkpoint). Bez neho Netdeck zmeny nepoužije.";
"%@: a description can't contain '\"'." = "%@: popis nesmie obsahovať '\"'.";
"%@: the port must stay a member of at least one VLAN." = "%@: port musí zostať členom aspoň jednej VLAN.";
"'%@': VLAN names on this switch are 1–32 characters and can't contain '\"'." = "'%@': názvy VLAN na tomto switchi majú 1–32 znakov a nesmú obsahovať '\"'.";
"AOS-S commands" = "Príkazy AOS-S";
"Another change is already waiting for confirmation on this switch (Netdeck's restore job is scheduled). Netdeck doesn't apply changes until it ends." = "Na tomto switchi už na potvrdenie čaká iná zmena (úloha obnovy od Netdecku je naplánovaná). Netdeck do jej konca zmeny nepoužije.";
"Netdeck couldn't set up the job that restores the configuration:" = "Netdeck nemohol nastaviť úlohu, ktorá obnoví konfiguráciu:";
"This switch's VLANs have no description. Leave it empty." = "VLAN na tomto switchi nemajú popis. Nechajte ho prázdny.";
"This switch's firmware (%@) can't restore a configuration without restarting; that needs 16.05 or later. Netdeck reads it but doesn't change it." = "Firmvér tohto switcha (%@) nevie obnoviť konfiguráciu bez reštartu; vyžaduje to 16.05 alebo novší. Netdeck ho číta, ale nemení.";
"TP-Link commands" = "Príkazy TP-Link";
"If you don't confirm, the switch restarts with its saved configuration. It is offline for a few minutes." = "Ak nepotvrdíte, switch sa reštartuje s uloženou konfiguráciou. Na niekoľko minút bude offline.";
"The switch has no candidate configuration to check in advance. It applies each command at once and saves nothing until you confirm. If a command is rejected, Netdeck puts the previous settings back; if you don't confirm in time, the switch restarts with its saved configuration." = "Switch nemá kandidátsku konfiguráciu, ktorú by sa dalo vopred skontrolovať. Každý príkaz použije hneď a nič neuloží, kým nepotvrdíte. Ak niektorý príkaz odmietne, Netdeck vráti predchádzajúce nastavenia; ak nepotvrdíte včas, switch sa reštartuje s uloženou konfiguráciou.";
"This switch has changes that aren't saved yet. Netdeck's safety net restarts the switch with its saved configuration, which would lose them too. Save or undo them on the switch first." = "Tento switch má zmeny, ktoré ešte nie sú uložené. Záchranná sieť Netdecku reštartuje switch s uloženou konfiguráciou, takže by sa stratili aj tie. Najprv ich na switchi uložte alebo vráťte späť.";
"An Omada controller manages this switch, and it only takes show commands. Netdeck reads it but doesn't change it; make changes in the controller." = "Tento switch spravuje kontrolér Omada a prijíma len príkazy show. Netdeck ho číta, ale nemení; zmeny urobte v kontroléri.";
"Netdeck couldn't schedule the restart that undoes the change:" = "Netdeck nedokázal naplánovať reštart, ktorý zmenu vráti:";
"Netdeck couldn't put every setting back by itself. The switch restarts with its saved configuration within a minute and is offline for a few minutes." = "Netdeck nedokázal sám vrátiť všetky nastavenia. Switch sa do minúty reštartuje s uloženou konfiguráciou a na niekoľko minút bude offline.";
"%@: port descriptions on this switch are at most 16 characters, without quotes, brackets or < > , \\ &." = "%@: popisy portov majú na tomto switchi najviac 16 znakov, bez úvodzoviek, zátvoriek a znakov < > , \\ &.";
"%@ has a VLAN setup Netdeck can't show as access or trunk (%@). Change it on the switch." = "%@ má nastavenie VLAN, ktoré Netdeck nedokáže zobraziť ako access ani trunk (%@). Zmeňte ho na switchi.";
"'%@': VLAN names on this switch are 1–16 characters and can't contain \" < > , \\ or &." = "'%@': názvy VLAN majú na tomto switchi 1–16 znakov a nesmú obsahovať \" < > , \\ ani &.";
