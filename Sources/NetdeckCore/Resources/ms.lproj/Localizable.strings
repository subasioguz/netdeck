/* HTTPS error cards */
"%@ presented a different security certificate than last time. That happens after a reset or a certificate renewal, but it can also mean someone is in between. Trust the new certificate only if you know why it changed." = "%@ mengemukakan sijil keselamatan yang berbeza daripada kali lepas. Ini berlaku selepas penetapan semula atau pembaharuan sijil, tetapi ia juga boleh bermaksud ada orang di tengah-tengah. Percayai sijil baharu hanya jika anda tahu mengapa ia berubah.";
"Certificate changed" = "Sijil berubah";
"HTTPS: the address can't be reached" = "HTTPS: alamat tidak dapat dicapai";
"HTTPS: the certificate changed" = "HTTPS: sijil berubah";
"Netdeck couldn't reach %@. Check that the device is on, the address and port are right (Synology uses 5001) and this Mac is on the same network." = "Netdeck tidak dapat mencapai %@. Semak bahawa peranti dihidupkan, alamat dan port betul (Synology menggunakan 5001) dan Mac ini berada pada rangkaian yang sama.";
"Trust the new certificate" = "Percayai sijil baharu";

/* MikroTik RouterOS */
"%@: VLANs on RouterOS need bridge VLAN filtering. Add the port to the bridge and turn on vlan-filtering first." = "%@: VLAN pada RouterOS memerlukan penapisan VLAN bridge. Tambah port pada bridge dan hidupkan vlan-filtering dahulu.";
"VLANs on RouterOS need bridge VLAN filtering. Turn on vlan-filtering on the bridge first." = "VLAN pada RouterOS memerlukan penapisan VLAN bridge. Hidupkan vlan-filtering pada bridge dahulu.";
"VLANs %@ share one bridge VLAN entry on the router. Split it into one entry per VLAN first." = "VLAN %@ berkongsi satu entri VLAN bridge pada penghala. Pisahkannya kepada satu entri bagi setiap VLAN dahulu.";
"%@: choose a VLAN for this port." = "%@: pilih VLAN untuk port ini.";
"RouterOS bridge VLANs have no names of their own. Netdeck shows the name of the VLAN's interface, or vlan and its number." = "VLAN bridge RouterOS tidak mempunyai nama sendiri. Netdeck menunjukkan nama antara muka VLAN, atau vlan dan nombornya.";
"VLAN '%@' has the VLAN interface '%@' on the router. Remove that interface first." = "VLAN '%@' mempunyai antara muka VLAN '%@' pada penghala. Alih keluar antara muka itu dahulu.";
"The router asks for a new password. Log in once with WinBox, WebFig or a terminal, set a password, then connect again." = "Penghala meminta kata laluan baharu. Log masuk sekali dengan WinBox, WebFig atau terminal, tetapkan kata laluan, kemudian sambung semula.";
"RouterOS has no candidate configuration to check in advance. Netdeck sends the commands one by one and undoes all of them if the router rejects one." = "RouterOS tidak mempunyai konfigurasi calon untuk disemak lebih awal. Netdeck menghantar arahan satu demi satu dan membuat asal kesemuanya jika penghala menolak satu.";
"The router did not confirm the command." = "Penghala tidak mengesahkan arahan itu.";
"The undo timer is still on the router. Confirm again." = "Pemasa buat asal masih ada pada penghala. Sahkan sekali lagi.";
"This change is too large for the router's undo script. Apply it in smaller parts." = "Perubahan ini terlalu besar untuk skrip buat asal penghala. Gunakannya dalam bahagian yang lebih kecil.";
"Netdeck could not read the router's clock, so it can't set the undo timer. Nothing was changed." = "Netdeck tidak dapat membaca jam penghala, jadi ia tidak dapat menetapkan pemasa buat asal. Tiada apa-apa diubah.";
"The undo script on the router is incomplete." = "Skrip buat asal pada penghala tidak lengkap.";
"The undo timer did not start on the router." = "Pemasa buat asal tidak bermula pada penghala.";
"Netdeck could not set the undo timer on the router, so nothing was changed." = "Netdeck tidak dapat menetapkan pemasa buat asal pada penghala, jadi tiada apa-apa diubah.";
"The undo script did not finish on the router." = "Skrip buat asal tidak selesai pada penghala.";
"Undo runs at %@ (router time)" = "Buat asal berjalan pada %@ (waktu penghala)";
"Another session applied these changes and they still wait for confirmation. Discarding runs their undo script now, so the router goes back to the settings from before them. This can't be undone." = "Sesi lain menggunakan perubahan ini dan ia masih menunggu pengesahan. Membuangnya menjalankan skrip buat asalnya sekarang, jadi penghala kembali ke tetapan sebelum perubahan itu. Ini tidak boleh dibuat asal.";

/* Server power commands (Redfish) */
"Sending the power command" = "Menghantar arahan kuasa";
"Power" = "Kuasa";
"Turn on" = "Hidupkan";
"Shut down" = "Matikan";
"Restart" = "Mulakan semula";
"Force restart" = "Paksa mulakan semula";
"Force off" = "Paksa matikan";
"Power cycle" = "Kitar kuasa";
"Turn on %@?" = "Hidupkan %@?";
"Shut down %@?" = "Matikan %@?";
"Restart %@?" = "Mulakan semula %@?";
"Force restart %@?" = "Paksa mulakan semula %@?";
"Force off %@?" = "Paksa matikan %@?";
"Power cycle %@?" = "Kitar kuasa %@?";
"The server powers on and starts its operating system." = "Pelayan dihidupkan dan memulakan sistem pengendaliannya.";
"The operating system is asked to shut down. Everything running on the server stops." = "Sistem pengendalian diminta untuk dimatikan. Semua yang berjalan pada pelayan berhenti.";
"The operating system is asked to restart. Everything running on the server stops until it is back." = "Sistem pengendalian diminta untuk dimulakan semula. Semua yang berjalan pada pelayan berhenti sehingga ia kembali.";
"The server restarts at once, without shutting down the operating system. Unsaved data is lost." = "Pelayan dimulakan semula serta-merta, tanpa mematikan sistem pengendalian. Data yang belum disimpan akan hilang.";
"The server turns off at once, like pulling the power cord. Unsaved data is lost." = "Pelayan dimatikan serta-merta, seperti mencabut kord kuasa. Data yang belum disimpan akan hilang.";
"The server turns off at once and back on, like pulling the power cord and plugging it in again. Unsaved data is lost." = "Pelayan dimatikan dan dihidupkan semula serta-merta, seperti mencabut kord kuasa dan memalamkannya semula. Data yang belum disimpan akan hilang.";
"The server accepted the power command. Its power state can take a minute to change; read again to see it." = "Pelayan menerima arahan kuasa. Keadaan kuasanya mungkin mengambil masa seminit untuk berubah; baca semula untuk melihatnya.";
"Netdeck reads this device over its API and never changes its settings. Power commands go out only after you confirm them." = "Netdeck membaca peranti ini melalui API-nya dan tidak pernah mengubah tetapannya. Arahan kuasa hanya dihantar selepas anda mengesahkannya.";

/* Embedded SSH client, sandbox */
"Trust the new host key" = "Percayai kunci hos baharu";
"Use the system ssh command (outside the Mac App Store)" = "Gunakan arahan ssh sistem (di luar Mac App Store)";
"Netdeck has its own SSH client. Turn this on for devices it can't talk to, such as older ones that only offer RSA host keys or older ciphers. Applies to the next connection." = "Netdeck mempunyai klien SSH sendiri. Hidupkan ini untuk peranti yang tidak dapat dihubunginya, seperti yang lebih lama yang hanya menawarkan kunci hos RSA atau sifer lama. Terpakai pada sambungan seterusnya.";
"The SSH connection was closed by the device." = "Sambungan SSH ditutup oleh peranti.";
"Connection timed out during the SSH handshake with %@." = "Sambungan tamat masa semasa jabat tangan SSH dengan %@.";
"The device refused the SSH shell: %@" = "Peranti menolak shell SSH: %@";
"The device refused to start an SSH shell." = "Peranti enggan memulakan shell SSH.";
"The device's SSH algorithms aren't supported by the built-in SSH client: %@" = "Algoritma SSH peranti tidak disokong oleh klien SSH terbina dalam: %@";
"SSH algorithms: %@" = "Algoritma SSH: %@";
"SSH, older algorithms" = "SSH, algoritma lama";
"%@ belongs to %@; its VLANs follow the LAG. Netdeck doesn't change them." = "%@ tergolong dalam %@; VLAN-nya mengikut LAG. Netdeck tidak mengubahnya.";
"%@ is a routed port. Netdeck doesn't change VLANs on routed ports." = "%@ ialah port berlaluan. Netdeck tidak menukar VLAN pada port berlaluan.";
"%@: '?' can't be typed in a description on this switch." = "%@: '?' tidak boleh ditaip dalam perihalan pada suis ini.";
"%@: a trunk port must carry at least one VLAN. With none, AOS-CX carries them all." = "%@: port trunk mesti membawa sekurang-kurangnya satu VLAN. Tanpa satu pun, AOS-CX membawa semuanya.";
"'%@': AOS-CX VLAN names are 1–32 characters: letters, digits, '_' and '-'." = "'%@': nama VLAN AOS-CX terdiri daripada 1–32 aksara: huruf, digit, '_' dan '-'.";
"AOS-CX %@ may not restore the configuration if the session drops before you confirm (fixed in 10.06). Update the switch to make changes with Netdeck." = "AOS-CX %@ mungkin tidak memulihkan konfigurasi jika sesi terputus sebelum anda mengesahkan (dibaiki dalam 10.06). Kemas kini suis untuk membuat perubahan dengan Netdeck.";
"AOS-CX commands" = "Arahan AOS-CX";
"Another change is already waiting for confirmation on this switch (an auto checkpoint is running). Netdeck doesn't apply changes until it ends." = "Satu perubahan lain sudah menunggu pengesahan pada suis ini (auto checkpoint sedang berjalan). Netdeck tidak menggunakan perubahan sehingga ia tamat.";
"If you don't confirm, the switch restores the configuration it had before the change." = "Jika anda tidak mengesahkan, suis memulihkan konfigurasi yang dimilikinya sebelum perubahan.";
"Netdeck couldn't save the configuration before the change:" = "Netdeck tidak dapat menyimpan konfigurasi sebelum perubahan:";
"Netdeck needs administrator rights on this switch. Log in as an administrator or manager user." = "Netdeck memerlukan hak pentadbir pada suis ini. Log masuk sebagai pengguna administrator atau manager.";
"The switch can't change a VLAN's number. Add a VLAN with the new number and move the ports to it." = "Suis tidak dapat menukar nombor VLAN. Tambah VLAN dengan nombor baharu dan alihkan port ke dalamnya.";
"The switch has no candidate configuration to check in advance. It applies each command at once; if one is rejected, or if you don't confirm in time, it restores the configuration it had before the change." = "Suis tiada konfigurasi calon untuk disemak lebih awal. Ia menggunakan setiap arahan serta-merta; jika satu ditolak, atau jika anda tidak mengesahkan tepat pada masanya, ia memulihkan konfigurasi sebelum perubahan.";
"This switch can't undo changes on its own (no auto checkpoint). Netdeck doesn't apply changes without it." = "Suis ini tidak dapat membuat asal perubahan sendiri (tiada auto checkpoint). Netdeck tidak menggunakan perubahan tanpanya.";
"%@: a description can't contain '\"'." = "%@: perihalan tidak boleh mengandungi '\"'.";
"%@: the port must stay a member of at least one VLAN." = "%@: port mesti kekal sebagai ahli sekurang-kurangnya satu VLAN.";
"'%@': VLAN names on this switch are 1–32 characters and can't contain '\"'." = "'%@': nama VLAN pada suis ini terdiri daripada 1–32 aksara dan tidak boleh mengandungi '\"'.";
"AOS-S commands" = "Arahan AOS-S";
"Another change is already waiting for confirmation on this switch (Netdeck's restore job is scheduled). Netdeck doesn't apply changes until it ends." = "Satu perubahan lain sudah menunggu pengesahan pada suis ini (tugas pemulihan Netdeck telah dijadualkan). Netdeck tidak menggunakan perubahan sehingga ia tamat.";
"Netdeck couldn't set up the job that restores the configuration:" = "Netdeck tidak dapat menyediakan tugas yang memulihkan konfigurasi:";
"This switch's VLANs have no description. Leave it empty." = "VLAN pada suis ini tiada perihalan. Biarkan kosong.";
"This switch's firmware (%@) can't restore a configuration without restarting; that needs 16.05 or later. Netdeck reads it but doesn't change it." = "Perisian tegar suis ini (%@) tidak dapat memulihkan konfigurasi tanpa dimulakan semula; ia memerlukan 16.05 atau lebih baharu. Netdeck membacanya tetapi tidak mengubahnya.";
