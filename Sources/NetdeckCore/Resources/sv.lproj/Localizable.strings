"Reading alerts" = "Läser larm";
"Processor" = "Processor";
"%@ cores" = "%@ kärnor";
"Manufacturer" = "Tillverkare";
"Power draw" = "Effektförbrukning";
"Fans" = "Fläktar";
"Power supplies" = "Nätaggregat";
"Temperatures" = "Temperaturer";
"Voltages" = "Spänningar";
"Batteries" = "Batterier";
"Chassis intrusion" = "Chassiintrång";
"%@: critical" = "%@: kritisk";
"%@: warning" = "%@: varning";
"Not installed" = "Inte installerad";
"no input" = "ingen ingång";
"%@ W now" = "%@ W nu";
"Firmware %@" = "Firmware %@";
"Volume %@" = "Volym %@";
"%@ status: %@" = "%@ status: %@";
"The system temperature is high." = "Systemtemperaturen är hög.";
"This account can't read storage information. Use an administrator account to see volumes and disks." = "Det här kontot kan inte läsa lagringsinformation. Använd ett administratörskonto för att se volymer och diskar.";

/* HTTPS error cards */
"%@ presented a different security certificate than last time. That happens after a reset or a certificate renewal, but it can also mean someone is in between. Trust the new certificate only if you know why it changed." = "%@ presenterade ett annat säkerhetscertifikat än förra gången. Det händer efter en återställning eller ett certifikatsbyte, men det kan också betyda att någon sitter emellan. Lita bara på det nya certifikatet om du vet varför det ändrades.";
"Certificate changed" = "Certifikatet ändrades";
"HTTPS: the address can't be reached" = "HTTPS: adressen kan inte nås";
"HTTPS: the certificate changed" = "HTTPS: certifikatet ändrades";
"Netdeck couldn't reach %@. Check that the device is on, the address and port are right (Synology uses 5001) and this Mac is on the same network." = "Netdeck kunde inte nå %@. Kontrollera att enheten är på, att adress och port stämmer (Synology använder 5001) och att den här Macen sitter i samma nätverk.";
"Trust the new certificate" = "Lita på det nya certifikatet";

/* MikroTik RouterOS */
"%@: VLANs on RouterOS need bridge VLAN filtering. Add the port to the bridge and turn on vlan-filtering first." = "%@: VLAN på RouterOS kräver bridge VLAN filtering. Lägg först till porten i bryggan och aktivera vlan-filtering.";
"VLANs on RouterOS need bridge VLAN filtering. Turn on vlan-filtering on the bridge first." = "VLAN på RouterOS kräver bridge VLAN filtering. Aktivera först vlan-filtering på bryggan.";
"VLANs %@ share one bridge VLAN entry on the router. Split it into one entry per VLAN first." = "VLAN %@ delar en bridge VLAN-post på routern. Dela först upp den i en post per VLAN.";
"%@: choose a VLAN for this port." = "%@: välj ett VLAN för den här porten.";
"RouterOS bridge VLANs have no names of their own. Netdeck shows the name of the VLAN's interface, or vlan and its number." = "RouterOS bridge-VLAN har inga egna namn. Netdeck visar namnet på VLAN:ets gränssnitt, eller vlan och dess nummer.";
"VLAN '%@' has the VLAN interface '%@' on the router. Remove that interface first." = "VLAN '%@' har VLAN-gränssnittet '%@' på routern. Ta först bort det gränssnittet.";
"The router asks for a new password. Log in once with WinBox, WebFig or a terminal, set a password, then connect again." = "Routern ber om ett nytt lösenord. Logga in en gång med WinBox, WebFig eller en terminal, ange ett lösenord och anslut sedan igen.";
"RouterOS has no candidate configuration to check in advance. Netdeck sends the commands one by one and undoes all of them if the router rejects one." = "RouterOS har ingen kandidatkonfiguration att kontrollera i förväg. Netdeck skickar kommandona ett i taget och ångrar alla om routern avvisar ett.";
"The router did not confirm the command." = "Routern bekräftade inte kommandot.";
"The undo timer is still on the router. Confirm again." = "Ångratimern finns fortfarande på routern. Bekräfta igen.";
"This change is too large for the router's undo script. Apply it in smaller parts." = "Den här ändringen är för stor för routerns ångraskript. Tillämpa den i mindre delar.";
"Netdeck could not read the router's clock, so it can't set the undo timer. Nothing was changed." = "Netdeck kunde inte läsa routerns klocka och kan därför inte ställa in ångratimern. Inget ändrades.";
"The undo script on the router is incomplete." = "Ångraskriptet på routern är ofullständigt.";
"The undo timer did not start on the router." = "Ångratimern startade inte på routern.";
"Netdeck could not set the undo timer on the router, so nothing was changed." = "Netdeck kunde inte ställa in ångratimern på routern, så inget ändrades.";
"The undo script did not finish on the router." = "Ångraskriptet slutfördes inte på routern.";
"Undo runs at %@ (router time)" = "Ångra körs kl. %@ (routertid)";
"Another session applied these changes and they still wait for confirmation. Discarding runs their undo script now, so the router goes back to the settings from before them. This can't be undone." = "En annan session tillämpade de här ändringarna och de väntar fortfarande på bekräftelse. Att förkasta kör deras ångraskript nu, så routern går tillbaka till inställningarna från före dem. Det kan inte ångras.";

/* Server power commands (Redfish) */
"Sending the power command" = "Skickar strömkommandot";
"Power" = "Ström";
"Turn on" = "Slå på";
"Shut down" = "Stäng av";
"Restart" = "Starta om";
"Force restart" = "Tvinga omstart";
"Force off" = "Tvinga av";
"Power cycle" = "Strömcykel";
"Turn on %@?" = "Slå på %@?";
"Shut down %@?" = "Stänga av %@?";
"Restart %@?" = "Starta om %@?";
"Force restart %@?" = "Tvinga omstart av %@?";
"Force off %@?" = "Tvinga av %@?";
"Power cycle %@?" = "Strömcykla %@?";
"The server powers on and starts its operating system." = "Servern slås på och startar sitt operativsystem.";
"The operating system is asked to shut down. Everything running on the server stops." = "Operativsystemet ombeds stängas av. Allt som körs på servern stoppas.";
"The operating system is asked to restart. Everything running on the server stops until it is back." = "Operativsystemet ombeds starta om. Allt som körs på servern stoppas tills den är tillbaka.";
"The server restarts at once, without shutting down the operating system. Unsaved data is lost." = "Servern startar om direkt, utan att operativsystemet stängs av. Osparade data går förlorade.";
"The server turns off at once, like pulling the power cord. Unsaved data is lost." = "Servern stängs av direkt, som om nätsladden drogs ut. Osparade data går förlorade.";
"The server turns off at once and back on, like pulling the power cord and plugging it in again. Unsaved data is lost." = "Servern stängs av och slås på igen direkt, som om nätsladden drogs ut och sattes i igen. Osparade data går förlorade.";
"The server accepted the power command. Its power state can take a minute to change; read again to see it." = "Servern godtog strömkommandot. Strömstatusen kan ta en minut att ändras; läs igen för att se den.";
"Netdeck reads this device over its API and never changes its settings. Power commands go out only after you confirm them." = "Netdeck läser den här enheten via dess API och ändrar aldrig dess inställningar. Strömkommandon skickas först när du bekräftar dem.";

/* Embedded SSH client, sandbox */
"Trust the new host key" = "Lita på den nya värdnyckeln";
"Use the system ssh command (outside the Mac App Store)" = "Använd systemets ssh-kommando (utanför Mac App Store)";
"Netdeck has its own SSH client. Turn this on for devices it can't talk to, such as older ones that only offer RSA host keys or older ciphers. Applies to the next connection." = "Netdeck har en egen SSH-klient. Aktivera detta för enheter den inte kan prata med, till exempel äldre enheter som bara erbjuder RSA-värdnycklar eller äldre chiffer. Gäller vid nästa anslutning.";
"The SSH connection was closed by the device." = "SSH-anslutningen stängdes av enheten.";
"Connection timed out during the SSH handshake with %@." = "Anslutningen fick timeout under SSH-handskakningen med %@.";
"The device refused the SSH shell: %@" = "Enheten avvisade SSH-skalet: %@";
"The device refused to start an SSH shell." = "Enheten vägrade starta ett SSH-skal.";
"The device's SSH algorithms aren't supported by the built-in SSH client: %@" = "Enhetens SSH-algoritmer stöds inte av den inbyggda SSH-klienten: %@";
"SSH algorithms: %@" = "SSH-algoritmer: %@";
"SSH, older algorithms" = "SSH, äldre algoritmer";
"%@ belongs to %@; its VLANs follow the LAG. Netdeck doesn't change them." = "%@ tillhör %@; dess VLAN följer LAG:en. Netdeck ändrar dem inte.";
"%@ is a routed port. Netdeck doesn't change VLANs on routed ports." = "%@ är en routad port. Netdeck ändrar inte VLAN på routade portar.";
"%@: '?' can't be typed in a description on this switch." = "%@: på den här switchen går det inte att skriva '?' i en beskrivning.";
"%@: a trunk port must carry at least one VLAN. With none, AOS-CX carries them all." = "%@: en trunkport måste bära minst ett VLAN. Utan något bär AOS-CX alla.";
"'%@': AOS-CX VLAN names are 1–32 characters: letters, digits, '_' and '-'." = "'%@': VLAN-namn i AOS-CX har 1–32 tecken: bokstäver, siffror, '_' och '-'.";
"AOS-CX %@ may not restore the configuration if the session drops before you confirm (fixed in 10.06). Update the switch to make changes with Netdeck." = "AOS-CX %@ återställer kanske inte konfigurationen om sessionen bryts innan du bekräftar (åtgärdat i 10.06). Uppdatera switchen för att göra ändringar med Netdeck.";
"AOS-CX commands" = "AOS-CX-kommandon";
"Another change is already waiting for confirmation on this switch (an auto checkpoint is running). Netdeck doesn't apply changes until it ends." = "En annan ändring väntar redan på bekräftelse på den här switchen (en auto checkpoint körs). Netdeck tillämpar inte ändringar förrän den är klar.";
"If you don't confirm, the switch restores the configuration it had before the change." = "Om du inte bekräftar återställer switchen konfigurationen den hade före ändringen.";
"Netdeck couldn't save the configuration before the change:" = "Netdeck kunde inte spara konfigurationen från före ändringen:";
"Netdeck needs administrator rights on this switch. Log in as an administrator or manager user." = "Netdeck behöver administratörsrättigheter på den här switchen. Logga in som en administrator- eller manager-användare.";
"The switch can't change a VLAN's number. Add a VLAN with the new number and move the ports to it." = "Switchen kan inte ändra ett VLAN:s nummer. Lägg till ett VLAN med det nya numret och flytta portarna dit.";
"The switch has no candidate configuration to check in advance. It applies each command at once; if one is rejected, or if you don't confirm in time, it restores the configuration it had before the change." = "Switchen har ingen kandidatkonfiguration att kontrollera i förväg. Den tillämpar varje kommando direkt; om något avvisas, eller om du inte bekräftar i tid, återställer den konfigurationen från före ändringen.";
"This switch can't undo changes on its own (no auto checkpoint). Netdeck doesn't apply changes without it." = "Den här switchen kan inte ångra ändringar på egen hand (ingen auto checkpoint). Netdeck tillämpar inte ändringar utan den.";
"%@: a description can't contain '\"'." = "%@: en beskrivning får inte innehålla '\"'.";
"%@: the port must stay a member of at least one VLAN." = "%@: porten måste förbli medlem i minst ett VLAN.";
"'%@': VLAN names on this switch are 1–32 characters and can't contain '\"'." = "'%@': VLAN-namn på den här switchen har 1–32 tecken och får inte innehålla '\"'.";
"AOS-S commands" = "AOS-S-kommandon";
"Another change is already waiting for confirmation on this switch (Netdeck's restore job is scheduled). Netdeck doesn't apply changes until it ends." = "En annan ändring väntar redan på bekräftelse på den här switchen (Netdecks återställningsjobb är schemalagt). Netdeck tillämpar inte ändringar förrän det är klart.";
"Netdeck couldn't set up the job that restores the configuration:" = "Netdeck kunde inte skapa jobbet som återställer konfigurationen:";
"This switch's VLANs have no description. Leave it empty." = "VLAN på den här switchen har ingen beskrivning. Lämna den tom.";
"This switch's firmware (%@) can't restore a configuration without restarting; that needs 16.05 or later. Netdeck reads it but doesn't change it." = "Den här switchens firmware (%@) kan inte återställa en konfiguration utan omstart; det kräver 16.05 eller senare. Netdeck läser den men ändrar den inte.";
"TP-Link commands" = "TP-Link-kommandon";
"If you don't confirm, the switch restarts with its saved configuration. It is offline for a few minutes." = "Om du inte bekräftar startar switchen om med sin sparade konfiguration. Den är offline i några minuter.";
"The switch has no candidate configuration to check in advance. It applies each command at once and saves nothing until you confirm. If a command is rejected, Netdeck puts the previous settings back; if you don't confirm in time, the switch restarts with its saved configuration." = "Switchen har ingen kandidatkonfiguration som kan kontrolleras i förväg. Den tillämpar varje kommando direkt och sparar ingenting förrän du bekräftar. Om ett kommando avvisas återställer Netdeck de tidigare inställningarna; om du inte bekräftar i tid startar switchen om med sin sparade konfiguration.";
"This switch has changes that aren't saved yet. Netdeck's safety net restarts the switch with its saved configuration, which would lose them too. Save or undo them on the switch first." = "Den här switchen har ändringar som inte har sparats än. Netdecks skyddsnät startar om switchen med den sparade konfigurationen, så de skulle också gå förlorade. Spara eller ångra dem på switchen först.";
"An Omada controller manages this switch, and it only takes show commands. Netdeck reads it but doesn't change it; make changes in the controller." = "En Omada-kontroller hanterar den här switchen, och den tar bara emot show-kommandon. Netdeck läser den men ändrar den inte; gör ändringar i kontrollern.";
"Netdeck couldn't schedule the restart that undoes the change:" = "Netdeck kunde inte schemalägga omstarten som ångrar ändringen:";
"Netdeck couldn't put every setting back by itself. The switch restarts with its saved configuration within a minute and is offline for a few minutes." = "Netdeck kunde inte återställa alla inställningar själv. Switchen startar om med sin sparade konfiguration inom en minut och är offline i några minuter.";
"%@: port descriptions on this switch are at most 16 characters, without quotes, brackets or < > , \\ &." = "%@: portbeskrivningar på den här switchen är högst 16 tecken, utan citattecken, parenteser eller < > , \\ &.";
"%@ has a VLAN setup Netdeck can't show as access or trunk (%@). Change it on the switch." = "%@ har en VLAN-inställning som Netdeck inte kan visa som access eller trunk (%@). Ändra den på switchen.";
"'%@': VLAN names on this switch are 1–16 characters and can't contain \" < > , \\ or &." = "'%@': VLAN-namn på den här switchen är 1–16 tecken och får inte innehålla \" < > , \\ eller &.";
