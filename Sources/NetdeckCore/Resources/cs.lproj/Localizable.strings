/* HTTPS error cards */
"%@ presented a different security certificate than last time. That happens after a reset or a certificate renewal, but it can also mean someone is in between. Trust the new certificate only if you know why it changed." = "%@ předložil jiný bezpečnostní certifikát než minule. To se stává po resetu nebo obnovení certifikátu, ale může to znamenat i to, že se do spojení někdo vkládá. Novému certifikátu důvěřujte, jen pokud víte, proč se změnil.";
"Certificate changed" = "Certifikát se změnil";
"HTTPS: the address can't be reached" = "HTTPS: adresa není dosažitelná";
"HTTPS: the certificate changed" = "HTTPS: certifikát se změnil";
"Netdeck couldn't reach %@. Check that the device is on, the address and port are right (Synology uses 5001) and this Mac is on the same network." = "Netdeck se nemohl spojit s %@. Zkontrolujte, že je zařízení zapnuté, adresa a port jsou správné (Synology používá 5001) a tento Mac je ve stejné síti.";
"Trust the new certificate" = "Důvěřovat novému certifikátu";

/* MikroTik RouterOS */
"%@: VLANs on RouterOS need bridge VLAN filtering. Add the port to the bridge and turn on vlan-filtering first." = "%@: VLAN v RouterOS vyžadují filtrování VLAN na bridgi. Nejprve přidejte port do bridge a zapněte vlan-filtering.";
"VLANs on RouterOS need bridge VLAN filtering. Turn on vlan-filtering on the bridge first." = "VLAN v RouterOS vyžadují filtrování VLAN na bridgi. Nejprve zapněte vlan-filtering na bridgi.";
"VLANs %@ share one bridge VLAN entry on the router. Split it into one entry per VLAN first." = "VLAN %@ sdílejí na routeru jeden záznam bridge VLAN. Nejprve ho rozdělte na jeden záznam pro každou VLAN.";
"%@: choose a VLAN for this port." = "%@: vyberte pro tento port VLAN.";
"RouterOS bridge VLANs have no names of their own. Netdeck shows the name of the VLAN's interface, or vlan and its number." = "VLAN bridge v RouterOS nemají vlastní názvy. Netdeck zobrazuje název rozhraní VLAN, nebo vlan a její číslo.";
"VLAN '%@' has the VLAN interface '%@' on the router. Remove that interface first." = "VLAN „%@“ má na routeru rozhraní VLAN „%@“. Nejprve toto rozhraní odeberte.";
"The router asks for a new password. Log in once with WinBox, WebFig or a terminal, set a password, then connect again." = "Router žádá nové heslo. Jednou se přihlaste přes WinBox, WebFig nebo terminál, nastavte heslo a pak se připojte znovu.";
"RouterOS has no candidate configuration to check in advance. Netdeck sends the commands one by one and undoes all of them if the router rejects one." = "RouterOS nemá kandidátní konfiguraci, kterou by šlo předem zkontrolovat. Netdeck posílá příkazy jeden po druhém a pokud router některý odmítne, všechny vrátí zpět.";
"The router did not confirm the command." = "Router příkaz nepotvrdil.";
"The undo timer is still on the router. Confirm again." = "Časovač vrácení zpět je stále na routeru. Potvrďte znovu.";
"This change is too large for the router's undo script. Apply it in smaller parts." = "Tato změna je pro skript vrácení zpět na routeru příliš velká. Použijte ji po menších částech.";
"Netdeck could not read the router's clock, so it can't set the undo timer. Nothing was changed." = "Netdeck nemohl přečíst hodiny routeru, takže nemůže nastavit časovač vrácení zpět. Nic se nezměnilo.";
"The undo script on the router is incomplete." = "Skript vrácení zpět na routeru je neúplný.";
"The undo timer did not start on the router." = "Časovač vrácení zpět se na routeru nespustil.";
"Netdeck could not set the undo timer on the router, so nothing was changed." = "Netdeck nemohl na routeru nastavit časovač vrácení zpět, proto se nic nezměnilo.";
"The undo script did not finish on the router." = "Skript vrácení zpět na routeru nedoběhl.";
"Undo runs at %@ (router time)" = "Vrácení zpět proběhne v %@ (čas routeru)";
"Another session applied these changes and they still wait for confirmation. Discarding runs their undo script now, so the router goes back to the settings from before them. This can't be undone." = "Tyto změny použila jiná relace a stále čekají na potvrzení. Zahozením se jejich skript vrácení zpět spustí hned, takže se router vrátí k nastavení před nimi. Nelze vrátit zpět.";

/* Server power commands (Redfish) */
"Sending the power command" = "Odesílá se příkaz napájení";
"Power" = "Napájení";
"Turn on" = "Zapnout";
"Shut down" = "Vypnout";
"Restart" = "Restartovat";
"Force restart" = "Vynutit restart";
"Force off" = "Vynutit vypnutí";
"Power cycle" = "Vypnout a znovu zapnout napájení";
"Turn on %@?" = "Zapnout %@?";
"Shut down %@?" = "Vypnout %@?";
"Restart %@?" = "Restartovat %@?";
"Force restart %@?" = "Vynutit restart %@?";
"Force off %@?" = "Vynutit vypnutí %@?";
"Power cycle %@?" = "Vypnout a znovu zapnout napájení %@?";
"The server powers on and starts its operating system." = "Server se zapne a spustí operační systém.";
"The operating system is asked to shut down. Everything running on the server stops." = "Operační systém je požádán o vypnutí. Vše, co na serveru běží, se zastaví.";
"The operating system is asked to restart. Everything running on the server stops until it is back." = "Operační systém je požádán o restart. Vše, co na serveru běží, se zastaví, dokud se server nevrátí.";
"The server restarts at once, without shutting down the operating system. Unsaved data is lost." = "Server se ihned restartuje bez vypnutí operačního systému. Neuložená data se ztratí.";
"The server turns off at once, like pulling the power cord. Unsaved data is lost." = "Server se ihned vypne, jako by se vytáhl napájecí kabel. Neuložená data se ztratí.";
"The server turns off at once and back on, like pulling the power cord and plugging it in again. Unsaved data is lost." = "Server se ihned vypne a znovu zapne, jako by se vytáhl a znovu zapojil napájecí kabel. Neuložená data se ztratí.";
"The server accepted the power command. Its power state can take a minute to change; read again to see it." = "Server příkaz napájení přijal. Změna stavu napájení může trvat minutu; pro zobrazení čtěte znovu.";
"Netdeck reads this device over its API and never changes its settings. Power commands go out only after you confirm them." = "Netdeck toto zařízení čte přes jeho API a nikdy nemění jeho nastavení. Příkazy napájení se odešlou až po vašem potvrzení.";

/* Embedded SSH client, sandbox */
"Trust the new host key" = "Důvěřovat novému klíči hostitele";
"Use the system ssh command (outside the Mac App Store)" = "Použít systémový příkaz ssh (mimo Mac App Store)";
"Netdeck has its own SSH client. Turn this on for devices it can't talk to, such as older ones that only offer RSA host keys or older ciphers. Applies to the next connection." = "Netdeck má vlastního klienta SSH. Zapněte to pro zařízení, se kterými si nerozumí, například starší zařízení, která nabízejí jen klíče hostitele RSA nebo starší šifry. Platí pro další připojení.";
"The SSH connection was closed by the device." = "Zařízení ukončilo připojení SSH.";
"Connection timed out during the SSH handshake with %@." = "Při navazování spojení SSH s %@ vypršel časový limit.";
"The device refused the SSH shell: %@" = "Zařízení odmítlo shell SSH: %@";
"The device refused to start an SSH shell." = "Zařízení odmítlo spustit shell SSH.";
"The device's SSH algorithms aren't supported by the built-in SSH client: %@" = "Algoritmy SSH tohoto zařízení vestavěný klient SSH nepodporuje: %@";
